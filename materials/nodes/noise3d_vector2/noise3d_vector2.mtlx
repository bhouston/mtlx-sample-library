<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!--
    noise3d of type vector2: each channel is its own noise, as in MaterialX's genglsl implementation.
    Shows x and y (blue is 0) remapped from [-1, 1], so channels that repeat one noise render grey.
    Regression test for three.js #34833.
  -->
  <nodegraph name="NG_test_noise3d_vector2">
    <position name="pos0" type="vector3" />
    <multiply name="coords_under_test" type="vector3">
      <input name="in1" type="vector3" nodename="pos0" />
      <input name="in2" type="vector3" value="5.0, 6.0, 7.0" />
    </multiply>
    <noise3d name="node_under_test" type="vector2" nodedef="ND_noise3d_vector2">
      <input name="amplitude" type="vector2" value="1.0, 0.85" />
      <input name="pivot" type="float" value="0.0" />
      <input name="position" type="vector3" nodename="coords_under_test" />
    </noise3d>
    <separate2 name="split" type="multioutput">
      <input name="in" type="vector2" nodename="node_under_test" />
    </separate2>
    <combine3 name="channels" type="color3">
      <input name="in1" type="float" nodename="split" output="outx" />
      <input name="in2" type="float" nodename="split" output="outy" />
      <input name="in3" type="float" value="0.0" />
    </combine3>
    <range name="color_01" type="color3">
      <input name="in" type="color3" nodename="channels" />
      <input name="inlow" type="color3" value="-1.0, -1.0, -1.0" />
      <input name="inhigh" type="color3" value="1.0, 1.0, 1.0" />
      <input name="outlow" type="color3" value="0.0, 0.0, 0.0" />
      <input name="outhigh" type="color3" value="1.0, 1.0, 1.0" />
      <input name="doclamp" type="boolean" value="true" />
    </range>
    <output name="out_base_color" type="color3" nodename="color_01" />
  </nodegraph>
  <standard_surface name="SR_noise3d_vector2" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_test_noise3d_vector2" output="out_base_color" />
  </standard_surface>
  <surfacematerial name="M_noise3d_vector2" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_noise3d_vector2" />
  </surfacematerial>
</materialx>
