<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!--
    randomfloat with an integer input, which MaterialX does not scale by 4096: one random grey per cell of an 8x8 grid.
    Regression test for three.js #34866.
  -->
  <nodegraph name="NG_test_randomfloat_integer">
    <texcoord name="uv0" type="vector2" />
    <multiply name="uv8" type="vector2">
      <input name="in1" type="vector2" nodename="uv0" />
      <input name="in2" type="float" value="8.0" />
    </multiply>
    <floor name="cell" type="vector2">
      <input name="in" type="vector2" nodename="uv8" />
    </floor>
    <dotproduct name="cell_index" type="float">
      <input name="in1" type="vector2" nodename="cell" />
      <input name="in2" type="vector2" value="1.0, 8.0" />
    </dotproduct>
    <floor name="cell_index_int" type="integer">
      <input name="in" type="float" nodename="cell_index" />
    </floor>
    <randomfloat name="node_under_test" type="float" nodedef="ND_randomfloat_integer">
      <input name="in" type="integer" nodename="cell_index_int" />
      <input name="seed" type="integer" value="7" />
    </randomfloat>
    <convert name="final_color" type="color3">
      <input name="in" type="float" nodename="node_under_test" />
    </convert>
    <output name="out_base_color" type="color3" nodename="final_color" />
  </nodegraph>
  <standard_surface name="SR_randomfloat_integer" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_test_randomfloat_integer" output="out_base_color" />
  </standard_surface>
  <surfacematerial name="M_randomfloat_integer" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_randomfloat_integer" />
  </surfacematerial>
</materialx>
