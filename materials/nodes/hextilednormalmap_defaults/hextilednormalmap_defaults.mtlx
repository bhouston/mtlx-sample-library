<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!--
    hextilednormalmap with only a file input, so every other input comes from ND_hextilednormalmap_vector3.
    That nodedef declares neither falloffcontrast nor lumacoeffs (only hextiledimage does): MaterialX blends the
    tiles with unit luminance weights. Shows the world-space normal remapped to [0, 1].
    Regression test for the review of three.js #34593.
  -->
  <nodegraph name="NG_test_hextilednormalmap_defaults">
    <hextilednormalmap name="node_under_test" type="vector3">
      <input name="file" type="filename" value="../../showcase/standard_surface/brick_procedural/textures/brick_normal.jpg" colorspace="none" />
    </hextilednormalmap>
    <multiply name="normal_half" type="vector3">
      <input name="in1" type="vector3" nodename="node_under_test" />
      <input name="in2" type="float" value="0.5" />
    </multiply>
    <add name="normal_01" type="vector3">
      <input name="in1" type="vector3" nodename="normal_half" />
      <input name="in2" type="float" value="0.5" />
    </add>
    <convert name="final_color" type="color3">
      <input name="in" type="vector3" nodename="normal_01" />
    </convert>
    <output name="out_base_color" type="color3" nodename="final_color" />
  </nodegraph>
  <standard_surface name="SR_hextilednormalmap_defaults" type="surfaceshader">
    <input name="base_color" type="color3" nodegraph="NG_test_hextilednormalmap_defaults" output="out_base_color" />
  </standard_surface>
  <surfacematerial name="M_hextilednormalmap_defaults" type="material">
    <input name="surfaceshader" type="surfaceshader" nodename="SR_hextilednormalmap_defaults" />
  </surfacematerial>
</materialx>
