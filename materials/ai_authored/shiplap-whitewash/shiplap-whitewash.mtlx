<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- shiplap-whitewash: whitewashed rough-sawn pine shiplap wall. 150 mm rows along U, 4..6 mm reveals, boards 1.2..3.0 m. UV 0..1 = 1 m, heights in m. Generated by gen.py -->
  <nodegraph name="NG_shiplap_whitewash">
