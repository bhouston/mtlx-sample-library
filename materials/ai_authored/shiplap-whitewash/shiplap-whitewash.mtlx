    <fractal2d name="fractal2d_455" type="float"><input name="texcoord" type="vector2" nodename="add_454" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_456" type="float"><input name="in1" type="float" nodename="fractal2d_455" /><input name="in2" type="float" value="0.14" /></multiply>
    <smoothstep name="smoothstep_457" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.014" /></smoothstep>
    <subtract name="subtract_458" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_457" /></subtract>
    <multiply name="multiply_459" type="float"><input name="in1" type="float" nodename="subtract_458" /><input name="in2" type="float" value="0.22" /></multiply>
    <multiply name="multiply_460" type="float"><input name="in1" type="float" nodename="lw" /><input name="in2" type="float" value="-0.55" /></multiply>
    <add name="add_461" type="float"><input name="in1" type="float" nodename="multiply_460" /><input name="in2" type="float" value="0.1" /></add>
    <multiply name="multiply_462" type="float"><input name="in1" type="float" nodename="saw" /><input name="in2" type="float" value="-0.12" /></multiply>
    <multiply name="multiply_463" type="float"><input name="in1" type="float" nodename="saw_groove" /><input name="in2" type="float" value="0.05" /></multiply>
    <add name="add_464" type="float"><input name="in1" type="float" nodename="multiply_462" /><input name="in2" type="float" nodename="multiply_463" /></add>
    <multiply name="multiply_465" type="float"><input name="in1" type="float" nodename="fib" /><input name="in2" type="float" value="0.12" /></multiply>
    <multiply name="multiply_466" type="float"><input name="in1" type="float" nodename="fuzz" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="add_467" type="float"><input name="in1" type="float" nodename="multiply_465" /><input name="in2" type="float" nodename="multiply_466" /></add>
    <add name="add_468" type="float"><input name="in1" type="float" nodename="add_446" /><input name="in2" type="float" nodename="multiply_451" /></add>
    <add name="add_469" type="float"><input name="in1" type="float" nodename="multiply_456" /><input name="in2" type="float" nodename="multiply_459" /></add>
    <add name="add_470" type="float"><input name="in1" type="float" nodename="add_468" /><input name="in2" type="float" nodename="add_469" /></add>
    <add name="add_471" type="float"><input name="in1" type="float" nodename="add_461" /><input name="in2" type="float" nodename="add_464" /></add>
    <add name="add_472" type="float"><input name="in1" type="float" nodename="add_471" /><input name="in2" type="float" nodename="add_467" /></add>
    <add name="add_473" type="float"><input name="in1" type="float" nodename="add_470" /><input name="in2" type="float" nodename="add_472" /></add>
    <multiply name="multiply_474" type="float"><input name="in1" type="float" nodename="k_halo" /><input name="in2" type="float" value="0.5" /></multiply>
    <subtract name="subtract_475" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="multiply_474" /></subtract>
    <multiply name="multiply_476" type="float"><input name="in1" type="float" nodename="add_473" /><input name="in2" type="float" nodename="subtract_475" /></multiply>
    <multiply name="multiply_477" type="float"><input name="in1" type="float" nodename="k_core" /><input name="in2" type="float" value="0.7" /></multiply>
    <subtract name="subtract_478" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="multiply_477" /></subtract>
    <multiply name="multiply_479" type="float"><input name="in1" type="float" nodename="multiply_476" /><input name="in2" type="float" nodename="subtract_478" /></multiply>
    <clamp name="wash" type="float"><input name="in" type="float" nodename="multiply_479" /><input name="low" type="float" value="0.03" /><input name="high" type="float" value="0.95" /></clamp>
    <mix name="mix_481" type="color3"><input name="bg" type="color3" nodename="wood" /><input name="fg" type="color3" value="0.78, 0.775, 0.75" /><input name="mix" type="float" nodename="wash" /></mix>
    <multiply name="multiply_482" type="float"><input name="in1" type="float" nodename="nail_halo" /><input name="in2" type="float" value="0.6" /></multiply>
    <mix name="mix_483" type="color3"><input name="bg" type="color3" value="1.0, 1.0, 1.0" /><input name="fg" type="color3" value="0.45, 0.4, 0.36" /><input name="mix" type="float" nodename="multiply_482" /></mix>
    <multiply name="multiply_484" type="color3"><input name="in1" type="color3" nodename="mix_481" /><input name="in2" type="color3" nodename="mix_483" /></multiply>
    <combine2 name="combine2_485" type="vector2"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" nodename="uv_sep" output="outy" /></combine2>
    <multiply name="multiply_486" type="vector2"><input name="in1" type="vector2" nodename="combine2_485" /><input name="in2" type="vector2" value="900.0, 900.0" /></multiply>
    <add name="add_487" type="vector2"><input name="in1" type="vector2" nodename="multiply_486" /><input name="in2" type="vector2" value="5.1, 9.3" /></add>
    <fractal2d name="fractal2d_488" type="float"><input name="texcoord" type="vector2" nodename="add_487" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_489" type="float"><input name="in1" type="float" nodename="fractal2d_488" /><input name="in2" type="float" value="0.8" /></multiply>
    <add name="add_490" type="float"><input name="in1" type="float" nodename="multiply_489" /><input name="in2" type="float" value="0.5" /></add>
    <clamp name="clamp_491" type="float"><input name="in" type="float" nodename="add_490" /></clamp>
    <multiply name="multiply_492" type="float"><input name="in1" type="float" nodename="clamp_491" /><input name="in2" type="float" value="1.2" /></multiply>
    <add name="add_493" type="float"><input name="in1" type="float" nodename="multiply_492" /><input name="in2" type="float" value="-0.2" /></add>
    <multiply name="multiply_494" type="float"><input name="in1" type="float" nodename="add_493" /><input name="in2" type="float" value="0.6" /></multiply>
    <clamp name="nail_paint" type="float"><input name="in" type="float" nodename="multiply_494" /></clamp>
    <mix name="mix_496" type="color3"><input name="bg" type="color3" value="0.3, 0.3, 0.31" /><input name="fg" type="color3" value="0.7, 0.69, 0.66" /><input name="mix" type="float" nodename="nail_paint" /></mix>
    <mix name="mix_497" type="color3"><input name="bg" type="color3" nodename="multiply_484" /><input name="fg" type="color3" nodename="mix_496" /><input name="mix" type="float" nodename="nail_head" /></mix>
    <smoothstep name="smoothstep_498" type="float"><input name="in" type="float" nodename="gap_s" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.85" /></smoothstep>
    <multiply name="multiply_499" type="float"><input name="in1" type="float" nodename="smoothstep_498" /><input name="in2" type="float" value="0.88" /></multiply>
    <add name="add_500" type="float"><input name="in1" type="float" nodename="multiply_499" /><input name="in2" type="float" value="0.12" /></add>
    <multiply name="multiply_501" type="float"><input name="in1" type="float" nodename="add_500" /><input name="in2" type="float" value="0.45" /></multiply>
    <multiply name="multiply_502" type="color3"><input name="in1" type="color3" value="0.3, 0.26, 0.2" /><input name="in2" type="float" nodename="multiply_501" /></multiply>
    <subtract name="subtract_503" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="edge" /></subtract>
    <multiply name="multiply_504" type="float"><input name="in1" type="float" nodename="subtract_503" /><input name="in2" type="float" value="-0.35" /></multiply>
    <add name="add_505" type="float"><input name="in1" type="float" nodename="multiply_504" /><input name="in2" type="float" value="1.0" /></add>
    <multiply name="multiply_506" type="color3"><input name="in1" type="color3" nodename="mix_497" /><input name="in2" type="float" nodename="add_505" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" nodename="multiply_506" /><input name="fg" type="color3" nodename="multiply_502" /><input name="mix" type="float" nodename="gap" /></mix>
    <multiply name="multiply_508" type="float"><input name="in1" type="float" nodename="wash" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="add_509" type="float"><input name="in1" type="float" nodename="multiply_508" /><input name="in2" type="float" value="0.78" /></add>
    <multiply name="multiply_510" type="float"><input name="in1" type="float" nodename="fuzz_pres" /><input name="in2" type="float" value="0.03" /></multiply>
    <!-- roughness: 0.78..0.9 matte -->
    <add name="add_511" type="float"><input name="in1" type="float" nodename="add_509" /><input name="in2" type="float" nodename="multiply_510" /></add>
    <multiply name="multiply_512" type="float"><input name="in1" type="float" nodename="fuzz" /><input name="in2" type="float" value="0.03" /></multiply>
    <add name="add_513" type="float"><input name="in1" type="float" nodename="add_511" /><input name="in2" type="float" nodename="multiply_512" /></add>
    <multiply name="multiply_514" type="float"><input name="in1" type="float" nodename="k_core" /><input name="in2" type="float" value="0.8" /></multiply>
    <mix name="mix_515" type="float"><input name="bg" type="float" nodename="add_513" /><input name="fg" type="float" value="0.72" /><input name="mix" type="float" nodename="multiply_514" /></mix>
    <multiply name="multiply_516" type="float"><input name="in1" type="float" nodename="nail_paint" /><input name="in2" type="float" value="0.35" /></multiply>
    <add name="add_517" type="float"><input name="in1" type="float" nodename="multiply_516" /><input name="in2" type="float" value="0.45" /></add>
    <mix name="mix_518" type="float"><input name="bg" type="float" nodename="mix_515" /><input name="fg" type="float" nodename="add_517" /><input name="mix" type="float" nodename="nail_head" /></mix>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="mix_518" /><input name="fg" type="float" value="0.92" /><input name="mix" type="float" nodename="gap" /></mix>
    <subtract name="subtract_520" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="nail_paint" /></subtract>
    <multiply name="multiply_521" type="float"><input name="in1" type="float" nodename="subtract_520" /><input name="in2" type="float" value="0.9" /></multiply>
    <multiply name="metalness" type="float"><input name="in1" type="float" nodename="nail_head" /><input name="in2" type="float" nodename="multiply_521" /></multiply>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_shiplap_whitewash" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_shiplap_whitewash" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_shiplap_whitewash" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_shiplap_whitewash" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_shiplap_whitewash" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_shiplap_whitewash" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_shiplap_whitewash" /></surfacematerial>
</materialx>

