    <mix name="mix_439" type="color3"><input name="bg" type="color3" nodename="multiply_437" /><input name="fg" type="color3" value="0.33, 0.14, 0.05" /><input name="mix" type="float" nodename="multiply_438" /></mix>
    <mix name="mix_440" type="color3"><input name="bg" type="color3" value="0.24, 0.11, 0.04" /><input name="fg" type="color3" value="0.09, 0.04, 0.015" /><input name="mix" type="float" nodename="k_ring" /></mix>
    <multiply name="multiply_441" type="float"><input name="in1" type="float" nodename="k_core" /><input name="in2" type="float" value="0.9" /></multiply>
    <mix name="mix_442" type="color3"><input name="bg" type="color3" nodename="mix_439" /><input name="fg" type="color3" nodename="mix_440" /><input name="mix" type="float" nodename="multiply_441" /></mix>
    <multiply name="multiply_443" type="float"><input name="in1" type="float" nodename="k_rim" /><input name="in2" type="float" value="0.9" /></multiply>
    <mix name="wood" type="color3"><input name="bg" type="color3" nodename="mix_442" /><input name="fg" type="color3" value="0.07, 0.035, 0.015" /><input name="mix" type="float" nodename="multiply_443" /></mix>
    <multiply name="multiply_445" type="float"><input name="in1" type="float" nodename="rb3" /><input name="in2" type="float" value="0.46" /></multiply>
    <!-- wash coverage: per board 0.36..0.82, brushed patches, valleys and edges heavier -->
    <add name="add_446" type="float"><input name="in1" type="float" nodename="multiply_445" /><input name="in2" type="float" value="0.36" /></add>
    <combine2 name="combine2_447" type="vector2"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" nodename="uv_sep" output="outy" /></combine2>
    <multiply name="multiply_448" type="vector2"><input name="in1" type="vector2" nodename="combine2_447" /><input name="in2" type="vector2" value="2.5, 7.0" /></multiply>
