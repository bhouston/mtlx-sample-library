    <multiply name="multiply_451" type="float"><input name="in1" type="float" nodename="fractal2d_450" /><input name="in2" type="float" value="0.45" /></multiply>
    <combine2 name="combine2_452" type="vector2"><input name="in1" type="float" nodename="a" /><input name="in2" type="float" nodename="c_def" /></combine2>
