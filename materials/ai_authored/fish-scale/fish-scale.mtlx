    <mix name="mix_143" type="float"><input name="bg" type="float" nodename="add_142" /><input name="fg" type="float" value="0.4" /><input name="mix" type="float" nodename="pin" /></mix>
    <mix name="roughness" type="float"><input name="bg" type="float" value="0.9" /><input name="fg" type="float" nodename="mix_143" /><input name="mix" type="float" nodename="glaze" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height_m" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_fish_scale" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_fish_scale" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_fish_scale" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_fish_scale" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_fish_scale" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_fish_scale" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_fish_scale" /></surfacematerial>
</materialx>

