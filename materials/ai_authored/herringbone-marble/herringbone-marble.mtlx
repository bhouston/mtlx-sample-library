<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Honed Carrara herringbone backsplash: 2.5 x 10 cm planks at 45 deg, 1.5 mm grout. UV 0..1 = 1 m, heights in m. -->
  <nodegraph name="NG_herringbone_marble">
    <texcoord name="uv" type="vector2"></texcoord>
    <!-- herringbone lattice, 2.65 x 10.15 cm modules -->
    <rotate2d name="p_rot" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="45.0" /></rotate2d>
    <divide name="q" type="vector2"><input name="in1" type="vector2" nodename="p_rot" /><input name="in2" type="float" value="0.026500000000000003" /></divide>
    <separate2 name="q_sep" type="multioutput"><input name="in" type="vector2" nodename="q" /></separate2>
    <subtract name="t" type="float"><input name="in1" type="float" nodename="q_sep" output="outx" /><input name="in2" type="float" nodename="q_sep" output="outy" /></subtract>
    <add name="t1" type="float"><input name="in1" type="float" nodename="t" /><input name="in2" type="float" value="1.0" /></add>
    <divide name="divide_7" type="float"><input name="in1" type="float" nodename="t1" /><input name="in2" type="float" value="7.660377358490566" /></divide>
    <floor name="nh" type="float"><input name="in" type="float" nodename="divide_7" /></floor>
    <multiply name="multiply_9" type="float"><input name="in1" type="float" nodename="nh" /><input name="in2" type="float" value="3.830188679245283" /></multiply>
    <add name="yh" type="float"><input name="in1" type="float" nodename="q_sep" output="outy" /><input name="in2" type="float" nodename="multiply_9" /></add>
    <floor name="mh" type="float"><input name="in" type="float" nodename="yh" /></floor>
    <subtract name="fyh" type="float"><input name="in1" type="float" nodename="yh" /><input name="in2" type="float" nodename="mh" /></subtract>
    <modulo name="modulo_13" type="float"><input name="in1" type="float" nodename="t1" /><input name="in2" type="float" value="7.660377358490566" /></modulo>
    <subtract name="subtract_14" type="float"><input name="in1" type="float" nodename="modulo_13" /><input name="in2" type="float" value="1.0" /></subtract>
    <add name="xl" type="float"><input name="in1" type="float" nodename="subtract_14" /><input name="in2" type="float" nodename="fyh" /></add>
    <ifgreater name="is_h0" type="float"><input name="value1" type="float" value="3.830188679245283" /><input name="value2" type="float" nodename="xl" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <ifgreater name="is_h" type="float"><input name="value1" type="float" value="0.0" /><input name="value2" type="float" nodename="xl" /><input name="in1" type="float" value="0.0" /><input name="in2" type="float" nodename="is_h0" /></ifgreater>
    <subtract name="subtract_18" type="float"><input name="in1" type="float" nodename="t1" /><input name="in2" type="float" value="3.830188679245283" /></subtract>
    <divide name="divide_19" type="float"><input name="in1" type="float" nodename="subtract_18" /><input name="in2" type="float" value="7.660377358490566" /></divide>
    <floor name="nv" type="float"><input name="in" type="float" nodename="divide_19" /></floor>
    <multiply name="multiply_21" type="float"><input name="in1" type="float" nodename="nv" /><input name="in2" type="float" value="3.830188679245283" /></multiply>
    <add name="add_22" type="float"><input name="in1" type="float" nodename="multiply_21" /><input name="in2" type="float" value="3.830188679245283" /></add>
    <subtract name="gx" type="float"><input name="in1" type="float" nodename="q_sep" output="outx" /><input name="in2" type="float" nodename="add_22" /></subtract>
    <floor name="mv" type="float"><input name="in" type="float" nodename="gx" /></floor>
    <subtract name="fxv" type="float"><input name="in1" type="float" nodename="gx" /><input name="in2" type="float" nodename="mv" /></subtract>
    <subtract name="subtract_26" type="float"><input name="in1" type="float" nodename="q_sep" output="outy" /><input name="in2" type="float" nodename="mv" /></subtract>
    <multiply name="multiply_27" type="float"><input name="in1" type="float" nodename="nv" /><input name="in2" type="float" value="3.830188679245283" /></multiply>
    <add name="add_28" type="float"><input name="in1" type="float" nodename="multiply_27" /><input name="in2" type="float" value="2.830188679245283" /></add>
    <add name="alv" type="float"><input name="in1" type="float" nodename="subtract_26" /><input name="in2" type="float" nodename="add_28" /></add>
    <mix name="mix_30" type="float"><input name="fg" type="float" nodename="xl" /><input name="bg" type="float" nodename="alv" /><input name="mix" type="float" nodename="is_h" /></mix>
    <multiply name="a_m" type="float"><input name="in1" type="float" nodename="mix_30" /><input name="in2" type="float" value="0.026500000000000003" /></multiply>
    <mix name="mix_32" type="float"><input name="fg" type="float" nodename="fyh" /><input name="bg" type="float" nodename="fxv" /><input name="mix" type="float" nodename="is_h" /></mix>
    <multiply name="c_m" type="float"><input name="in1" type="float" nodename="mix_32" /><input name="in2" type="float" value="0.026500000000000003" /></multiply>
    <mix name="mix_34" type="float"><input name="fg" type="float" nodename="nh" /><input name="bg" type="float" nodename="nv" /><input name="mix" type="float" nodename="is_h" /></mix>
    <multiply name="multiply_35" type="float"><input name="in1" type="float" nodename="is_h" /><input name="in2" type="float" value="173.0" /></multiply>
    <add name="id_n" type="float"><input name="in1" type="float" nodename="mix_34" /><input name="in2" type="float" nodename="multiply_35" /></add>
    <mix name="id_m" type="float"><input name="fg" type="float" nodename="mh" /><input name="bg" type="float" nodename="mv" /><input name="mix" type="float" nodename="is_h" /></mix>
    <combine2 name="id_p" type="vector2"><input name="in1" type="float" nodename="id_n" /><input name="in2" type="float" nodename="id_m" /></combine2>
    <add name="add_39" type="vector2"><input name="in1" type="vector2" nodename="id_p" /><input name="in2" type="vector2" value="0.5, 0.5" /></add>
    <cellnoise2d name="r1" type="float"><input name="texcoord" type="vector2" nodename="add_39" /></cellnoise2d>
    <add name="add_41" type="vector2"><input name="in1" type="vector2" nodename="id_p" /><input name="in2" type="vector2" value="37.5, 11.5" /></add>
    <cellnoise2d name="r2" type="float"><input name="texcoord" type="vector2" nodename="add_41" /></cellnoise2d>
    <add name="add_43" type="vector2"><input name="in1" type="vector2" nodename="id_p" /><input name="in2" type="vector2" value="71.5, 53.5" /></add>
    <cellnoise2d name="r3" type="float"><input name="texcoord" type="vector2" nodename="add_43" /></cellnoise2d>
    <add name="add_45" type="vector2"><input name="in1" type="vector2" nodename="id_p" /><input name="in2" type="vector2" value="13.5, 91.5" /></add>
    <cellnoise2d name="r4" type="float"><input name="texcoord" type="vector2" nodename="add_45" /></cellnoise2d>
    <add name="add_47" type="vector2"><input name="in1" type="vector2" nodename="id_p" /><input name="in2" type="vector2" value="211.5, 7.5" /></add>
    <cellnoise2d name="r5" type="float"><input name="texcoord" type="vector2" nodename="add_47" /></cellnoise2d>
    <subtract name="subtract_49" type="float"><input name="in1" type="float" value="0.1015" /><input name="in2" type="float" nodename="a_m" /></subtract>
    <min name="min_50" type="float"><input name="in1" type="float" nodename="a_m" /><input name="in2" type="float" nodename="subtract_49" /></min>
    <subtract name="da" type="float"><input name="in1" type="float" nodename="min_50" /><input name="in2" type="float" value="0.00075" /></subtract>
    <subtract name="subtract_52" type="float"><input name="in1" type="float" value="0.026500000000000003" /><input name="in2" type="float" nodename="c_m" /></subtract>
    <min name="min_53" type="float"><input name="in1" type="float" nodename="c_m" /><input name="in2" type="float" nodename="subtract_52" /></min>
    <subtract name="dc" type="float"><input name="in1" type="float" nodename="min_53" /><input name="in2" type="float" value="0.00075" /></subtract>
    <!-- eased edge: 0.7 mm drop over 1.6 mm (0.4 mm into the joint), ~33 deg max -->
    <min name="d_edge" type="float"><input name="in1" type="float" nodename="da" /><input name="in2" type="float" nodename="dc" /></min>
    <smoothstep name="ease" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="-0.0004" /><input name="high" type="float" value="0.0012" /></smoothstep>
    <smoothstep name="plank" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="-0.0002" /><input name="high" type="float" value="0.0002" /></smoothstep>
    <!-- marble veining, local frame -->
    <combine2 name="lp" type="vector2"><input name="in1" type="float" nodename="a_m" /><input name="in2" type="float" nodename="c_m" /></combine2>
    <subtract name="subtract_59" type="float"><input name="in1" type="float" nodename="r2" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="vein_ang" type="float"><input name="in1" type="float" nodename="subtract_59" /><input name="in2" type="float" value="40.0" /></multiply>
    <rotate2d name="lpr" type="vector2"><input name="in" type="vector2" nodename="lp" /><input name="amount" type="float" nodename="vein_ang" /></rotate2d>
    <combine2 name="combine2_62" type="vector2"><input name="in1" type="float" nodename="r3" /><input name="in2" type="float" nodename="r4" /></combine2>
    <multiply name="vein_off" type="vector2"><input name="in1" type="vector2" nodename="combine2_62" /><input name="in2" type="vector2" value="23.0, 17.0" /></multiply>
    <add name="mp" type="vector2"><input name="in1" type="vector2" nodename="lpr" /><input name="in2" type="vector2" nodename="vein_off" /></add>
    <multiply name="multiply_65" type="vector2"><input name="in1" type="vector2" nodename="mp" /><input name="in2" type="float" value="10.0" /></multiply>
    <add name="add_66" type="vector2"><input name="in1" type="vector2" nodename="multiply_65" /><input name="in2" type="vector2" value="3.1, 7.9" /></add>
    <fractal2d name="warp_n" type="vector3"><input name="texcoord" type="vector2" nodename="add_66" /><input name="octaves" type="integer" value="4" /><input name="amplitude" type="vector3" value="0.008, 0.008, 0.0" /></fractal2d>
    <convert name="convert_68" type="vector2"><input name="in" type="vector3" nodename="warp_n" /></convert>
    <add name="mpw" type="vector2"><input name="in1" type="vector2" nodename="mp" /><input name="in2" type="vector2" nodename="convert_68" /></add>
    <multiply name="multiply_70" type="vector2"><input name="in1" type="vector2" nodename="mpw" /><input name="in2" type="vector2" value="3.0, 9.0" /></multiply>
    <add name="add_71" type="vector2"><input name="in1" type="vector2" nodename="multiply_70" /><input name="in2" type="vector2" value="21.7, 3.9" /></add>
    <fractal2d name="v0f" type="float"><input name="texcoord" type="vector2" nodename="add_71" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <absval name="absval_73" type="float"><input name="in" type="float" nodename="v0f" /></absval>
    <smoothstep name="smoothstep_74" type="float"><input name="in" type="float" nodename="absval_73" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.3" /></smoothstep>
    <subtract name="band" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_74" /></subtract>
    <multiply name="multiply_76" type="vector2"><input name="in1" type="vector2" nodename="mpw" /><input name="in2" type="vector2" value="3.0, 13.0" /></multiply>
    <fractal2d name="v1f" type="float"><input name="texcoord" type="vector2" nodename="multiply_76" /><input name="octaves" type="integer" value="6" /><input name="diminish" type="float" value="0.62" /></fractal2d>
    <absval name="v1a" type="float"><input name="in" type="float" nodename="v1f" /></absval>
    <multiply name="multiply_79" type="float"><input name="in1" type="float" nodename="r5" /><input name="in2" type="float" value="0.03" /></multiply>
    <add name="vein_w" type="float"><input name="in1" type="float" nodename="multiply_79" /><input name="in2" type="float" value="0.008" /></add>
    <smoothstep name="smoothstep_81" type="float"><input name="in" type="float" nodename="v1a" /><input name="low" type="float" value="0.0" /><input name="high" type="float" nodename="vein_w" /></smoothstep>
    <subtract name="vein1" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_81" /></subtract>
    <multiply name="multiply_83" type="float"><input name="in1" type="float" nodename="vein_w" /><input name="in2" type="float" value="5.0" /></multiply>
    <smoothstep name="smoothstep_84" type="float"><input name="in" type="float" nodename="v1a" /><input name="low" type="float" value="0.0" /><input name="high" type="float" nodename="multiply_83" /></smoothstep>
    <subtract name="halo1" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_84" /></subtract>
    <multiply name="multiply_86" type="vector2"><input name="in1" type="vector2" nodename="mpw" /><input name="in2" type="vector2" value="9.0, 26.0" /></multiply>
    <add name="add_87" type="vector2"><input name="in1" type="vector2" nodename="multiply_86" /><input name="in2" type="vector2" value="51.3, 17.7" /></add>
    <fractal2d name="v2f" type="float"><input name="texcoord" type="vector2" nodename="add_87" /><input name="octaves" type="integer" value="5" /><input name="diminish" type="float" value="0.6" /></fractal2d>
    <absval name="absval_89" type="float"><input name="in" type="float" nodename="v2f" /></absval>
    <smoothstep name="smoothstep_90" type="float"><input name="in" type="float" nodename="absval_89" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.012" /></smoothstep>
    <subtract name="vein2" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_90" /></subtract>
    <multiply name="multiply_92" type="vector2"><input name="in1" type="vector2" nodename="mpw" /><input name="in2" type="vector2" value="10.0, 18.0" /></multiply>
    <add name="add_93" type="vector2"><input name="in1" type="vector2" nodename="multiply_92" /><input name="in2" type="vector2" value="9.7, 3.3" /></add>
    <fractal2d name="cloud" type="float"><input name="texcoord" type="vector2" nodename="add_93" /><input name="octaves" type="integer" value="5" /></fractal2d>
    <multiply name="multiply_95" type="float"><input name="in1" type="float" nodename="cloud" /><input name="in2" type="float" value="0.6" /></multiply>
    <add name="add_96" type="float"><input name="in1" type="float" nodename="multiply_95" /><input name="in2" type="float" value="0.5" /></add>
    <clamp name="cloud01" type="float"><input name="in" type="float" nodename="add_96" /></clamp>
    <!-- colour -->
    <mix name="ground" type="color3"><input name="bg" type="color3" value="0.62, 0.625, 0.63" /><input name="fg" type="color3" value="0.52, 0.53, 0.545" /><input name="mix" type="float" nodename="cloud01" /></mix>
    <multiply name="multiply_99" type="float"><input name="in1" type="float" nodename="r3" /><input name="in2" type="float" value="0.6" /></multiply>
    <multiply name="multiply_100" type="float"><input name="in1" type="float" nodename="band" /><input name="in2" type="float" nodename="multiply_99" /></multiply>
    <mix name="c_band" type="color3"><input name="bg" type="color3" nodename="ground" /><input name="fg" type="color3" value="0.42, 0.435, 0.455" /><input name="mix" type="float" nodename="multiply_100" /></mix>
    <multiply name="multiply_102" type="float"><input name="in1" type="float" nodename="cloud01" /><input name="in2" type="float" value="0.4" /></multiply>
    <add name="add_103" type="float"><input name="in1" type="float" nodename="multiply_102" /><input name="in2" type="float" value="0.2" /></add>
    <multiply name="multiply_104" type="float"><input name="in1" type="float" nodename="halo1" /><input name="in2" type="float" nodename="add_103" /></multiply>
    <mix name="c_halo" type="color3"><input name="bg" type="color3" nodename="c_band" /><input name="fg" type="color3" value="0.4, 0.415, 0.44" /><input name="mix" type="float" nodename="multiply_104" /></mix>
    <multiply name="multiply_106" type="float"><input name="in1" type="float" nodename="vein2" /><input name="in2" type="float" value="0.6" /></multiply>
    <mix name="c_v2" type="color3"><input name="bg" type="color3" nodename="c_halo" /><input name="fg" type="color3" value="0.36, 0.375, 0.4" /><input name="mix" type="float" nodename="multiply_106" /></mix>
    <multiply name="multiply_108" type="float"><input name="in1" type="float" nodename="vein1" /><input name="in2" type="float" value="0.85" /></multiply>
    <mix name="c_v1" type="color3"><input name="bg" type="color3" nodename="c_v2" /><input name="fg" type="color3" value="0.22, 0.235, 0.26" /><input name="mix" type="float" nodename="multiply_108" /></mix>
    <multiply name="multiply_110" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="3.0" /></multiply>
    <add name="add_111" type="vector2"><input name="in1" type="vector2" nodename="multiply_110" /><input name="in2" type="vector2" value="5.3, 2.9" /></add>
    <fractal2d name="drift" type="float"><input name="texcoord" type="vector2" nodename="add_111" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <multiply name="multiply_113" type="float"><input name="in1" type="float" nodename="r1" /><input name="in2" type="float" value="0.16" /></multiply>
    <add name="add_114" type="float"><input name="in1" type="float" nodename="multiply_113" /><input name="in2" type="float" value="0.92" /></add>
    <multiply name="multiply_115" type="float"><input name="in1" type="float" nodename="drift" /><input name="in2" type="float" value="0.04" /></multiply>
    <add name="tone" type="float"><input name="in1" type="float" nodename="add_114" /><input name="in2" type="float" nodename="multiply_115" /></add>
    <multiply name="marble_col" type="color3"><input name="in1" type="color3" nodename="c_v1" /><input name="in2" type="float" nodename="tone" /></multiply>
    <multiply name="multiply_118" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1400.0" /></multiply>
    <add name="add_119" type="vector2"><input name="in1" type="vector2" nodename="multiply_118" /><input name="in2" type="vector2" value="7.7, 1.3" /></add>
    <noise2d name="grout_n" type="float"><input name="texcoord" type="vector2" nodename="add_119" /><input name="amplitude" type="float" value="0.5" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <mix name="grout_col" type="color3"><input name="bg" type="color3" value="0.5, 0.49, 0.47" /><input name="fg" type="color3" value="0.4, 0.39, 0.375" /><input name="mix" type="float" nodename="grout_n" /></mix>
    <mix name="base_color" type="color3"><input name="fg" type="color3" nodename="marble_col" /><input name="bg" type="color3" nodename="grout_col" /><input name="mix" type="float" nodename="plank" /></mix>
    <!-- height -->
    <multiply name="lip" type="float"><input name="in1" type="float" nodename="r4" /><input name="in2" type="float" value="0.00012" /></multiply>
    <multiply name="multiply_124" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="120.0" /></multiply>
    <add name="add_125" type="vector2"><input name="in1" type="vector2" nodename="multiply_124" /><input name="in2" type="vector2" value="31.1, 4.7" /></add>
    <fractal2d name="micro" type="float"><input name="texcoord" type="vector2" nodename="add_125" /><input name="octaves" type="integer" value="3" /><input name="amplitude" type="float" value="2e-05" /></fractal2d>
    <add name="add_127" type="float"><input name="in1" type="float" nodename="lip" /><input name="in2" type="float" nodename="micro" /></add>
    <add name="top" type="float"><input name="in1" type="float" nodename="add_127" /><input name="in2" type="float" value="0.0007" /></add>
    <multiply name="grout_h" type="float"><input name="in1" type="float" nodename="grout_n" /><input name="in2" type="float" value="2e-05" /></multiply>
    <multiply name="multiply_130" type="float"><input name="in1" type="float" nodename="top" /><input name="in2" type="float" nodename="ease" /></multiply>
    <subtract name="subtract_131" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="ease" /></subtract>
    <multiply name="multiply_132" type="float"><input name="in1" type="float" nodename="grout_h" /><input name="in2" type="float" nodename="subtract_131" /></multiply>
    <add name="height" type="float"><input name="in1" type="float" nodename="multiply_130" /><input name="in2" type="float" nodename="multiply_132" /></add>
    <multiply name="multiply_134" type="float"><input name="in1" type="float" nodename="r3" /><input name="in2" type="float" value="0.06" /></multiply>
    <add name="add_135" type="float"><input name="in1" type="float" nodename="multiply_134" /><input name="in2" type="float" value="0.28" /></add>
    <multiply name="multiply_136" type="float"><input name="in1" type="float" nodename="vein1" /><input name="in2" type="float" value="0.04" /></multiply>
    <!-- roughness -->
    <add name="rough_m" type="float"><input name="in1" type="float" nodename="add_135" /><input name="in2" type="float" nodename="multiply_136" /></add>
    <mix name="roughness" type="float"><input name="fg" type="float" nodename="rough_m" /><input name="bg" type="float" value="0.92" /><input name="mix" type="float" nodename="plank" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_herringbone_marble" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_herringbone_marble" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_herringbone_marble" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_herringbone_marble" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_herringbone_marble" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_herringbone_marble" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_herringbone_marble" /></surfacematerial>
</materialx>

