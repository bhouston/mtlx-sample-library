    <mix name="base_color" type="color3"><input name="fg" type="color3" value="0.16, 0.16, 0.155" /><input name="bg" type="color3" nodename="mix_141" /><input name="mix" type="float" nodename="multiply_142" /></mix>
    <multiply name="multiply_144" type="float"><input name="in1" type="float" nodename="id1" /><input name="in2" type="float" value="0.12" /></multiply>
    <add name="add_145" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="2.8, 4.1" /></add>
    <multiply name="multiply_146" type="vector2"><input name="in1" type="vector2" nodename="add_145" /><input name="in2" type="float" value="60" /></multiply>
    <noise2d name="noise2d_147" type="float"><input name="texcoord" type="vector2" nodename="multiply_146" /><input name="amplitude" type="float" value="0.05" /></noise2d>
    <add name="add_148" type="float"><input name="in1" type="float" nodename="multiply_144" /><input name="in2" type="float" nodename="noise2d_147" /></add>
    <add name="add_149" type="float"><input name="in1" type="float" value="0.56" /><input name="in2" type="float" nodename="add_148" /></add>
    <mix name="mix_150" type="float"><input name="fg" type="float" nodename="add_149" /><input name="bg" type="float" value="0.92" /><input name="mix" type="float" nodename="m_tile" /></mix>
    <mix name="roughness" type="float"><input name="fg" type="float" value="0.86" /><input name="bg" type="float" nodename="mix_150" /><input name="mix" type="float" nodename="m_haze" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_penny_round" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_penny_round" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_penny_round" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_penny_round" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_penny_round" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_penny_round" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_penny_round" /></surfacematerial>
</materialx>

