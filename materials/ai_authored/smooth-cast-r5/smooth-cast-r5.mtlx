<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Smooth cast-in-place concrete against smooth formwork: grey Portland paste with soft large-scale mottling, fine sand grain and sparse bug holes. Texcoords are meters: UV 0..1 = 1 m. -->
  <nodegraph name="NG_smooth_cast">
    <texcoord name="uv" type="vector2"></texcoord>
    <rotate2d name="uv_rot" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="31.0" /></rotate2d>
    <!-- Mottling: macro clouds ~30 cm (fBm 1.6/m, 4 oct) and meso blotches ~8 cm (noise 6/m) -->
    <multiply name="multiply_3" type="vector2"><input name="in1" type="vector2" nodename="uv_rot" /><input name="in2" type="float" value="1.6" /></multiply>
    <add name="add_4" type="vector2"><input name="in1" type="vector2" nodename="multiply_3" /><input name="in2" type="vector2" value="7.3, 2.9" /></add>
    <fractal2d name="mot_macro" type="float"><input name="texcoord" type="vector2" nodename="add_4" /><input name="octaves" type="integer" value="3" /><input name="diminish" type="float" value="0.45" /></fractal2d>
    <multiply name="multiply_6" type="float"><input name="in1" type="float" nodename="mot_macro" /><input name="in2" type="float" value="0.6" /></multiply>
    <add name="add_7" type="float"><input name="in1" type="float" nodename="multiply_6" /><input name="in2" type="float" value="0.5" /></add>
    <multiply name="multiply_8" type="vector2"><input name="in1" type="vector2" nodename="uv_rot" /><input name="in2" type="float" value="6.0" /></multiply>
    <add name="add_9" type="vector2"><input name="in1" type="vector2" nodename="multiply_8" /><input name="in2" type="vector2" value="13.1, 5.4" /></add>
    <noise2d name="mot_meso" type="float"><input name="texcoord" type="vector2" nodename="add_9" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="multiply_11" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="22.0" /></multiply>
    <add name="add_12" type="vector2"><input name="in1" type="vector2" nodename="multiply_11" /><input name="in2" type="vector2" value="3.7, 41.2" /></add>
    <fractal2d name="mot_fine" type="float"><input name="texcoord" type="vector2" nodename="add_12" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <multiply name="multiply_14" type="vector2"><input name="in1" type="vector2" nodename="uv_rot" /><input name="in2" type="float" value="2.2" /></multiply>
    <add name="add_15" type="vector2"><input name="in1" type="vector2" nodename="multiply_14" /><input name="in2" type="vector2" value="51.3, 12.9" /></add>
    <fractal2d name="patch_n" type="float"><input name="texcoord" type="vector2" nodename="add_15" /><input name="octaves" type="integer" value="2" /><input name="diminish" type="float" value="0.45" /></fractal2d>
    <smoothstep name="patch" type="float"><input name="in" type="float" nodename="patch_n" /><input name="low" type="float" value="0.1" /><input name="high" type="float" value="0.5" /></smoothstep>
    <multiply name="multiply_18" type="vector2"><input name="in1" type="vector2" nodename="uv_rot" /><input name="in2" type="float" value="0.35" /></multiply>
    <add name="add_19" type="vector2"><input name="in1" type="vector2" nodename="multiply_18" /><input name="in2" type="vector2" value="2.3, 6.1" /></add>
    <noise2d name="mot_drift" type="float"><input name="texcoord" type="vector2" nodename="add_19" /><input name="amplitude" type="float" value="0.5" /></noise2d>
    <multiply name="multiply_21" type="float"><input name="in1" type="float" nodename="add_7" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="add_22" type="float"><input name="in1" type="float" nodename="multiply_21" /><input name="in2" type="float" nodename="mot_drift" /></add>
    <multiply name="multiply_23" type="float"><input name="in1" type="float" nodename="mot_meso" /><input name="in2" type="float" value="0.3" /></multiply>
    <multiply name="multiply_24" type="float"><input name="in1" type="float" nodename="mot_fine" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="add_25" type="float"><input name="in1" type="float" nodename="multiply_23" /><input name="in2" type="float" nodename="multiply_24" /></add>
    <add name="add_26" type="float"><input name="in1" type="float" nodename="add_22" /><input name="in2" type="float" nodename="add_25" /></add>
    <clamp name="mottle" type="float"><input name="in" type="float" nodename="add_26" /></clamp>
    <!-- Height: form-face waviness 0.4 mm at 3/m, skin undulation 0.08 mm fBm at 35/m, sand micro 10 um at 1400/m -->
    <multiply name="multiply_28" type="vector2"><input name="in1" type="vector2" nodename="uv_rot" /><input name="in2" type="float" value="3.0" /></multiply>
    <add name="add_29" type="vector2"><input name="in1" type="vector2" nodename="multiply_28" /><input name="in2" type="vector2" value="21.7, 8.1" /></add>
    <noise2d name="h_wave" type="float"><input name="texcoord" type="vector2" nodename="add_29" /><input name="amplitude" type="float" value="0.0004" /></noise2d>
    <multiply name="multiply_31" type="vector2"><input name="in1" type="vector2" nodename="uv_rot" /><input name="in2" type="float" value="35.0" /></multiply>
    <add name="add_32" type="vector2"><input name="in1" type="vector2" nodename="multiply_31" /><input name="in2" type="vector2" value="11.3, 4.7" /></add>
    <fractal2d name="skin" type="float"><input name="texcoord" type="vector2" nodename="add_32" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <multiply name="h_skin" type="float"><input name="in1" type="float" nodename="skin" /><input name="in2" type="float" value="8e-05" /></multiply>
    <multiply name="multiply_35" type="vector2"><input name="in1" type="vector2" nodename="uv_rot" /><input name="in2" type="float" value="1400.0" /></multiply>
    <add name="add_36" type="vector2"><input name="in1" type="vector2" nodename="multiply_35" /><input name="in2" type="vector2" value="71.9, 23.3" /></add>
    <noise2d name="sand1" type="float"><input name="texcoord" type="vector2" nodename="add_36" /></noise2d>
    <rotate2d name="rotate2d_38" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="-17.0" /></rotate2d>
    <multiply name="multiply_39" type="vector2"><input name="in1" type="vector2" nodename="rotate2d_38" /><input name="in2" type="float" value="420.0" /></multiply>
    <add name="add_40" type="vector2"><input name="in1" type="vector2" nodename="multiply_39" /><input name="in2" type="vector2" value="35.5, 67.1" /></add>
    <noise2d name="sand2" type="float"><input name="texcoord" type="vector2" nodename="add_40" /></noise2d>
    <multiply name="multiply_42" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="700.0" /></multiply>
    <add name="add_43" type="vector2"><input name="in1" type="vector2" nodename="multiply_42" /><input name="in2" type="vector2" value="13.3, 77.7" /></add>
    <worleynoise2d name="grain_f1" type="float"><input name="texcoord" type="vector2" nodename="add_43" /><input name="jitter" type="float" value="0.9" /></worleynoise2d>
    <worleynoise2d name="grain_id" type="float"><input name="texcoord" type="vector2" nodename="add_43" /><input name="jitter" type="float" value="0.9" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <multiply name="multiply_46" type="float"><input name="in1" type="float" nodename="grain_id" /><input name="in2" type="float" value="13.7" /></multiply>
    <fract name="fract_47" type="float"><input name="in" type="float" nodename="multiply_46" /></fract>
    <multiply name="grain_r" type="float"><input name="in1" type="float" nodename="fract_47" /><input name="in2" type="float" value="0.3" /></multiply>
    <subtract name="subtract_49" type="float"><input name="in1" type="float" nodename="grain_f1" /><input name="in2" type="float" nodename="grain_r" /></subtract>
    <smoothstep name="smoothstep_50" type="float"><input name="in" type="float" nodename="subtract_49" /><input name="low" type="float" value="-0.06" /><input name="high" type="float" value="0.03" /></smoothstep>
    <subtract name="grain_m" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_50" /></subtract>
    <subtract name="subtract_52" type="float"><input name="in1" type="float" nodename="grain_id" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="grain_s" type="float"><input name="in1" type="float" nodename="grain_m" /><input name="in2" type="float" nodename="subtract_52" /></multiply>
    <multiply name="multiply_54" type="float"><input name="in1" type="float" nodename="sand1" /><input name="in2" type="float" value="1e-05" /></multiply>
    <multiply name="multiply_55" type="float"><input name="in1" type="float" nodename="sand2" /><input name="in2" type="float" value="2.2e-05" /></multiply>
    <add name="h_sand" type="float"><input name="in1" type="float" nodename="multiply_54" /><input name="in2" type="float" nodename="multiply_55" /></add>
    <!-- Bug holes: ragged-edged voids. Warp 0.5 mm at 250/m (s = 0.125) for irregular outlines -->
    <multiply name="multiply_57" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="250.0" /></multiply>
    <add name="add_58" type="vector2"><input name="in1" type="vector2" nodename="multiply_57" /><input name="in2" type="vector2" value="5.1, 9.7" /></add>
    <noise2d name="hole_warp3" type="vector3"><input name="texcoord" type="vector2" nodename="add_58" /><input name="amplitude" type="vector3" value="0.0005, 0.0005, 0.0" /></noise2d>
    <convert name="convert_60" type="vector2"><input name="in" type="vector3" nodename="hole_warp3" /></convert>
    <add name="uv_hole" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" nodename="convert_60" /></add>
    <multiply name="multiply_62" type="vector2"><input name="in1" type="vector2" nodename="uv_rot" /><input name="in2" type="float" value="2.2" /></multiply>
    <add name="add_63" type="vector2"><input name="in1" type="vector2" nodename="multiply_62" /><input name="in2" type="vector2" value="8.8, 31.4" /></add>
    <noise2d name="hole_dens" type="float"><input name="texcoord" type="vector2" nodename="add_63" /><input name="amplitude" type="float" value="0.35" /></noise2d>
    <!-- Large bug holes: 9 cells/m, jitter 0.7 (r <= 0.15 cell), 25% of cells, r 2.2..8 mm, depth 0.25 r, wall over the outer 32% of r (~50 deg max) -->
    <multiply name="multiply_65" type="vector2"><input name="in1" type="vector2" nodename="uv_hole" /><input name="in2" type="float" value="9.0" /></multiply>
    <add name="add_66" type="vector2"><input name="in1" type="vector2" nodename="multiply_65" /><input name="in2" type="vector2" value="3.7, 1.9" /></add>
    <worleynoise2d name="bhA_f1" type="float"><input name="texcoord" type="vector2" nodename="add_66" /><input name="jitter" type="float" value="0.7" /></worleynoise2d>
    <worleynoise2d name="bhA_id" type="float"><input name="texcoord" type="vector2" nodename="add_66" /><input name="jitter" type="float" value="0.7" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <add name="add_69" type="float"><input name="in1" type="float" nodename="hole_dens" /><input name="in2" type="float" value="0.75" /></add>
    <ifgreater name="bhA_on" type="float"><input name="value1" type="float" nodename="bhA_id" /><input name="value2" type="float" nodename="add_69" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_71" type="float"><input name="in1" type="float" nodename="bhA_id" /><input name="in2" type="float" value="7.31" /></multiply>
    <fract name="fract_72" type="float"><input name="in" type="float" nodename="multiply_71" /></fract>
    <multiply name="multiply_73" type="float"><input name="in1" type="float" nodename="fract_72" /><input name="in2" type="float" nodename="fract_72" /></multiply>
    <multiply name="multiply_74" type="float"><input name="in1" type="float" nodename="multiply_73" /><input name="in2" type="float" value="0.052" /></multiply>
    <multiply name="multiply_75" type="float"><input name="in1" type="float" nodename="multiply_74" /><input name="in2" type="float" nodename="bhA_on" /></multiply>
    <add name="bhA_r" type="float"><input name="in1" type="float" nodename="multiply_75" /><input name="in2" type="float" value="0.02" /></add>
    <divide name="bhA_t" type="float"><input name="in1" type="float" nodename="bhA_f1" /><input name="in2" type="float" nodename="bhA_r" /></divide>
    <smoothstep name="smoothstep_78" type="float"><input name="in" type="float" nodename="bhA_t" /><input name="low" type="float" value="0.68" /><input name="high" type="float" value="1.0" /></smoothstep>
    <subtract name="bhA_m" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_78" /></subtract>
    <multiply name="bhA_mask" type="float"><input name="in1" type="float" nodename="bhA_m" /><input name="in2" type="float" nodename="bhA_on" /></multiply>
    <multiply name="multiply_81" type="float"><input name="in1" type="float" nodename="bhA_r" /><input name="in2" type="float" value="0.027777777777777776" /></multiply>
    <multiply name="multiply_82" type="float"><input name="in1" type="float" nodename="multiply_81" /><input name="in2" type="float" value="-1.0" /></multiply>
    <multiply name="bhA_h" type="float"><input name="in1" type="float" nodename="bhA_mask" /><input name="in2" type="float" nodename="multiply_82" /></multiply>
    <smoothstep name="smoothstep_84" type="float"><input name="in" type="float" nodename="bhA_t" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.8" /></smoothstep>
    <subtract name="subtract_85" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_84" /></subtract>
    <multiply name="bhA_core" type="float"><input name="in1" type="float" nodename="bhA_on" /><input name="in2" type="float" nodename="subtract_85" /></multiply>
    <!-- Small pinholes: 32 cells/m, jitter 0.85 (r <= 0.075 cell), 12% of cells, r 0.9..2.2 mm, depth 0.3 r -->
    <multiply name="multiply_87" type="vector2"><input name="in1" type="vector2" nodename="uv_hole" /><input name="in2" type="float" value="32.0" /></multiply>
    <add name="add_88" type="vector2"><input name="in1" type="vector2" nodename="multiply_87" /><input name="in2" type="vector2" value="17.2, 8.8" /></add>
    <worleynoise2d name="bhB_f1" type="float"><input name="texcoord" type="vector2" nodename="add_88" /><input name="jitter" type="float" value="0.85" /></worleynoise2d>
    <worleynoise2d name="bhB_id" type="float"><input name="texcoord" type="vector2" nodename="add_88" /><input name="jitter" type="float" value="0.85" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <add name="add_91" type="float"><input name="in1" type="float" nodename="hole_dens" /><input name="in2" type="float" value="0.88" /></add>
    <ifgreater name="bhB_on" type="float"><input name="value1" type="float" nodename="bhB_id" /><input name="value2" type="float" nodename="add_91" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_93" type="float"><input name="in1" type="float" nodename="bhB_id" /><input name="in2" type="float" value="7.31" /></multiply>
    <fract name="fract_94" type="float"><input name="in" type="float" nodename="multiply_93" /></fract>
    <multiply name="multiply_95" type="float"><input name="in1" type="float" nodename="fract_94" /><input name="in2" type="float" nodename="fract_94" /></multiply>
    <multiply name="multiply_96" type="float"><input name="in1" type="float" nodename="multiply_95" /><input name="in2" type="float" value="0.04" /></multiply>
    <multiply name="multiply_97" type="float"><input name="in1" type="float" nodename="multiply_96" /><input name="in2" type="float" nodename="bhB_on" /></multiply>
    <add name="bhB_r" type="float"><input name="in1" type="float" nodename="multiply_97" /><input name="in2" type="float" value="0.03" /></add>
    <divide name="bhB_t" type="float"><input name="in1" type="float" nodename="bhB_f1" /><input name="in2" type="float" nodename="bhB_r" /></divide>
    <smoothstep name="smoothstep_100" type="float"><input name="in" type="float" nodename="bhB_t" /><input name="low" type="float" value="0.5" /><input name="high" type="float" value="1.0" /></smoothstep>
    <subtract name="bhB_m" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_100" /></subtract>
    <multiply name="bhB_mask" type="float"><input name="in1" type="float" nodename="bhB_m" /><input name="in2" type="float" nodename="bhB_on" /></multiply>
    <multiply name="multiply_103" type="float"><input name="in1" type="float" nodename="bhB_r" /><input name="in2" type="float" value="0.009375" /></multiply>
    <multiply name="multiply_104" type="float"><input name="in1" type="float" nodename="multiply_103" /><input name="in2" type="float" value="-1.0" /></multiply>
    <multiply name="bhB_h" type="float"><input name="in1" type="float" nodename="bhB_mask" /><input name="in2" type="float" nodename="multiply_104" /></multiply>
    <smoothstep name="smoothstep_106" type="float"><input name="in" type="float" nodename="bhB_t" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.8" /></smoothstep>
    <subtract name="subtract_107" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_106" /></subtract>
    <multiply name="bhB_core" type="float"><input name="in1" type="float" nodename="bhB_on" /><input name="in2" type="float" nodename="subtract_107" /></multiply>
    <max name="hole_mask" type="float"><input name="in1" type="float" nodename="bhA_mask" /><input name="in2" type="float" nodename="bhB_mask" /></max>
    <max name="hole_core" type="float"><input name="in1" type="float" nodename="bhA_core" /><input name="in2" type="float" nodename="bhB_core" /></max>
    <add name="add_111" type="float"><input name="in1" type="float" nodename="h_wave" /><input name="in2" type="float" nodename="h_skin" /></add>
    <add name="add_112" type="float"><input name="in1" type="float" nodename="add_111" /><input name="in2" type="float" nodename="h_sand" /></add>
    <add name="add_113" type="float"><input name="in1" type="float" nodename="bhA_h" /><input name="in2" type="float" nodename="bhB_h" /></add>
    <add name="height" type="float"><input name="in1" type="float" nodename="add_112" /><input name="in2" type="float" nodename="add_113" /></add>
    <!-- Colour: mottle between 0.30 and 0.42 linear grey, sand speckle +-6%, hole AO -->
    <mix name="c_mot" type="color3"><input name="fg" type="color3" value="0.43, 0.42, 0.4" /><input name="bg" type="color3" value="0.29, 0.285, 0.275" /><input name="mix" type="float" nodename="mottle" /></mix>
    <multiply name="multiply_116" type="float"><input name="in1" type="float" nodename="sand1" /><input name="in2" type="float" value="0.08" /></multiply>
    <multiply name="multiply_117" type="float"><input name="in1" type="float" nodename="sand2" /><input name="in2" type="float" value="0.05" /></multiply>
    <add name="add_118" type="float"><input name="in1" type="float" nodename="multiply_116" /><input name="in2" type="float" nodename="multiply_117" /></add>
    <multiply name="multiply_119" type="float"><input name="in1" type="float" nodename="grain_s" /><input name="in2" type="float" value="0.22" /></multiply>
    <add name="add_120" type="float"><input name="in1" type="float" nodename="add_118" /><input name="in2" type="float" nodename="multiply_119" /></add>
    <add name="k_sand" type="float"><input name="in1" type="float" nodename="add_120" /><input name="in2" type="float" value="1.0" /></add>
    <mix name="mix_122" type="float"><input name="fg" type="float" value="0.5" /><input name="bg" type="float" value="1.0" /><input name="mix" type="float" nodename="hole_mask" /></mix>
    <mix name="mix_123" type="float"><input name="fg" type="float" value="0.4" /><input name="bg" type="float" value="1.0" /><input name="mix" type="float" nodename="hole_core" /></mix>
    <multiply name="k_hole" type="float"><input name="in1" type="float" nodename="mix_122" /><input name="in2" type="float" nodename="mix_123" /></multiply>
    <mix name="k_patch" type="float"><input name="fg" type="float" value="0.92" /><input name="bg" type="float" value="1.0" /><input name="mix" type="float" nodename="patch" /></mix>
    <multiply name="multiply_126" type="float"><input name="in1" type="float" nodename="k_sand" /><input name="in2" type="float" nodename="k_hole" /></multiply>
    <multiply name="k_tint" type="float"><input name="in1" type="float" nodename="multiply_126" /><input name="in2" type="float" nodename="k_patch" /></multiply>
    <convert name="convert_128" type="color3"><input name="in" type="float" nodename="k_tint" /></convert>
    <multiply name="base_color" type="color3"><input name="in1" type="color3" nodename="c_mot" /><input name="in2" type="color3" nodename="convert_128" /></multiply>
    <!-- Roughness: 0.78..0.88 from mottle and sand, 0.95 in holes -->
    <mix name="r_mot" type="float"><input name="fg" type="float" value="0.86" /><input name="bg" type="float" value="0.79" /><input name="mix" type="float" nodename="mottle" /></mix>
    <multiply name="multiply_131" type="float"><input name="in1" type="float" nodename="sand2" /><input name="in2" type="float" value="0.03" /></multiply>
    <add name="add_132" type="float"><input name="in1" type="float" nodename="r_mot" /><input name="in2" type="float" nodename="multiply_131" /></add>
    <mix name="roughness" type="float"><input name="fg" type="float" value="0.95" /><input name="bg" type="float" nodename="add_132" /><input name="mix" type="float" nodename="hole_mask" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_smooth_cast" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_smooth_cast" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_smooth_cast" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_smooth_cast" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_smooth_cast" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_smooth_cast" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_smooth_cast" /></surfacematerial>
</materialx>

