<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Hard maple strip floor (gym / bowling alley), glossy polyurethane. UV 0..1 = 1 m, heights in meters. Generated by gen.py. -->
  <nodegraph name="NG_maple_strip">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- layout: 57 mm rows along U, strips 0.3..1.5 m, butt joints staggered at random per row -->
    <divide name="pk_v" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="0.057" /></divide>
    <floor name="pk_row" type="float"><input name="in" type="float" nodename="pk_v" /></floor>
    <subtract name="pk_fv" type="float"><input name="in1" type="float" nodename="pk_v" /><input name="in2" type="float" nodename="pk_row" /></subtract>
    <divide name="pk_x" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="0.9" /></divide>
    <floor name="pk_k" type="float"><input name="in" type="float" nodename="pk_x" /></floor>
    <subtract name="pk_fx" type="float"><input name="in1" type="float" nodename="pk_x" /><input name="in2" type="float" nodename="pk_k" /></subtract>
    <combine2 name="pk_kr" type="vector2"><input name="in1" type="float" nodename="pk_k" /><input name="in2" type="float" nodename="pk_row" /></combine2>
    <add name="add_10" type="vector2"><input name="in1" type="vector2" nodename="pk_kr" /><input name="in2" type="vector2" value="11.37, 5.61" /></add>
    <cellnoise2d name="pk_jr" type="float"><input name="texcoord" type="vector2" nodename="add_10" /></cellnoise2d>
    <multiply name="multiply_12" type="float"><input name="in1" type="float" nodename="pk_jr" /><input name="in2" type="float" value="0.6666666666666666" /></multiply>
    <add name="pk_j" type="float"><input name="in1" type="float" nodename="multiply_12" /><input name="in2" type="float" value="0.16666666666666666" /></add>
    <ifgreater name="pk_right" type="float"><input name="value1" type="float" nodename="pk_fx" /><input name="value2" type="float" nodename="pk_j" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_15" type="float"><input name="in1" type="float" nodename="pk_right" /><input name="in2" type="float" value="2.0" /></multiply>
    <subtract name="pk_sg" type="float"><input name="in1" type="float" nodename="multiply_15" /><input name="in2" type="float" value="1.0" /></subtract>
    <add name="pk_kn" type="float"><input name="in1" type="float" nodename="pk_k" /><input name="in2" type="float" nodename="pk_sg" /></add>
    <combine2 name="pk_knr" type="vector2"><input name="in1" type="float" nodename="pk_kn" /><input name="in2" type="float" nodename="pk_row" /></combine2>
    <add name="add_19" type="vector2"><input name="in1" type="vector2" nodename="pk_knr" /><input name="in2" type="vector2" value="11.37, 5.61" /></add>
    <cellnoise2d name="pk_nr" type="float"><input name="texcoord" type="vector2" nodename="add_19" /></cellnoise2d>
    <multiply name="multiply_21" type="float"><input name="in1" type="float" nodename="pk_nr" /><input name="in2" type="float" value="0.6666666666666666" /></multiply>
    <add name="add_22" type="float"><input name="in1" type="float" nodename="multiply_21" /><input name="in2" type="float" nodename="pk_sg" /></add>
    <add name="pk_n" type="float"><input name="in1" type="float" nodename="add_22" /><input name="in2" type="float" value="0.16666666666666666" /></add>
    <min name="pk_lo" type="float"><input name="in1" type="float" nodename="pk_j" /><input name="in2" type="float" nodename="pk_n" /></min>
    <max name="pk_hi" type="float"><input name="in1" type="float" nodename="pk_j" /><input name="in2" type="float" nodename="pk_n" /></max>
    <add name="add_26" type="float"><input name="in1" type="float" nodename="pk_lo" /><input name="in2" type="float" nodename="pk_hi" /></add>
    <multiply name="pk_mid" type="float"><input name="in1" type="float" nodename="add_26" /><input name="in2" type="float" value="0.5" /></multiply>
    <subtract name="pk_len" type="float"><input name="in1" type="float" nodename="pk_hi" /><input name="in2" type="float" nodename="pk_lo" /></subtract>
    <subtract name="subtract_29" type="float"><input name="in1" type="float" nodename="pk_fx" /><input name="in2" type="float" nodename="pk_mid" /></subtract>
    <subtract name="subtract_30" type="float"><input name="in1" type="float" nodename="pk_fv" /><input name="in2" type="float" value="0.5" /></subtract>
    <combine2 name="pk_ac" type="vector2"><input name="in1" type="float" nodename="subtract_29" /><input name="in2" type="float" nodename="subtract_30" /></combine2>
    <multiply name="pk_loc" type="vector2"><input name="in1" type="vector2" nodename="pk_ac" /><input name="in2" type="vector2" value="0.9, 0.057" /></multiply>
    <multiply name="multiply_33" type="float"><input name="in1" type="float" nodename="pk_len" /><input name="in2" type="float" value="0.45" /></multiply>
    <combine2 name="pk_half" type="vector2"><input name="in1" type="float" nodename="multiply_33" /><input name="in2" type="float" value="0.0285" /></combine2>
    <absval name="absval_35" type="vector2"><input name="in" type="vector2" nodename="pk_loc" /></absval>
    <subtract name="subtract_36" type="vector2"><input name="in1" type="vector2" nodename="pk_half" /><input name="in2" type="vector2" nodename="absval_35" /></subtract>
    <subtract name="pk_e" type="vector2"><input name="in1" type="vector2" nodename="subtract_36" /><input name="in2" type="float" value="0.00015" /></subtract>
    <separate2 name="pk_es" type="multioutput"><input name="in" type="vector2" nodename="pk_e" /></separate2>
    <min name="pk_d" type="float"><input name="in1" type="float" nodename="pk_es" output="outx" /><input name="in2" type="float" nodename="pk_es" output="outy" /></min>
    <add name="add_40" type="float"><input name="in1" type="float" nodename="pk_k" /><input name="in2" type="float" nodename="pk_right" /></add>
    <combine2 name="pk_cell" type="vector2"><input name="in1" type="float" nodename="add_40" /><input name="in2" type="float" nodename="pk_row" /></combine2>
    <add name="add_42" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="200.37, 300.61" /></add>
    <cellnoise2d name="pk_id" type="float"><input name="texcoord" type="vector2" nodename="add_42" /></cellnoise2d>
    <add name="add_44" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="417.13, 93.77" /></add>
    <cellnoise2d name="pk_id2" type="float"><input name="texcoord" type="vector2" nodename="add_44" /></cellnoise2d>
    <add name="add_46" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="61.91, 733.29" /></add>
    <cellnoise2d name="pk_id3" type="float"><input name="texcoord" type="vector2" nodename="add_46" /></cellnoise2d>
    <add name="add_48" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="538.41, 170.23" /></add>
    <cellnoise2d name="pk_id4" type="float"><input name="texcoord" type="vector2" nodename="add_48" /></cellnoise2d>
    <!-- grain frame: strip-local m, rotated +-1.2 deg (grain run-out), offset per strip -->
    <subtract name="subtract_50" type="float"><input name="in1" type="float" nodename="pk_id2" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="gr_ang" type="float"><input name="in1" type="float" nodename="subtract_50" /><input name="in2" type="float" value="2.4" /></multiply>
    <rotate2d name="gr_rot" type="vector2"><input name="in" type="vector2" nodename="pk_loc" /><input name="amount" type="float" nodename="gr_ang" /></rotate2d>
    <multiply name="multiply_53" type="vector2"><input name="in1" type="vector2" value="7.3, 5.9" /><input name="in2" type="float" nodename="pk_id" /></multiply>
    <add name="gp" type="vector2"><input name="in1" type="vector2" nodename="gr_rot" /><input name="in2" type="vector2" nodename="multiply_53" /></add>
    <multiply name="multiply_55" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="1.2, 30" /></multiply>
    <add name="add_56" type="vector2"><input name="in1" type="vector2" nodename="multiply_55" /><input name="in2" type="vector2" value="3.1, 7.9" /></add>
    <fractal2d name="gr_t1" type="float"><input name="texcoord" type="vector2" nodename="add_56" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <multiply name="multiply_58" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="5, 110" /></multiply>
    <add name="add_59" type="vector2"><input name="in1" type="vector2" nodename="multiply_58" /><input name="in2" type="vector2" value="17.3, 5.8" /></add>
    <noise2d name="gr_t2" type="float"><input name="texcoord" type="vector2" nodename="add_59" /><input name="amplitude" type="float" value="1.0" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <multiply name="multiply_61" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="2, 25" /></multiply>
    <add name="add_62" type="vector2"><input name="in1" type="vector2" nodename="multiply_61" /><input name="in2" type="vector2" value="41.3, 9.1" /></add>
    <noise2d name="gr_rw" type="float"><input name="texcoord" type="vector2" nodename="add_62" /><input name="amplitude" type="float" value="0.02" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <combine2 name="combine2_64" type="vector2"><input name="in1" type="float" value="0.0" /><input name="in2" type="float" nodename="gr_rw" /></combine2>
    <add name="add_65" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" nodename="combine2_64" /></add>
    <multiply name="multiply_66" type="vector2"><input name="in1" type="vector2" nodename="add_65" /><input name="in2" type="vector2" value="3, 60" /></multiply>
    <add name="add_67" type="vector2"><input name="in1" type="vector2" nodename="multiply_66" /><input name="in2" type="vector2" value="29.6, 15.2" /></add>
    <noise2d name="gr_rn" type="float"><input name="texcoord" type="vector2" nodename="add_67" /><input name="amplitude" type="float" value="1.0" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <absval name="absval_69" type="float"><input name="in" type="float" nodename="gr_rn" /></absval>
    <smoothstep name="smoothstep_70" type="float"><input name="in" type="float" nodename="absval_69" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.06" /></smoothstep>
    <subtract name="gr_ring" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_70" /></subtract>
    <!-- curly figure: cross bands ~5 mm along the strip, in ~12% of strips -->
    <smoothstep name="cu_on" type="float"><input name="in" type="float" nodename="pk_id3" /><input name="low" type="float" value="0.86" /><input name="high" type="float" value="0.9" /></smoothstep>
    <multiply name="multiply_73" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="8, 3" /></multiply>
    <add name="add_74" type="vector2"><input name="in1" type="vector2" nodename="multiply_73" /><input name="in2" type="vector2" value="5.5, 88.1" /></add>
    <noise2d name="cu_w" type="float"><input name="texcoord" type="vector2" nodename="add_74" /><input name="amplitude" type="float" value="0.004" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <combine2 name="combine2_76" type="vector2"><input name="in1" type="float" nodename="cu_w" /><input name="in2" type="float" value="0.0" /></combine2>
    <add name="add_77" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" nodename="combine2_76" /></add>
    <multiply name="multiply_78" type="vector2"><input name="in1" type="vector2" nodename="add_77" /><input name="in2" type="vector2" value="140, 4" /></multiply>
    <add name="add_79" type="vector2"><input name="in1" type="vector2" nodename="multiply_78" /><input name="in2" type="vector2" value="71.9, 23.3" /></add>
    <noise2d name="cu_n" type="float"><input name="texcoord" type="vector2" nodename="add_79" /><input name="amplitude" type="float" value="1.0" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <multiply name="multiply_81" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="4, 8" /></multiply>
    <add name="add_82" type="vector2"><input name="in1" type="vector2" nodename="multiply_81" /><input name="in2" type="vector2" value="9.1, 3.3" /></add>
    <noise2d name="noise2d_83" type="float"><input name="texcoord" type="vector2" nodename="add_82" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <smoothstep name="cu_pres" type="float"><input name="in" type="float" nodename="noise2d_83" /><input name="low" type="float" value="0.35" /><input name="high" type="float" value="0.6" /></smoothstep>
    <multiply name="multiply_85" type="float"><input name="in1" type="float" nodename="cu_n" /><input name="in2" type="float" nodename="cu_on" /></multiply>
    <multiply name="curl" type="float"><input name="in1" type="float" nodename="multiply_85" /><input name="in2" type="float" nodename="cu_pres" /></multiply>
    <!-- birds eye: 1-2.4 mm dots, 110/m jitter 0.7 (r <= 0.15 cell never clips), in ~7% of strips -->
    <multiply name="multiply_87" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="float" value="110" /></multiply>
    <worleynoise2d name="be_f1" type="float"><input name="texcoord" type="vector2" nodename="multiply_87" /><input name="jitter" type="float" value="0.7" /></worleynoise2d>
    <worleynoise2d name="be_id" type="float"><input name="texcoord" type="vector2" nodename="multiply_87" /><input name="jitter" type="float" value="0.7" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <smoothstep name="be_on0" type="float"><input name="in" type="float" nodename="pk_id3" /><input name="low" type="float" value="0.07" /><input name="high" type="float" value="0.08" /></smoothstep>
    <subtract name="be_on" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="be_on0" /></subtract>
    <multiply name="multiply_92" type="float"><input name="in1" type="float" nodename="be_id" /><input name="in2" type="float" value="0.09" /></multiply>
    <add name="be_r" type="float"><input name="in1" type="float" nodename="multiply_92" /><input name="in2" type="float" value="0.05" /></add>
    <smoothstep name="be_sel" type="float"><input name="in" type="float" nodename="be_id" /><input name="low" type="float" value="0.35" /><input name="high" type="float" value="0.4" /></smoothstep>
    <divide name="divide_95" type="float"><input name="in1" type="float" nodename="be_f1" /><input name="in2" type="float" nodename="be_r" /></divide>
    <smoothstep name="smoothstep_96" type="float"><input name="in" type="float" nodename="divide_95" /><input name="low" type="float" value="0.3" /><input name="high" type="float" value="0.7" /></smoothstep>
    <smoothstep name="smoothstep_97" type="float"><input name="in" type="float" nodename="divide_95" /><input name="low" type="float" value="0.7" /><input name="high" type="float" value="1.0" /></smoothstep>
    <subtract name="subtract_98" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_97" /></subtract>
    <multiply name="multiply_99" type="float"><input name="in1" type="float" nodename="smoothstep_96" /><input name="in2" type="float" nodename="subtract_98" /></multiply>
    <multiply name="multiply_100" type="float"><input name="in1" type="float" nodename="multiply_99" /><input name="in2" type="float" nodename="be_sel" /></multiply>
    <multiply name="be_dot" type="float"><input name="in1" type="float" nodename="multiply_100" /><input name="in2" type="float" nodename="be_on" /></multiply>
    <!-- mineral streaks: grey-brown lenses ~25 cm x 3 mm, tapered by threshold, in ~30% of strips -->
    <multiply name="multiply_102" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="2.5, 70" /></multiply>
    <add name="add_103" type="vector2"><input name="in1" type="vector2" nodename="multiply_102" /><input name="in2" type="vector2" value="1.37, 6.61" /></add>
    <noise2d name="mn_n" type="float"><input name="texcoord" type="vector2" nodename="add_103" /><input name="amplitude" type="float" value="1.0" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <multiply name="multiply_105" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="1.5, 6" /></multiply>
    <add name="add_106" type="vector2"><input name="in1" type="vector2" nodename="multiply_105" /><input name="in2" type="vector2" value="19.3, 41.7" /></add>
    <noise2d name="mn_m" type="float"><input name="texcoord" type="vector2" nodename="add_106" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <smoothstep name="smoothstep_108" type="float"><input name="in" type="float" nodename="mn_m" /><input name="low" type="float" value="0.4" /><input name="high" type="float" value="0.8" /></smoothstep>
    <smoothstep name="smoothstep_109" type="float"><input name="in" type="float" nodename="pk_id4" /><input name="low" type="float" value="0.7" /><input name="high" type="float" value="0.75" /></smoothstep>
    <multiply name="multiply_110" type="float"><input name="in1" type="float" nodename="smoothstep_109" /><input name="in2" type="float" value="0.42" /></multiply>
    <multiply name="multiply_111" type="float"><input name="in1" type="float" nodename="smoothstep_108" /><input name="in2" type="float" nodename="multiply_110" /></multiply>
    <subtract name="mn_t" type="float"><input name="in1" type="float" value="0.95" /><input name="in2" type="float" nodename="multiply_111" /></subtract>
    <add name="add_113" type="float"><input name="in1" type="float" nodename="mn_t" /><input name="in2" type="float" value="0.12" /></add>
    <smoothstep name="mineral" type="float"><input name="in" type="float" nodename="mn_n" /><input name="low" type="float" nodename="mn_t" /><input name="high" type="float" nodename="add_113" /></smoothstep>
    <!-- color: pale cream-blond maple, per-strip tone, golden strips, 30 cm drift -->
    <smoothstep name="golden" type="float"><input name="in" type="float" nodename="pk_id4" /><input name="low" type="float" value="0.87" /><input name="high" type="float" value="0.89" /></smoothstep>
    <multiply name="multiply_116" type="float"><input name="in1" type="float" nodename="golden" /><input name="in2" type="float" value="0.8" /></multiply>
    <mix name="c_base" type="color3"><input name="bg" type="color3" value="0.66, 0.49, 0.3" /><input name="fg" type="color3" value="0.62, 0.42, 0.21" /><input name="mix" type="float" nodename="multiply_116" /></mix>
    <subtract name="subtract_118" type="float"><input name="in1" type="float" nodename="pk_id" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_119" type="float"><input name="in1" type="float" nodename="subtract_118" /><input name="in2" type="float" value="0.16" /></multiply>
    <add name="c_tone" type="float"><input name="in1" type="float" nodename="multiply_119" /><input name="in2" type="float" value="1.0" /></add>
    <multiply name="multiply_121" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="2.5" /></multiply>
    <add name="add_122" type="vector2"><input name="in1" type="vector2" nodename="multiply_121" /><input name="in2" type="vector2" value="91.7, 37.1" /></add>
    <noise2d name="c_drift" type="float"><input name="texcoord" type="vector2" nodename="add_122" /><input name="amplitude" type="float" value="0.05" /><input name="pivot" type="float" value="1.0" /></noise2d>
    <multiply name="multiply_124" type="float"><input name="in1" type="float" nodename="gr_t1" /><input name="in2" type="float" value="0.035" /></multiply>
    <multiply name="multiply_125" type="float"><input name="in1" type="float" nodename="gr_t2" /><input name="in2" type="float" value="0.025" /></multiply>
    <add name="add_126" type="float"><input name="in1" type="float" nodename="multiply_124" /><input name="in2" type="float" nodename="multiply_125" /></add>
    <multiply name="multiply_127" type="float"><input name="in1" type="float" nodename="gr_ring" /><input name="in2" type="float" value="-0.045" /></multiply>
    <add name="add_128" type="float"><input name="in1" type="float" nodename="add_126" /><input name="in2" type="float" nodename="multiply_127" /></add>
    <multiply name="multiply_129" type="float"><input name="in1" type="float" nodename="curl" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="c_grain" type="float"><input name="in1" type="float" nodename="add_128" /><input name="in2" type="float" nodename="multiply_129" /></add>
    <multiply name="multiply_131" type="float"><input name="in1" type="float" nodename="c_tone" /><input name="in2" type="float" nodename="c_drift" /></multiply>
    <add name="add_132" type="float"><input name="in1" type="float" nodename="c_grain" /><input name="in2" type="float" value="1.0" /></add>
    <multiply name="c_bright" type="float"><input name="in1" type="float" nodename="multiply_131" /><input name="in2" type="float" nodename="add_132" /></multiply>
    <multiply name="c1" type="color3"><input name="in1" type="color3" nodename="c_base" /><input name="in2" type="float" nodename="c_bright" /></multiply>
    <multiply name="multiply_135" type="float"><input name="in1" type="float" nodename="be_dot" /><input name="in2" type="float" value="0.35" /></multiply>
    <mix name="c2" type="color3"><input name="bg" type="color3" nodename="c1" /><input name="fg" type="color3" value="0.42, 0.3, 0.17" /><input name="mix" type="float" nodename="multiply_135" /></mix>
    <multiply name="multiply_137" type="float"><input name="in1" type="float" nodename="mineral" /><input name="in2" type="float" value="0.45" /></multiply>
    <mix name="c3" type="color3"><input name="bg" type="color3" nodename="c2" /><input name="fg" type="color3" value="0.34, 0.29, 0.2" /><input name="mix" type="float" nodename="multiply_137" /></mix>
    <smoothstep name="smoothstep_139" type="float"><input name="in" type="float" nodename="pk_d" /><input name="low" type="float" value="-0.00015" /><input name="high" type="float" value="0.0002" /></smoothstep>
    <subtract name="j_line" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_139" /></subtract>
    <multiply name="multiply_141" type="float"><input name="in1" type="float" nodename="j_line" /><input name="in2" type="float" value="0.6" /></multiply>
    <mix name="c4" type="color3"><input name="bg" type="color3" nodename="c3" /><input name="fg" type="color3" value="0.12, 0.08, 0.05" /><input name="mix" type="float" nodename="multiply_141" /></mix>
    <!-- scuffs: ~6 cm x 1.5 mm marks at 20 and -35 deg, sparse patches -->
    <rotate2d name="rotate2d_143" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="20" /></rotate2d>
    <multiply name="multiply_144" type="vector2"><input name="in1" type="vector2" nodename="rotate2d_143" /><input name="in2" type="vector2" value="12, 450" /></multiply>
    <add name="add_145" type="vector2"><input name="in1" type="vector2" nodename="multiply_144" /><input name="in2" type="vector2" value="3.37, 8.61" /></add>
    <noise2d name="noise2d_146" type="float"><input name="texcoord" type="vector2" nodename="add_145" /><input name="amplitude" type="float" value="1.0" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <smoothstep name="smoothstep_147" type="float"><input name="in" type="float" nodename="noise2d_146" /><input name="low" type="float" value="0.6" /><input name="high" type="float" value="0.72" /></smoothstep>
    <multiply name="multiply_148" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="3" /></multiply>
    <add name="add_149" type="vector2"><input name="in1" type="vector2" nodename="multiply_148" /><input name="in2" type="vector2" value="1.37, 6.61" /></add>
    <noise2d name="noise2d_150" type="float"><input name="texcoord" type="vector2" nodename="add_149" /><input name="amplitude" type="float" value="1.0" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <smoothstep name="smoothstep_151" type="float"><input name="in" type="float" nodename="noise2d_150" /><input name="low" type="float" value="0.3" /><input name="high" type="float" value="0.5" /></smoothstep>
    <multiply name="multiply_152" type="float"><input name="in1" type="float" nodename="smoothstep_147" /><input name="in2" type="float" nodename="smoothstep_151" /></multiply>
    <rotate2d name="rotate2d_153" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="-35" /></rotate2d>
    <multiply name="multiply_154" type="vector2"><input name="in1" type="vector2" nodename="rotate2d_153" /><input name="in2" type="vector2" value="12, 450" /></multiply>
    <add name="add_155" type="vector2"><input name="in1" type="vector2" nodename="multiply_154" /><input name="in2" type="vector2" value="17.37, 2.61" /></add>
    <noise2d name="noise2d_156" type="float"><input name="texcoord" type="vector2" nodename="add_155" /><input name="amplitude" type="float" value="1.0" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <smoothstep name="smoothstep_157" type="float"><input name="in" type="float" nodename="noise2d_156" /><input name="low" type="float" value="0.6" /><input name="high" type="float" value="0.72" /></smoothstep>
    <multiply name="multiply_158" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="3" /></multiply>
    <add name="add_159" type="vector2"><input name="in1" type="vector2" nodename="multiply_158" /><input name="in2" type="vector2" value="9.37, 13.61" /></add>
    <noise2d name="noise2d_160" type="float"><input name="texcoord" type="vector2" nodename="add_159" /><input name="amplitude" type="float" value="1.0" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <smoothstep name="smoothstep_161" type="float"><input name="in" type="float" nodename="noise2d_160" /><input name="low" type="float" value="0.3" /><input name="high" type="float" value="0.5" /></smoothstep>
    <multiply name="multiply_162" type="float"><input name="in1" type="float" nodename="smoothstep_157" /><input name="in2" type="float" nodename="smoothstep_161" /></multiply>
    <max name="sc_mask" type="float"><input name="in1" type="float" nodename="multiply_152" /><input name="in2" type="float" nodename="multiply_162" /></max>
    <!-- height: joint dip 0.06 mm over 1.5 mm, strip cup +-0.08 mm, waviness, peel, scuffs -->
    <smoothstep name="smoothstep_164" type="float"><input name="in" type="float" nodename="pk_d" /><input name="low" type="float" value="-0.00015" /><input name="high" type="float" value="0.0015" /></smoothstep>
    <subtract name="subtract_165" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_164" /></subtract>
    <multiply name="h_joint" type="float"><input name="in1" type="float" nodename="subtract_165" /><input name="in2" type="float" value="-6e-05" /></multiply>
    <subtract name="subtract_167" type="float"><input name="in1" type="float" nodename="pk_id2" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="cup_amp" type="float"><input name="in1" type="float" nodename="subtract_167" /><input name="in2" type="float" value="0.00016" /></multiply>
    <smoothstep name="smoothstep_169" type="float"><input name="in" type="float" nodename="pk_d" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.028" /></smoothstep>
    <multiply name="h_cup" type="float"><input name="in1" type="float" nodename="smoothstep_169" /><input name="in2" type="float" nodename="cup_amp" /></multiply>
    <multiply name="multiply_171" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="4" /></multiply>
    <add name="add_172" type="vector2"><input name="in1" type="vector2" nodename="multiply_171" /><input name="in2" type="vector2" value="13.1, 71.3" /></add>
    <noise2d name="h_wave" type="float"><input name="texcoord" type="vector2" nodename="add_172" /><input name="amplitude" type="float" value="0.0009" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <multiply name="multiply_174" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="8, 20" /></multiply>
    <add name="add_175" type="vector2"><input name="in1" type="vector2" nodename="multiply_174" /><input name="in2" type="vector2" value="33.3, 8.8" /></add>
    <noise2d name="h_along" type="float"><input name="texcoord" type="vector2" nodename="add_175" /><input name="amplitude" type="float" value="0.00012" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <multiply name="multiply_177" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="90" /></multiply>
    <add name="add_178" type="vector2"><input name="in1" type="vector2" nodename="multiply_177" /><input name="in2" type="vector2" value="57.7, 21.9" /></add>
    <noise2d name="h_peel" type="float"><input name="texcoord" type="vector2" nodename="add_178" /><input name="amplitude" type="float" value="3e-05" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <multiply name="h_sc" type="float"><input name="in1" type="float" nodename="sc_mask" /><input name="in2" type="float" value="-8e-06" /></multiply>
    <add name="add_181" type="float"><input name="in1" type="float" nodename="h_joint" /><input name="in2" type="float" nodename="h_cup" /></add>
    <add name="add_182" type="float"><input name="in1" type="float" nodename="add_181" /><input name="in2" type="float" nodename="h_wave" /></add>
    <add name="add_183" type="float"><input name="in1" type="float" nodename="h_along" /><input name="in2" type="float" nodename="h_peel" /></add>
    <add name="add_184" type="float"><input name="in1" type="float" nodename="add_182" /><input name="in2" type="float" nodename="add_183" /></add>
    <add name="height" type="float"><input name="in1" type="float" nodename="add_184" /><input name="in2" type="float" nodename="h_sc" /></add>
    <subtract name="subtract_186" type="float"><input name="in1" type="float" nodename="pk_id" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_187" type="float"><input name="in1" type="float" nodename="subtract_186" /><input name="in2" type="float" value="0.03" /></multiply>
    <add name="r_board" type="float"><input name="in1" type="float" nodename="multiply_187" /><input name="in2" type="float" value="0.13" /></add>
    <multiply name="multiply_189" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="12" /></multiply>
    <add name="add_190" type="vector2"><input name="in1" type="vector2" nodename="multiply_189" /><input name="in2" type="vector2" value="5.1, 2.2" /></add>
    <noise2d name="noise2d_191" type="float"><input name="texcoord" type="vector2" nodename="add_190" /><input name="amplitude" type="float" value="0.02" /><input name="pivot" type="float" value="0.0" /></noise2d>
    <add name="r_mottle" type="float"><input name="in1" type="float" nodename="r_board" /><input name="in2" type="float" nodename="noise2d_191" /></add>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="r_mottle" /><input name="fg" type="float" value="0.32" /><input name="mix" type="float" nodename="sc_mask" /></mix>
    <multiply name="multiply_194" type="float"><input name="in1" type="float" nodename="sc_mask" /><input name="in2" type="float" value="0.25" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" nodename="c4" /><input name="fg" type="color3" value="0.66, 0.54, 0.38" /><input name="mix" type="float" nodename="multiply_194" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_maple_strip" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_maple_strip" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_maple_strip" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_maple_strip" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_maple_strip" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_maple_strip" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_maple_strip" /></surfacematerial>
</materialx>

