    <multiply name="multiply_141" type="vector2"><input name="in1" type="vector2" nodename="rotate2d_140" /><input name="in2" type="vector2" value="8.0, 700.0" /></multiply>
    <add name="add_142" type="vector2"><input name="in1" type="vector2" nodename="multiply_141" /><input name="in2" type="vector2" value="17.37, 2.61" /></add>
    <noise2d name="noise2d_143" type="float"><input name="texcoord" type="vector2" nodename="add_142" /></noise2d>
    <smoothstep name="smoothstep_144" type="float"><input name="in" type="float" nodename="noise2d_143" /><input name="low" type="float" value="0.62" /><input name="high" type="float" value="0.72" /></smoothstep>
    <multiply name="multiply_145" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="4.0" /></multiply>
    <add name="add_146" type="vector2"><input name="in1" type="vector2" nodename="multiply_145" /><input name="in2" type="vector2" value="9.37, 13.61" /></add>
    <noise2d name="noise2d_147" type="float"><input name="texcoord" type="vector2" nodename="add_146" /></noise2d>
    <smoothstep name="smoothstep_148" type="float"><input name="in" type="float" nodename="noise2d_147" /><input name="low" type="float" value="0.4" /><input name="high" type="float" value="0.55" /></smoothstep>
    <multiply name="scr_b" type="float"><input name="in1" type="float" nodename="smoothstep_144" /><input name="in2" type="float" nodename="smoothstep_148" /></multiply>
    <max name="scratch" type="float"><input name="in1" type="float" nodename="scr_a" /><input name="in2" type="float" nodename="scr_b" /></max>
    <subtract name="subtract_151" type="float"><input name="in1" type="float" nodename="ease" /><input name="in2" type="float" value="1.0" /></subtract>
    <!-- height: joint, cupping, pores, scratches -->
    <multiply name="h_joint" type="float"><input name="in1" type="float" nodename="subtract_151" /><input name="in2" type="float" value="0.00015" /></multiply>
    <divide name="divide_153" type="float"><input name="in1" type="float" nodename="across" /><input name="in2" type="float" value="0.04" /></divide>
    <divide name="divide_154" type="float"><input name="in1" type="float" nodename="across" /><input name="in2" type="float" value="0.04" /></divide>
    <multiply name="multiply_155" type="float"><input name="in1" type="float" nodename="divide_153" /><input name="in2" type="float" nodename="divide_154" /></multiply>
    <subtract name="subtract_156" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="multiply_155" /></subtract>
    <multiply name="multiply_157" type="float"><input name="in1" type="float" nodename="r_tone" /><input name="in2" type="float" value="0.00012" /></multiply>
    <multiply name="h_cup" type="float"><input name="in1" type="float" nodename="subtract_156" /><input name="in2" type="float" nodename="multiply_157" /></multiply>
    <multiply name="multiply_159" type="float"><input name="in1" type="float" nodename="earlywood" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="add_160" type="float"><input name="in1" type="float" nodename="pores" /><input name="in2" type="float" nodename="multiply_159" /></add>
    <multiply name="h_pore" type="float"><input name="in1" type="float" nodename="add_160" /><input name="in2" type="float" value="-1.2e-05" /></multiply>
    <multiply name="h_scr" type="float"><input name="in1" type="float" nodename="scratch" /><input name="in2" type="float" value="-1.5e-05" /></multiply>
    <multiply name="multiply_163" type="float"><input name="in1" type="float" nodename="h_cup" /><input name="in2" type="float" nodename="ease" /></multiply>
    <add name="add_164" type="float"><input name="in1" type="float" nodename="h_joint" /><input name="in2" type="float" nodename="multiply_163" /></add>
    <add name="add_165" type="float"><input name="in1" type="float" nodename="h_pore" /><input name="in2" type="float" nodename="h_scr" /></add>
    <multiply name="multiply_166" type="float"><input name="in1" type="float" nodename="add_165" /><input name="in2" type="float" nodename="ease" /></multiply>
    <add name="height" type="float"><input name="in1" type="float" nodename="add_164" /><input name="in2" type="float" nodename="multiply_166" /></add>
    <multiply name="multiply_168" type="float"><input name="in1" type="float" nodename="figure" /><input name="in2" type="float" value="0.3" /></multiply>
    <multiply name="multiply_169" type="float"><input name="in1" type="float" nodename="earlywood" /><input name="in2" type="float" value="0.18" /></multiply>
    <multiply name="multiply_170" type="float"><input name="in1" type="float" nodename="fibre" /><input name="in2" type="float" value="0.15" /></multiply>
    <add name="add_171" type="float"><input name="in1" type="float" nodename="multiply_169" /><input name="in2" type="float" nodename="multiply_170" /></add>
    <!-- color -->
    <add name="add_172" type="float"><input name="in1" type="float" nodename="multiply_168" /><input name="in2" type="float" nodename="add_171" /></add>
    <multiply name="multiply_173" type="float"><input name="in1" type="float" nodename="pores" /><input name="in2" type="float" value="0.55" /></multiply>
    <add name="add_174" type="float"><input name="in1" type="float" nodename="add_172" /><input name="in2" type="float" nodename="multiply_173" /></add>
    <multiply name="multiply_175" type="float"><input name="in1" type="float" nodename="along" /><input name="in2" type="float" value="150.0" /></multiply>
    <multiply name="multiply_176" type="float"><input name="in1" type="float" nodename="ring_R" /><input name="in2" type="float" value="3000.0" /></multiply>
    <combine2 name="combine2_177" type="vector2"><input name="in1" type="float" nodename="multiply_175" /><input name="in2" type="float" nodename="multiply_176" /></combine2>
    <add name="add_178" type="vector2"><input name="in1" type="vector2" nodename="combine2_177" /><input name="in2" type="vector2" value="3.7, 61.3" /></add>
    <noise2d name="microfibre" type="float"><input name="texcoord" type="vector2" nodename="add_178" /><input name="amplitude" type="float" value="0.25" /></noise2d>
    <add name="add_180" type="float"><input name="in1" type="float" nodename="add_174" /><input name="in2" type="float" nodename="microfibre" /></add>
    <add name="add_181" type="float"><input name="in1" type="float" nodename="add_180" /><input name="in2" type="float" value="0.1" /></add>
    <multiply name="multiply_182" type="float"><input name="in1" type="float" nodename="fleck" /><input name="in2" type="float" value="0.25" /></multiply>
    <subtract name="subtract_183" type="float"><input name="in1" type="float" nodename="add_181" /><input name="in2" type="float" nodename="multiply_182" /></subtract>
    <clamp name="tone" type="float"><input name="in" type="float" nodename="subtract_183" /></clamp>
    <mix name="wood" type="color3"><input name="bg" type="color3" value="0.47, 0.26, 0.095" /><input name="fg" type="color3" value="0.2, 0.095, 0.032" /><input name="mix" type="float" nodename="tone" /></mix>
    <multiply name="multiply_186" type="float"><input name="in1" type="float" nodename="fleck" /><input name="in2" type="float" value="0.5" /></multiply>
    <mix name="wood_fl" type="color3"><input name="bg" type="color3" nodename="wood" /><input name="fg" type="color3" value="0.52, 0.32, 0.13" /><input name="mix" type="float" nodename="multiply_186" /></mix>
    <multiply name="multiply_188" type="float"><input name="in1" type="float" nodename="r_tone" /><input name="in2" type="float" value="0.37" /></multiply>
    <add name="add_189" type="float"><input name="in1" type="float" nodename="multiply_188" /><input name="in2" type="float" value="0.75" /></add>
    <multiply name="multiply_190" type="float"><input name="in1" type="float" nodename="unit_id" /><input name="in2" type="float" value="0.12" /></multiply>
    <add name="add_191" type="float"><input name="in1" type="float" nodename="multiply_190" /><input name="in2" type="float" value="0.94" /></add>
    <multiply name="multiply_192" type="float"><input name="in1" type="float" nodename="drift" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="add_193" type="float"><input name="in1" type="float" nodename="multiply_192" /><input name="in2" type="float" value="1.0" /></add>
    <multiply name="multiply_194" type="float"><input name="in1" type="float" nodename="add_189" /><input name="in2" type="float" nodename="add_191" /></multiply>
    <multiply name="bright" type="float"><input name="in1" type="float" nodename="multiply_194" /><input name="in2" type="float" nodename="add_193" /></multiply>
    <mix name="hue" type="color3"><input name="bg" type="color3" value="1.05, 0.98, 0.9" /><input name="fg" type="color3" value="0.96, 1.0, 1.05" /><input name="mix" type="float" nodename="r_hue" /></mix>
    <multiply name="multiply_197" type="color3"><input name="in1" type="color3" nodename="wood_fl" /><input name="in2" type="color3" nodename="hue" /></multiply>
    <multiply name="multiply_198" type="color3"><input name="in1" type="color3" nodename="multiply_197" /><input name="in2" type="float" nodename="bright" /></multiply>
    <multiply name="multiply_199" type="float"><input name="in1" type="float" nodename="wear" /><input name="in2" type="float" value="0.12" /></multiply>
    <mix name="col_wear" type="color3"><input name="bg" type="color3" nodename="multiply_198" /><input name="fg" type="color3" value="0.45, 0.3, 0.15" /><input name="mix" type="float" nodename="multiply_199" /></mix>
    <multiply name="multiply_201" type="float"><input name="in1" type="float" nodename="scratch" /><input name="in2" type="float" value="0.2" /></multiply>
    <mix name="col_scr" type="color3"><input name="bg" type="color3" nodename="col_wear" /><input name="fg" type="color3" value="0.55, 0.42, 0.27" /><input name="mix" type="float" nodename="multiply_201" /></mix>
    <multiply name="multiply_203" type="float"><input name="in1" type="float" nodename="edge_grime" /><input name="in2" type="float" value="0.3" /></multiply>
    <subtract name="subtract_204" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="multiply_203" /></subtract>
    <multiply name="col_grime" type="color3"><input name="in1" type="color3" nodename="col_scr" /><input name="in2" type="float" nodename="subtract_204" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" nodename="col_grime" /><input name="fg" type="color3" value="0.03, 0.02, 0.012" /><input name="mix" type="float" nodename="joint" /></mix>
    <multiply name="multiply_207" type="float"><input name="in1" type="float" nodename="r_hue" /><input name="in2" type="float" value="0.06" /></multiply>
    <!-- roughness -->
    <add name="add_208" type="float"><input name="in1" type="float" nodename="multiply_207" /><input name="in2" type="float" value="0.37" /></add>
    <multiply name="multiply_209" type="float"><input name="in1" type="float" nodename="pores" /><input name="in2" type="float" value="0.06" /></multiply>
    <add name="add_210" type="float"><input name="in1" type="float" nodename="add_208" /><input name="in2" type="float" nodename="multiply_209" /></add>
    <multiply name="multiply_211" type="float"><input name="in1" type="float" nodename="fleck" /><input name="in2" type="float" value="0.1" /></multiply>
    <subtract name="subtract_212" type="float"><input name="in1" type="float" nodename="add_210" /><input name="in2" type="float" nodename="multiply_211" /></subtract>
    <multiply name="multiply_213" type="float"><input name="in1" type="float" nodename="wear" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="add_214" type="float"><input name="in1" type="float" nodename="subtract_212" /><input name="in2" type="float" nodename="multiply_213" /></add>
    <multiply name="multiply_215" type="float"><input name="in1" type="float" nodename="scratch" /><input name="in2" type="float" value="0.15" /></multiply>
    <add name="add_216" type="float"><input name="in1" type="float" nodename="add_214" /><input name="in2" type="float" nodename="multiply_215" /></add>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="add_216" /><input name="fg" type="float" value="0.8" /><input name="mix" type="float" nodename="joint" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_basketweave_parquet" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_basketweave_parquet" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_basketweave_parquet" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_basketweave_parquet" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_basketweave_parquet" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_basketweave_parquet" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_basketweave_parquet" /></surfacematerial>
</materialx>

