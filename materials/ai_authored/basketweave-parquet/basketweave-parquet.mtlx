    <add name="add_101" type="vector2"><input name="in1" type="vector2" nodename="combine2_100" /><input name="in2" type="vector2" value="5.3, 17.9" /></add>
    <noise2d name="pore_n" type="float"><input name="texcoord" type="vector2" nodename="add_101" /></noise2d>
    <smoothstep name="smoothstep_103" type="float"><input name="in" type="float" nodename="pore_n" /><input name="low" type="float" value="0.1" /><input name="high" type="float" value="0.45" /></smoothstep>
    <multiply name="multiply_104" type="float"><input name="in1" type="float" nodename="earlywood" /><input name="in2" type="float" value="0.8" /></multiply>
    <add name="add_105" type="float"><input name="in1" type="float" nodename="multiply_104" /><input name="in2" type="float" value="0.2" /></add>
    <multiply name="pores" type="float"><input name="in1" type="float" nodename="smoothstep_103" /><input name="in2" type="float" nodename="add_105" /></multiply>
    <multiply name="multiply_107" type="float"><input name="in1" type="float" nodename="along" /><input name="in2" type="float" value="25.0" /></multiply>
    <multiply name="multiply_108" type="float"><input name="in1" type="float" nodename="ring_R" /><input name="in2" type="float" value="500.0" /></multiply>
    <combine2 name="combine2_109" type="vector2"><input name="in1" type="float" nodename="multiply_107" /><input name="in2" type="float" nodename="multiply_108" /></combine2>
    <add name="add_110" type="vector2"><input name="in1" type="vector2" nodename="combine2_109" /><input name="in2" type="vector2" value="41.3, 9.1" /></add>
    <noise2d name="fibre" type="float"><input name="texcoord" type="vector2" nodename="add_110" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <subtract name="subtract_112" type="float"><input name="in1" type="float" nodename="r_fleck" /><input name="in2" type="float" value="0.5" /></subtract>
