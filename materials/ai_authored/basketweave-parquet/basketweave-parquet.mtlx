    <add name="add_116" type="vector2"><input name="in1" type="vector2" nodename="multiply_115" /><input name="in2" type="float" nodename="seed_o" /></add>
    <fractal2d name="fleck_n" type="float"><input name="texcoord" type="vector2" nodename="add_116" /><input name="octaves" type="integer" value="4" /></fractal2d>
    <smoothstep name="smoothstep_118" type="float"><input name="in" type="float" nodename="r_fleck" /><input name="low" type="float" value="0.1" /><input name="high" type="float" value="0.4" /></smoothstep>
    <multiply name="fleck_on" type="float"><input name="in1" type="float" nodename="quarter" /><input name="in2" type="float" nodename="smoothstep_118" /></multiply>
    <smoothstep name="smoothstep_120" type="float"><input name="in" type="float" nodename="fleck_n" /><input name="low" type="float" value="0.35" /><input name="high" type="float" value="0.6" /></smoothstep>
    <multiply name="multiply_121" type="float"><input name="in1" type="float" nodename="fleck_on" /><input name="in2" type="float" value="0.6" /></multiply>
    <multiply name="fleck" type="float"><input name="in1" type="float" nodename="smoothstep_120" /><input name="in2" type="float" nodename="multiply_121" /></multiply>
    <multiply name="multiply_123" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="2.0" /></multiply>
    <add name="add_124" type="vector2"><input name="in1" type="vector2" nodename="multiply_123" /><input name="in2" type="vector2" value="7.3, 2.9" /></add>
    <!-- floor scale: tone drift, traffic wear, scratches -->
    <fractal2d name="drift" type="float"><input name="texcoord" type="vector2" nodename="add_124" /><input name="octaves" type="integer" value="3" /></fractal2d>
