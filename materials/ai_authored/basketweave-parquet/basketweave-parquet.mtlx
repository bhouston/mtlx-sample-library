<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- basketweave-parquet: oak basketweave, 240 mm units of 3 x 80x240 mm slats, satin varnish. UV 0..1 = 1 m, heights in m. -->
  <nodegraph name="NG_basketweave_parquet">
    <texcoord name="uv" type="vector2"></texcoord>
    <divide name="divide_2" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="0.24" /></divide>
    <!-- layout: 240 mm units, checkerboard of H/V triplets -->
    <floor name="unit_ij" type="vector2"><input name="in" type="vector2" nodename="divide_2" /></floor>
    <multiply name="multiply_4" type="vector2"><input name="in1" type="vector2" nodename="unit_ij" /><input name="in2" type="float" value="0.24" /></multiply>
    <subtract name="unit_f" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" nodename="multiply_4" /></subtract>
    <separate2 name="ij_s" type="multioutput"><input name="in" type="vector2" nodename="unit_ij" /></separate2>
    <separate2 name="f_s" type="multioutput"><input name="in" type="vector2" nodename="unit_f" /></separate2>
    <add name="add_8" type="float"><input name="in1" type="float" nodename="ij_s" output="outx" /><input name="in2" type="float" nodename="ij_s" output="outy" /></add>
    <modulo name="parity" type="float"><input name="in1" type="float" nodename="add_8" /><input name="in2" type="float" value="2.0" /></modulo>
    <mix name="across_c" type="float"><input name="bg" type="float" nodename="f_s" output="outy" /><input name="fg" type="float" nodename="f_s" output="outx" /><input name="mix" type="float" nodename="parity" /></mix>
    <mix name="along_c" type="float"><input name="bg" type="float" nodename="f_s" output="outx" /><input name="fg" type="float" nodename="f_s" output="outy" /><input name="mix" type="float" nodename="parity" /></mix>
    <divide name="divide_12" type="float"><input name="in1" type="float" nodename="across_c" /><input name="in2" type="float" value="0.08" /></divide>
    <floor name="slat_k" type="float"><input name="in" type="float" nodename="divide_12" /></floor>
    <multiply name="multiply_14" type="float"><input name="in1" type="float" nodename="slat_k" /><input name="in2" type="float" value="0.08" /></multiply>
    <subtract name="subtract_15" type="float"><input name="in1" type="float" nodename="across_c" /><input name="in2" type="float" nodename="multiply_14" /></subtract>
    <subtract name="across" type="float"><input name="in1" type="float" nodename="subtract_15" /><input name="in2" type="float" value="0.04" /></subtract>
    <subtract name="along" type="float"><input name="in1" type="float" nodename="along_c" /><input name="in2" type="float" value="0.12" /></subtract>
    <multiply name="multiply_18" type="float"><input name="in1" type="float" nodename="ij_s" output="outx" /><input name="in2" type="float" value="3.0" /></multiply>
    <add name="add_19" type="float"><input name="in1" type="float" nodename="multiply_18" /><input name="in2" type="float" nodename="slat_k" /></add>
    <combine2 name="slat_key" type="vector2"><input name="in1" type="float" nodename="add_19" /><input name="in2" type="float" nodename="ij_s" output="outy" /></combine2>
    <multiply name="multiply_21" type="vector2"><input name="in1" type="vector2" value="173.0, 91.0" /><input name="in2" type="float" nodename="parity" /></multiply>
    <add name="slat_key2" type="vector2"><input name="in1" type="vector2" nodename="slat_key" /><input name="in2" type="vector2" nodename="multiply_21" /></add>
    <add name="add_23" type="vector2"><input name="in1" type="vector2" nodename="slat_key2" /><input name="in2" type="vector2" value="200.37, 300.61" /></add>
    <cellnoise2d name="slat_id" type="float"><input name="texcoord" type="vector2" nodename="add_23" /></cellnoise2d>
    <add name="add_25" type="vector2"><input name="in1" type="vector2" nodename="slat_key2" /><input name="in2" type="vector2" value="37.37, 11.61" /></add>
    <cellnoise2d name="r_type" type="float"><input name="texcoord" type="vector2" nodename="add_25" /></cellnoise2d>
    <add name="add_27" type="vector2"><input name="in1" type="vector2" nodename="slat_key2" /><input name="in2" type="vector2" value="71.37, 53.61" /></add>
    <cellnoise2d name="r_ring" type="float"><input name="texcoord" type="vector2" nodename="add_27" /></cellnoise2d>
    <add name="add_29" type="vector2"><input name="in1" type="vector2" nodename="slat_key2" /><input name="in2" type="vector2" value="13.37, 91.61" /></add>
    <cellnoise2d name="r_off" type="float"><input name="texcoord" type="vector2" nodename="add_29" /></cellnoise2d>
    <add name="add_31" type="vector2"><input name="in1" type="vector2" nodename="slat_key2" /><input name="in2" type="vector2" value="211.37, 7.61" /></add>
    <cellnoise2d name="r_tone" type="float"><input name="texcoord" type="vector2" nodename="add_31" /></cellnoise2d>
    <add name="add_33" type="vector2"><input name="in1" type="vector2" nodename="slat_key2" /><input name="in2" type="vector2" value="61.37, 147.61" /></add>
    <cellnoise2d name="r_hue" type="float"><input name="texcoord" type="vector2" nodename="add_33" /></cellnoise2d>
    <add name="add_35" type="vector2"><input name="in1" type="vector2" nodename="slat_key2" /><input name="in2" type="vector2" value="97.37, 29.61" /></add>
    <cellnoise2d name="r_taper" type="float"><input name="texcoord" type="vector2" nodename="add_35" /></cellnoise2d>
    <add name="add_37" type="vector2"><input name="in1" type="vector2" nodename="slat_key2" /><input name="in2" type="vector2" value="131.37, 67.61" /></add>
    <cellnoise2d name="r_fleck" type="float"><input name="texcoord" type="vector2" nodename="add_37" /></cellnoise2d>
    <add name="add_39" type="vector2"><input name="in1" type="vector2" nodename="unit_ij" /><input name="in2" type="vector2" value="410.37, 90.61" /></add>
    <cellnoise2d name="unit_id" type="float"><input name="texcoord" type="vector2" nodename="add_39" /></cellnoise2d>
    <absval name="absval_41" type="float"><input name="in" type="float" nodename="along" /></absval>
    <subtract name="subtract_42" type="float"><input name="in1" type="float" value="0.12" /><input name="in2" type="float" nodename="absval_41" /></subtract>
    <absval name="absval_43" type="float"><input name="in" type="float" nodename="across" /></absval>
    <subtract name="subtract_44" type="float"><input name="in1" type="float" value="0.04" /><input name="in2" type="float" nodename="absval_43" /></subtract>
    <!-- joint: 0.5 mm gap, 1.4 mm ease, 0.3 mm deep -->
    <min name="d_edge" type="float"><input name="in1" type="float" nodename="subtract_42" /><input name="in2" type="float" nodename="subtract_44" /></min>
    <smoothstep name="smoothstep_46" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="0.00012" /><input name="high" type="float" value="0.0004" /></smoothstep>
    <subtract name="joint" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_46" /></subtract>
    <smoothstep name="ease" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="0.0002" /><input name="high" type="float" value="0.0012" /></smoothstep>
    <smoothstep name="smoothstep_49" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="0.0003" /><input name="high" type="float" value="0.0025" /></smoothstep>
    <subtract name="edge_grime" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_49" /></subtract>
    <!-- grain: ring radius model, per-slat sawing -->
    <ifgreater name="quarter" type="float"><input name="value1" type="float" nodename="r_type" /><input name="value2" type="float" value="0.55" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_52" type="float"><input name="in1" type="float" nodename="r_off" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="add_53" type="float"><input name="in1" type="float" nodename="multiply_52" /><input name="in2" type="float" value="0.2" /></add>
    <subtract name="subtract_54" type="float"><input name="in1" type="float" nodename="r_off" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_55" type="float"><input name="in1" type="float" nodename="subtract_54" /><input name="in2" type="float" value="0.06" /></multiply>
    <mix name="ring_o" type="float"><input name="bg" type="float" nodename="multiply_55" /><input name="fg" type="float" nodename="add_53" /><input name="mix" type="float" nodename="quarter" /></mix>
    <multiply name="multiply_57" type="float"><input name="in1" type="float" nodename="r_ring" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="add_58" type="float"><input name="in1" type="float" nodename="multiply_57" /><input name="in2" type="float" value="0.03" /></add>
    <mix name="ring_D" type="float"><input name="bg" type="float" nodename="add_58" /><input name="fg" type="float" value="0.002" /><input name="mix" type="float" nodename="quarter" /></mix>
    <subtract name="subtract_60" type="float"><input name="in1" type="float" nodename="r_taper" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_61" type="float"><input name="in1" type="float" nodename="subtract_60" /><input name="in2" type="float" value="0.16" /></multiply>
    <subtract name="subtract_62" type="float"><input name="in1" type="float" nodename="r_taper" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_63" type="float"><input name="in1" type="float" nodename="subtract_62" /><input name="in2" type="float" value="0.04" /></multiply>
    <mix name="taper" type="float"><input name="bg" type="float" nodename="multiply_61" /><input name="fg" type="float" nodename="multiply_63" /><input name="mix" type="float" nodename="quarter" /></mix>
    <add name="add_65" type="float"><input name="in1" type="float" nodename="across" /><input name="in2" type="float" nodename="ring_o" /></add>
    <multiply name="multiply_66" type="float"><input name="in1" type="float" nodename="add_65" /><input name="in2" type="float" nodename="add_65" /></multiply>
    <multiply name="multiply_67" type="float"><input name="in1" type="float" nodename="ring_D" /><input name="in2" type="float" nodename="ring_D" /></multiply>
    <add name="add_68" type="float"><input name="in1" type="float" nodename="multiply_66" /><input name="in2" type="float" nodename="multiply_67" /></add>
    <sqrt name="sqrt_69" type="float"><input name="in" type="float" nodename="add_68" /></sqrt>
    <combine2 name="slat_lp" type="vector2"><input name="in1" type="float" nodename="along" /><input name="in2" type="float" nodename="across" /></combine2>
    <multiply name="seed_o" type="float"><input name="in1" type="float" nodename="slat_id" /><input name="in2" type="float" value="37.0" /></multiply>
    <multiply name="multiply_72" type="vector2"><input name="in1" type="vector2" nodename="slat_lp" /><input name="in2" type="vector2" value="6.0, 25.0" /></multiply>
    <add name="add_73" type="vector2"><input name="in1" type="vector2" nodename="multiply_72" /><input name="in2" type="float" nodename="seed_o" /></add>
    <noise2d name="ring_wob" type="float"><input name="texcoord" type="vector2" nodename="add_73" /><input name="amplitude" type="float" value="0.0024" /></noise2d>
    <multiply name="multiply_75" type="float"><input name="in1" type="float" nodename="taper" /><input name="in2" type="float" nodename="along" /></multiply>
    <add name="add_76" type="float"><input name="in1" type="float" nodename="sqrt_69" /><input name="in2" type="float" nodename="multiply_75" /></add>
    <add name="ring_R" type="float"><input name="in1" type="float" nodename="add_76" /><input name="in2" type="float" nodename="ring_wob" /></add>
    <multiply name="multiply_78" type="float"><input name="in1" type="float" nodename="r_ring" /><input name="in2" type="float" value="110.0" /></multiply>
    <add name="rings_pm" type="float"><input name="in1" type="float" nodename="multiply_78" /><input name="in2" type="float" value="180.0" /></add>
    <multiply name="multiply_80" type="float"><input name="in1" type="float" nodename="ring_R" /><input name="in2" type="float" value="35.0" /></multiply>
    <combine2 name="combine2_81" type="vector2"><input name="in1" type="float" nodename="multiply_80" /><input name="in2" type="float" value="0.5" /></combine2>
    <add name="add_82" type="vector2"><input name="in1" type="vector2" nodename="combine2_81" /><input name="in2" type="float" nodename="seed_o" /></add>
    <noise2d name="ring_yr" type="float"><input name="texcoord" type="vector2" nodename="add_82" /><input name="amplitude" type="float" value="1.6" /></noise2d>
    <multiply name="multiply_84" type="float"><input name="in1" type="float" nodename="ring_R" /><input name="in2" type="float" nodename="rings_pm" /></multiply>
    <add name="add_85" type="float"><input name="in1" type="float" nodename="multiply_84" /><input name="in2" type="float" nodename="ring_yr" /></add>
    <multiply name="multiply_86" type="float"><input name="in1" type="float" nodename="r_off" /><input name="in2" type="float" value="13.0" /></multiply>
    <add name="add_87" type="float"><input name="in1" type="float" nodename="add_85" /><input name="in2" type="float" nodename="multiply_86" /></add>
    <fract name="ring_ph" type="float"><input name="in" type="float" nodename="add_87" /></fract>
    <smoothstep name="smoothstep_89" type="float"><input name="in" type="float" nodename="ring_ph" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.05" /></smoothstep>
    <smoothstep name="smoothstep_90" type="float"><input name="in" type="float" nodename="ring_ph" /><input name="low" type="float" value="0.15" /><input name="high" type="float" value="0.4" /></smoothstep>
    <subtract name="subtract_91" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_90" /></subtract>
    <multiply name="earlywood" type="float"><input name="in1" type="float" nodename="smoothstep_89" /><input name="in2" type="float" nodename="subtract_91" /></multiply>
    <multiply name="multiply_93" type="float"><input name="in1" type="float" nodename="ring_R" /><input name="in2" type="float" value="45.0" /></multiply>
    <multiply name="multiply_94" type="float"><input name="in1" type="float" nodename="along" /><input name="in2" type="float" value="2.0" /></multiply>
    <combine2 name="combine2_95" type="vector2"><input name="in1" type="float" nodename="multiply_93" /><input name="in2" type="float" nodename="multiply_94" /></combine2>
    <add name="add_96" type="vector2"><input name="in1" type="vector2" nodename="combine2_95" /><input name="in2" type="float" nodename="seed_o" /></add>
    <noise2d name="figure" type="float"><input name="texcoord" type="vector2" nodename="add_96" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="multiply_98" type="float"><input name="in1" type="float" nodename="along" /><input name="in2" type="float" value="70.0" /></multiply>
    <multiply name="multiply_99" type="float"><input name="in1" type="float" nodename="ring_R" /><input name="in2" type="float" value="2400.0" /></multiply>
