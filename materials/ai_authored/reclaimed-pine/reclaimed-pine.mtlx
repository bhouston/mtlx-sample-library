    <add name="add_143" type="float"><input name="in1" type="float" nodename="subtract_142" /><input name="in2" type="float" nodename="noise2d_141" /></add>
    <combine2 name="combine2_144" type="vector2"><input name="in1" type="float" nodename="add_143" /><input name="in2" type="float" nodename="add_137" /></combine2>
