<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Reclaimed heart-pine floorboards: 150..250 mm rows, 0.65..1.95 m boards, 1..3 mm gaps, worn wax. UV 0..1 = 1 m, heights in m. Generated by gen.py -->
  <nodegraph name="NG_reclaimed_pine">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- rows: 150..250 mm wide, random per row -->
    <divide name="r_vs" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="0.2" /></divide>
    <floor name="r_k" type="float"><input name="in" type="float" nodename="r_vs" /></floor>
    <subtract name="r_fv" type="float"><input name="in1" type="float" nodename="r_vs" /><input name="in2" type="float" nodename="r_k" /></subtract>
    <combine2 name="combine2_6" type="vector2"><input name="in1" type="float" nodename="r_k" /><input name="in2" type="float" value="3.0" /></combine2>
    <add name="add_7" type="vector2"><input name="in1" type="vector2" nodename="combine2_6" /><input name="in2" type="vector2" value="11.37, 5.61" /></add>
    <cellnoise2d name="cellnoise2d_8" type="float"><input name="texcoord" type="vector2" nodename="add_7" /></cellnoise2d>
    <multiply name="multiply_9" type="float"><input name="in1" type="float" nodename="cellnoise2d_8" /><input name="in2" type="float" value="0.25" /></multiply>
    <add name="add_10" type="float"><input name="in1" type="float" nodename="multiply_9" /><input name="in2" type="float" value="0.375" /></add>
    <ifgreater name="r_above" type="float"><input name="value1" type="float" nodename="r_fv" /><input name="value2" type="float" nodename="add_10" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_12" type="float"><input name="in1" type="float" nodename="r_above" /><input name="in2" type="float" value="2.0" /></multiply>
    <subtract name="subtract_13" type="float"><input name="in1" type="float" nodename="multiply_12" /><input name="in2" type="float" value="1.0" /></subtract>
    <add name="add_14" type="float"><input name="in1" type="float" nodename="r_k" /><input name="in2" type="float" nodename="subtract_13" /></add>
    <combine2 name="combine2_15" type="vector2"><input name="in1" type="float" nodename="add_14" /><input name="in2" type="float" value="3.0" /></combine2>
    <add name="add_16" type="vector2"><input name="in1" type="vector2" nodename="combine2_15" /><input name="in2" type="vector2" value="11.37, 5.61" /></add>
    <cellnoise2d name="cellnoise2d_17" type="float"><input name="texcoord" type="vector2" nodename="add_16" /></cellnoise2d>
    <multiply name="multiply_18" type="float"><input name="in1" type="float" nodename="cellnoise2d_17" /><input name="in2" type="float" value="0.25" /></multiply>
    <add name="add_19" type="float"><input name="in1" type="float" nodename="multiply_18" /><input name="in2" type="float" value="0.375" /></add>
    <add name="add_20" type="float"><input name="in1" type="float" nodename="add_19" /><input name="in2" type="float" nodename="subtract_13" /></add>
    <min name="min_21" type="float"><input name="in1" type="float" nodename="add_10" /><input name="in2" type="float" nodename="add_20" /></min>
    <max name="max_22" type="float"><input name="in1" type="float" nodename="add_10" /><input name="in2" type="float" nodename="add_20" /></max>
    <add name="add_23" type="float"><input name="in1" type="float" nodename="min_21" /><input name="in2" type="float" nodename="max_22" /></add>
    <multiply name="multiply_24" type="float"><input name="in1" type="float" nodename="add_23" /><input name="in2" type="float" value="0.5" /></multiply>
    <subtract name="subtract_25" type="float"><input name="in1" type="float" nodename="max_22" /><input name="in2" type="float" nodename="min_21" /></subtract>
    <multiply name="hw" type="float"><input name="in1" type="float" nodename="subtract_25" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="row" type="float"><input name="in1" type="float" nodename="r_k" /><input name="in2" type="float" nodename="r_above" /></add>
    <subtract name="subtract_28" type="float"><input name="in1" type="float" nodename="r_fv" /><input name="in2" type="float" nodename="multiply_24" /></subtract>
    <multiply name="c" type="float"><input name="in1" type="float" nodename="subtract_28" /><input name="in2" type="float" value="0.2" /></multiply>
    <!-- boards: 0.65..1.95 m long, joints random per row -->
    <divide name="b_xs" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="1.3" /></divide>
    <floor name="b_k" type="float"><input name="in" type="float" nodename="b_xs" /></floor>
    <subtract name="b_fx" type="float"><input name="in1" type="float" nodename="b_xs" /><input name="in2" type="float" nodename="b_k" /></subtract>
    <combine2 name="combine2_33" type="vector2"><input name="in1" type="float" nodename="b_k" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_34" type="vector2"><input name="in1" type="vector2" nodename="combine2_33" /><input name="in2" type="vector2" value="41.37, 9.61" /></add>
    <cellnoise2d name="cellnoise2d_35" type="float"><input name="texcoord" type="vector2" nodename="add_34" /></cellnoise2d>
    <multiply name="multiply_36" type="float"><input name="in1" type="float" nodename="cellnoise2d_35" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="add_37" type="float"><input name="in1" type="float" nodename="multiply_36" /><input name="in2" type="float" value="0.25" /></add>
    <ifgreater name="b_right" type="float"><input name="value1" type="float" nodename="b_fx" /><input name="value2" type="float" nodename="add_37" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_39" type="float"><input name="in1" type="float" nodename="b_right" /><input name="in2" type="float" value="2.0" /></multiply>
    <subtract name="subtract_40" type="float"><input name="in1" type="float" nodename="multiply_39" /><input name="in2" type="float" value="1.0" /></subtract>
    <add name="add_41" type="float"><input name="in1" type="float" nodename="b_k" /><input name="in2" type="float" nodename="subtract_40" /></add>
    <combine2 name="combine2_42" type="vector2"><input name="in1" type="float" nodename="add_41" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_43" type="vector2"><input name="in1" type="vector2" nodename="combine2_42" /><input name="in2" type="vector2" value="41.37, 9.61" /></add>
    <cellnoise2d name="cellnoise2d_44" type="float"><input name="texcoord" type="vector2" nodename="add_43" /></cellnoise2d>
    <multiply name="multiply_45" type="float"><input name="in1" type="float" nodename="cellnoise2d_44" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="add_46" type="float"><input name="in1" type="float" nodename="multiply_45" /><input name="in2" type="float" value="0.25" /></add>
    <add name="add_47" type="float"><input name="in1" type="float" nodename="add_46" /><input name="in2" type="float" nodename="subtract_40" /></add>
    <min name="min_48" type="float"><input name="in1" type="float" nodename="add_37" /><input name="in2" type="float" nodename="add_47" /></min>
    <max name="max_49" type="float"><input name="in1" type="float" nodename="add_37" /><input name="in2" type="float" nodename="add_47" /></max>
    <add name="add_50" type="float"><input name="in1" type="float" nodename="min_48" /><input name="in2" type="float" nodename="max_49" /></add>
    <multiply name="multiply_51" type="float"><input name="in1" type="float" nodename="add_50" /><input name="in2" type="float" value="0.5" /></multiply>
    <subtract name="subtract_52" type="float"><input name="in1" type="float" nodename="max_49" /><input name="in2" type="float" nodename="min_48" /></subtract>
    <multiply name="hl" type="float"><input name="in1" type="float" nodename="subtract_52" /><input name="in2" type="float" value="0.65" /></multiply>
    <subtract name="subtract_54" type="float"><input name="in1" type="float" nodename="b_fx" /><input name="in2" type="float" nodename="multiply_51" /></subtract>
    <multiply name="a" type="float"><input name="in1" type="float" nodename="subtract_54" /><input name="in2" type="float" value="1.3" /></multiply>
    <add name="b_col" type="float"><input name="in1" type="float" nodename="b_k" /><input name="in2" type="float" nodename="b_right" /></add>
    <combine2 name="combine2_57" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_58" type="vector2"><input name="in1" type="vector2" nodename="combine2_57" /><input name="in2" type="vector2" value="200.37, 300.61" /></add>
    <cellnoise2d name="bid0" type="float"><input name="texcoord" type="vector2" nodename="add_58" /></cellnoise2d>
    <combine2 name="combine2_60" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_61" type="vector2"><input name="in1" type="vector2" nodename="combine2_60" /><input name="in2" type="vector2" value="213.37, 307.61" /></add>
    <cellnoise2d name="bid1" type="float"><input name="texcoord" type="vector2" nodename="add_61" /></cellnoise2d>
    <combine2 name="combine2_63" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_64" type="vector2"><input name="in1" type="vector2" nodename="combine2_63" /><input name="in2" type="vector2" value="226.37, 314.61" /></add>
    <cellnoise2d name="bid2" type="float"><input name="texcoord" type="vector2" nodename="add_64" /></cellnoise2d>
    <combine2 name="combine2_66" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_67" type="vector2"><input name="in1" type="vector2" nodename="combine2_66" /><input name="in2" type="vector2" value="239.37, 321.61" /></add>
    <cellnoise2d name="bid3" type="float"><input name="texcoord" type="vector2" nodename="add_67" /></cellnoise2d>
    <combine2 name="combine2_69" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_70" type="vector2"><input name="in1" type="vector2" nodename="combine2_69" /><input name="in2" type="vector2" value="252.37, 328.61" /></add>
    <cellnoise2d name="bid4" type="float"><input name="texcoord" type="vector2" nodename="add_70" /></cellnoise2d>
    <combine2 name="combine2_72" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_73" type="vector2"><input name="in1" type="vector2" nodename="combine2_72" /><input name="in2" type="vector2" value="265.37, 335.61" /></add>
    <cellnoise2d name="bid5" type="float"><input name="texcoord" type="vector2" nodename="add_73" /></cellnoise2d>
    <combine2 name="combine2_75" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_76" type="vector2"><input name="in1" type="vector2" nodename="combine2_75" /><input name="in2" type="vector2" value="278.37, 342.61" /></add>
    <cellnoise2d name="bid6" type="float"><input name="texcoord" type="vector2" nodename="add_76" /></cellnoise2d>
    <combine2 name="combine2_78" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_79" type="vector2"><input name="in1" type="vector2" nodename="combine2_78" /><input name="in2" type="vector2" value="291.37, 349.61" /></add>
    <cellnoise2d name="bid7" type="float"><input name="texcoord" type="vector2" nodename="add_79" /></cellnoise2d>
    <combine2 name="combine2_81" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_82" type="vector2"><input name="in1" type="vector2" nodename="combine2_81" /><input name="in2" type="vector2" value="304.37, 356.61" /></add>
    <cellnoise2d name="bid8" type="float"><input name="texcoord" type="vector2" nodename="add_82" /></cellnoise2d>
    <combine2 name="combine2_84" type="vector2"><input name="in1" type="float" nodename="b_col" /><input name="in2" type="float" nodename="row" /></combine2>
    <add name="add_85" type="vector2"><input name="in1" type="vector2" nodename="combine2_84" /><input name="in2" type="vector2" value="317.37, 363.61" /></add>
    <cellnoise2d name="bid9" type="float"><input name="texcoord" type="vector2" nodename="add_85" /></cellnoise2d>
    <!-- gaps: 1..3 mm, irregular -->
    <ifgreater name="side" type="float"><input name="value1" type="float" nodename="c" /><input name="value2" type="float" value="0.0" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_88" type="float"><input name="in1" type="float" nodename="row" /><input name="in2" type="float" value="7.3" /></multiply>
    <multiply name="multiply_89" type="float"><input name="in1" type="float" nodename="side" /><input name="in2" type="float" value="3.1" /></multiply>
    <add name="add_90" type="float"><input name="in1" type="float" nodename="multiply_89" /><input name="in2" type="float" nodename="multiply_88" /></add>
    <combine2 name="combine2_91" type="vector2"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" nodename="add_90" /></combine2>
    <multiply name="multiply_92" type="vector2"><input name="in1" type="vector2" nodename="combine2_91" /><input name="in2" type="vector2" value="1.7, 1.0" /></multiply>
    <add name="add_93" type="vector2"><input name="in1" type="vector2" nodename="multiply_92" /><input name="in2" type="vector2" value="5.37, 1.61" /></add>
