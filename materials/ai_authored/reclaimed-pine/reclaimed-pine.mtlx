    <clamp name="clamp_95" type="float"><input name="in" type="float" nodename="noise2d_94" /></clamp>
    <multiply name="multiply_96" type="float"><input name="in1" type="float" nodename="clamp_95" /><input name="in2" type="float" value="0.0011" /></multiply>
    <add name="add_97" type="float"><input name="in1" type="float" nodename="multiply_96" /><input name="in2" type="float" value="0.0004" /></add>
    <multiply name="multiply_98" type="float"><input name="in1" type="float" nodename="bid3" /><input name="in2" type="float" value="0.001" /></multiply>
    <add name="add_99" type="float"><input name="in1" type="float" nodename="multiply_98" /><input name="in2" type="float" value="0.0005" /></add>
    <absval name="abs_c" type="float"><input name="in" type="float" nodename="c" /></absval>
    <absval name="abs_a" type="float"><input name="in" type="float" nodename="a" /></absval>
    <subtract name="subtract_102" type="float"><input name="in1" type="float" nodename="hw" /><input name="in2" type="float" nodename="abs_c" /></subtract>
    <subtract name="d_side" type="float"><input name="in1" type="float" nodename="subtract_102" /><input name="in2" type="float" nodename="add_97" /></subtract>
    <subtract name="subtract_104" type="float"><input name="in1" type="float" nodename="hl" /><input name="in2" type="float" nodename="abs_a" /></subtract>
    <subtract name="d_end" type="float"><input name="in1" type="float" nodename="subtract_104" /><input name="in2" type="float" nodename="add_99" /></subtract>
    <min name="d_edge" type="float"><input name="in1" type="float" nodename="d_side" /><input name="in2" type="float" nodename="d_end" /></min>
    <!-- wear: traffic path ~45 cm wide, patchy -->
    <rotate2d name="rotate2d_107" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="25.0" /></rotate2d>
    <separate2 name="ruv_s" type="multioutput"><input name="in" type="vector2" nodename="rotate2d_107" /></separate2>
    <multiply name="multiply_109" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1.6" /></multiply>
    <add name="add_110" type="vector2"><input name="in1" type="vector2" nodename="multiply_109" /><input name="in2" type="vector2" value="3.3, 8.1" /></add>
    <noise2d name="noise2d_111" type="float"><input name="texcoord" type="vector2" nodename="add_110" /><input name="amplitude" type="float" value="0.12" /></noise2d>
    <add name="add_112" type="float"><input name="in1" type="float" nodename="ruv_s" output="outy" /><input name="in2" type="float" nodename="noise2d_111" /></add>
    <subtract name="subtract_113" type="float"><input name="in1" type="float" nodename="add_112" /><input name="in2" type="float" value="0.42" /></subtract>
    <absval name="absval_114" type="float"><input name="in" type="float" nodename="subtract_113" /></absval>
    <smoothstep name="smoothstep_115" type="float"><input name="in" type="float" nodename="absval_114" /><input name="low" type="float" value="0.1" /><input name="high" type="float" value="0.3" /></smoothstep>
    <subtract name="subtract_116" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_115" /></subtract>
    <multiply name="multiply_117" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="5.0" /></multiply>
    <add name="add_118" type="vector2"><input name="in1" type="vector2" nodename="multiply_117" /><input name="in2" type="vector2" value="21.7, 4.3" /></add>
    <noise2d name="noise2d_119" type="float"><input name="texcoord" type="vector2" nodename="add_118" /><input name="amplitude" type="float" value="0.8" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <clamp name="clamp_120" type="float"><input name="in" type="float" nodename="noise2d_119" /></clamp>
