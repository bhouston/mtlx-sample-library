<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Bush-hammered (tooled) architectural concrete. Texcoords are meters: UV 0..1 = 1 m. -->
  <nodegraph name="NG_bush_hammered">
    <texcoord name="uv" type="vector2" />

    <!-- Tooling intensity, ~30 cm patches: 0.7..1.3 multiplier on crater depth, slightly lighter where heavier tooled. -->
    <multiply name="uv_tool" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="3" /></multiply>
    <fractal2d name="tool_raw" type="float"><input name="texcoord" type="vector2" nodename="uv_tool" /><input name="octaves" type="integer" value="3" /><input name="amplitude" type="float" value="0.3" /></fractal2d>
    <add name="tool" type="float"><input name="in1" type="float" nodename="tool_raw" /><input name="in2" type="float" value="1" /></add>

    <!-- Broad mottling, ~20 cm blotches, 0..1. -->
    <multiply name="uv_mottle" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="5" /></multiply>
    <fractal2d name="mottle_raw" type="float"><input name="texcoord" type="vector2" nodename="uv_mottle" /><input name="octaves" type="integer" value="4" /><input name="amplitude" type="float" value="0.5" /></fractal2d>
    <add name="mottle" type="float"><input name="in1" type="float" nodename="mottle_raw" /><input name="in2" type="float" value="0.5" /></add>

    <!-- Domain warp, ~1 cm wavelength, 1.5 mm amplitude: breaks up round worley shapes. -->
    <multiply name="uv_warp" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="90" /></multiply>
    <noise2d name="warp" type="vector2"><input name="texcoord" type="vector2" nodename="uv_warp" /><input name="amplitude" type="vector2" value="0.0015, 0.0015" /></noise2d>
    <add name="uvw" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" nodename="warp" /></add>

    <!-- Crater layer A: 140 cells/m (~7 mm). Chip = sqrt(cone) (steep walls, flat floor) over a flat per-chip random depth. -->
    <multiply name="uv_a" type="vector2"><input name="in1" type="vector2" nodename="uvw" /><input name="in2" type="float" value="140" /></multiply>
    <worleynoise2d name="fa2" type="vector2"><input name="texcoord" type="vector2" nodename="uv_a" /></worleynoise2d>
    <separate2 name="fas" type="multioutput"><input name="in" type="vector2" nodename="fa2" /></separate2>
    <worleynoise2d name="ra" type="float"><input name="texcoord" type="vector2" nodename="uv_a" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <divide name="fa_n" type="float"><input name="in1" type="float" nodename="fas" output="outx" /><input name="in2" type="float" value="0.6" /></divide>
    <subtract name="ca_lin" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="fa_n" /></subtract>
    <max name="ca_p" type="float"><input name="in1" type="float" nodename="ca_lin" /><input name="in2" type="float" value="0" /></max>
    <power name="ca" type="float"><input name="in1" type="float" nodename="ca_p" /><input name="in2" type="float" value="0.5" /></power>
    <mix name="pa" type="float"><input name="bg" type="float" value="1" /><input name="fg" type="float" nodename="ca" /><input name="mix" type="float" value="0.85" /></mix>
    <multiply name="ra_s" type="float"><input name="in1" type="float" nodename="ra" /><input name="in2" type="float" value="0.7" /></multiply>
    <add name="ra_d" type="float"><input name="in1" type="float" nodename="ra_s" /><input name="in2" type="float" value="0.3" /></add>
    <subtract name="ea" type="float"><input name="in1" type="float" nodename="fas" output="outy" /><input name="in2" type="float" nodename="fas" output="outx" /></subtract>
    <smoothstep name="wa" type="float"><input name="in" type="float" nodename="ea" /><input name="low" type="float" value="0" /><input name="high" type="float" value="0.12" /></smoothstep>
    <multiply name="qa" type="float"><input name="in1" type="float" nodename="pa" /><input name="in2" type="float" nodename="wa" /></multiply>
    <multiply name="da" type="float"><input name="in1" type="float" nodename="qa" /><input name="in2" type="float" nodename="ra_d" /></multiply>

    <!-- Crater layer B: 210 cells/m (~5 mm), rotated and offset grid. -->
    <rotate2d name="uvw_rot" type="vector2"><input name="in" type="vector2" nodename="uvw" /><input name="amount" type="float" value="37" /></rotate2d>
    <multiply name="uv_b0" type="vector2"><input name="in1" type="vector2" nodename="uvw_rot" /><input name="in2" type="float" value="210" /></multiply>
    <add name="uv_b" type="vector2"><input name="in1" type="vector2" nodename="uv_b0" /><input name="in2" type="vector2" value="0.37, 0.61" /></add>
    <worleynoise2d name="fb2" type="vector2"><input name="texcoord" type="vector2" nodename="uv_b" /></worleynoise2d>
    <separate2 name="fbs" type="multioutput"><input name="in" type="vector2" nodename="fb2" /></separate2>
    <worleynoise2d name="rb" type="float"><input name="texcoord" type="vector2" nodename="uv_b" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <divide name="fb_n" type="float"><input name="in1" type="float" nodename="fbs" output="outx" /><input name="in2" type="float" value="0.6" /></divide>
    <subtract name="cb_lin" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="fb_n" /></subtract>
    <max name="cb_p" type="float"><input name="in1" type="float" nodename="cb_lin" /><input name="in2" type="float" value="0" /></max>
    <power name="cb" type="float"><input name="in1" type="float" nodename="cb_p" /><input name="in2" type="float" value="0.5" /></power>
    <mix name="pb" type="float"><input name="bg" type="float" value="1" /><input name="fg" type="float" nodename="cb" /><input name="mix" type="float" value="0.85" /></mix>
    <multiply name="rb_s" type="float"><input name="in1" type="float" nodename="rb" /><input name="in2" type="float" value="0.7" /></multiply>
    <add name="rb_d" type="float"><input name="in1" type="float" nodename="rb_s" /><input name="in2" type="float" value="0.3" /></add>
    <subtract name="eb" type="float"><input name="in1" type="float" nodename="fbs" output="outy" /><input name="in2" type="float" nodename="fbs" output="outx" /></subtract>
    <smoothstep name="wb" type="float"><input name="in" type="float" nodename="eb" /><input name="low" type="float" value="0" /><input name="high" type="float" value="0.12" /></smoothstep>
    <multiply name="qb" type="float"><input name="in1" type="float" nodename="pb" /><input name="in2" type="float" nodename="wb" /></multiply>
    <multiply name="db" type="float"><input name="in1" type="float" nodename="qb" /><input name="in2" type="float" nodename="rb_d" /></multiply>
    <!-- Crater layer C: 300 cells/m (~3.3 mm) small shallow chips (depth 0.2..0.6). -->
    <rotate2d name="uvw_rotc" type="vector2"><input name="in" type="vector2" nodename="uvw" /><input name="amount" type="float" value="-58" /></rotate2d>
    <multiply name="uv_c0" type="vector2"><input name="in1" type="vector2" nodename="uvw_rotc" /><input name="in2" type="float" value="300" /></multiply>
    <add name="uv_c" type="vector2"><input name="in1" type="vector2" nodename="uv_c0" /><input name="in2" type="vector2" value="0.83, 0.17" /></add>
    <worleynoise2d name="fc2" type="vector2"><input name="texcoord" type="vector2" nodename="uv_c" /></worleynoise2d>
    <separate2 name="fcs" type="multioutput"><input name="in" type="vector2" nodename="fc2" /></separate2>
    <worleynoise2d name="rc" type="float"><input name="texcoord" type="vector2" nodename="uv_c" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <divide name="fc_n" type="float"><input name="in1" type="float" nodename="fcs" output="outx" /><input name="in2" type="float" value="0.6" /></divide>
    <subtract name="cc_lin" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="fc_n" /></subtract>
    <max name="cc_p" type="float"><input name="in1" type="float" nodename="cc_lin" /><input name="in2" type="float" value="0" /></max>
    <power name="cc" type="float"><input name="in1" type="float" nodename="cc_p" /><input name="in2" type="float" value="0.5" /></power>
    <mix name="pc" type="float"><input name="bg" type="float" value="1" /><input name="fg" type="float" nodename="cc" /><input name="mix" type="float" value="0.85" /></mix>
    <multiply name="rc_s" type="float"><input name="in1" type="float" nodename="rc" /><input name="in2" type="float" value="0.4" /></multiply>
    <add name="rc_d" type="float"><input name="in1" type="float" nodename="rc_s" /><input name="in2" type="float" value="0.2" /></add>
    <subtract name="ec" type="float"><input name="in1" type="float" nodename="fcs" output="outy" /><input name="in2" type="float" nodename="fcs" output="outx" /></subtract>
    <smoothstep name="wc" type="float"><input name="in" type="float" nodename="ec" /><input name="low" type="float" value="0" /><input name="high" type="float" value="0.12" /></smoothstep>
    <multiply name="qc" type="float"><input name="in1" type="float" nodename="pc" /><input name="in2" type="float" nodename="wc" /></multiply>
    <multiply name="dc" type="float"><input name="in1" type="float" nodename="qc" /><input name="in2" type="float" nodename="rc_d" /></multiply>

    <!-- Union of chips: deepest wins, so neighbouring cones meet in straight, sharp ridges. 0..1. -->
    <max name="crater_ab" type="float"><input name="in1" type="float" nodename="da" /><input name="in2" type="float" nodename="db" /></max>
    <max name="crater" type="float"><input name="in1" type="float" nodename="crater_ab" /><input name="in2" type="float" nodename="dc" /></max>

    <!-- Fine fracture grain, ~1 mm. -->
    <multiply name="uv_grain" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1200" /></multiply>
    <fractal2d name="grain" type="float"><input name="texcoord" type="vector2" nodename="uv_grain" /><input name="octaves" type="integer" value="3" /></fractal2d>

    <!-- Aggregate: Voronoi cells inset by F2-F1 give angular, straight-edged crushed stone.
         Coarse 48 cells/m (~21 mm, stones 8-18 mm), fine 130 cells/m (~8 mm, stones 3-6 mm). -->
    <rotate2d name="uv_acr" type="vector2"><input name="in" type="vector2" nodename="uvw" /><input name="amount" type="float" value="-21" /></rotate2d>
    <multiply name="uv_ac0" type="vector2"><input name="in1" type="vector2" nodename="uv_acr" /><input name="in2" type="float" value="48" /></multiply>
    <add name="uv_ac" type="vector2"><input name="in1" type="vector2" nodename="uv_ac0" /><input name="in2" type="vector2" value="0.13, 0.71" /></add>
    <worleynoise2d name="ac_f" type="vector2"><input name="texcoord" type="vector2" nodename="uv_ac" /><input name="jitter" type="float" value="0.9" /></worleynoise2d>
    <separate2 name="ac_fs" type="multioutput"><input name="in" type="vector2" nodename="ac_f" /></separate2>
    <subtract name="ac_e" type="float"><input name="in1" type="float" nodename="ac_fs" output="outy" /><input name="in2" type="float" nodename="ac_fs" output="outx" /></subtract>
    <worleynoise2d name="ac_r" type="float"><input name="texcoord" type="vector2" nodename="uv_ac" /><input name="style" type="integer" value="1" /><input name="jitter" type="float" value="0.9" /></worleynoise2d>
    <!-- per-stone inset threshold: larger random = smaller stone; random above 0.45 = no stone. -->
    <multiply name="ac_t0" type="float"><input name="in1" type="float" nodename="ac_r" /><input name="in2" type="float" value="0.3" /></multiply>
    <add name="ac_t" type="float"><input name="in1" type="float" nodename="ac_t0" /><input name="in2" type="float" value="0.1" /></add>
    <subtract name="ac_d" type="float"><input name="in1" type="float" nodename="ac_e" /><input name="in2" type="float" nodename="ac_t" /></subtract>
    <smoothstep name="ac_m0" type="float"><input name="in" type="float" nodename="ac_d" /><input name="low" type="float" value="0" /><input name="high" type="float" value="0.04" /></smoothstep>
    <ifgreater name="ac_on" type="float"><input name="value1" type="float" value="0.45" /><input name="value2" type="float" nodename="ac_r" /><input name="in1" type="float" value="1" /><input name="in2" type="float" value="0" /></ifgreater>
    <multiply name="ac_m" type="float"><input name="in1" type="float" nodename="ac_m0" /><input name="in2" type="float" nodename="ac_on" /></multiply>
    <rotate2d name="uv_afr" type="vector2"><input name="in" type="vector2" nodename="uvw" /><input name="amount" type="float" value="64" /></rotate2d>
    <multiply name="uv_af0" type="vector2"><input name="in1" type="vector2" nodename="uv_afr" /><input name="in2" type="float" value="130" /></multiply>
    <add name="uv_af" type="vector2"><input name="in1" type="vector2" nodename="uv_af0" /><input name="in2" type="vector2" value="0.52, 0.29" /></add>
    <worleynoise2d name="af_f" type="vector2"><input name="texcoord" type="vector2" nodename="uv_af" /><input name="jitter" type="float" value="0.9" /></worleynoise2d>
    <separate2 name="af_fs" type="multioutput"><input name="in" type="vector2" nodename="af_f" /></separate2>
    <subtract name="af_e" type="float"><input name="in1" type="float" nodename="af_fs" output="outy" /><input name="in2" type="float" nodename="af_fs" output="outx" /></subtract>
    <worleynoise2d name="af_r" type="float"><input name="texcoord" type="vector2" nodename="uv_af" /><input name="style" type="integer" value="1" /><input name="jitter" type="float" value="0.9" /></worleynoise2d>
    <!-- per-stone inset threshold: larger random = smaller stone; random above 0.4 = no stone. -->
    <multiply name="af_t0" type="float"><input name="in1" type="float" nodename="af_r" /><input name="in2" type="float" value="0.3" /></multiply>
    <add name="af_t" type="float"><input name="in1" type="float" nodename="af_t0" /><input name="in2" type="float" value="0.1" /></add>
    <subtract name="af_d" type="float"><input name="in1" type="float" nodename="af_e" /><input name="in2" type="float" nodename="af_t" /></subtract>
    <smoothstep name="af_m0" type="float"><input name="in" type="float" nodename="af_d" /><input name="low" type="float" value="0" /><input name="high" type="float" value="0.04" /></smoothstep>
    <ifgreater name="af_on" type="float"><input name="value1" type="float" value="0.4" /><input name="value2" type="float" nodename="af_r" /><input name="in1" type="float" value="1" /><input name="in2" type="float" value="0" /></ifgreater>
    <multiply name="af_m" type="float"><input name="in1" type="float" nodename="af_m0" /><input name="in2" type="float" nodename="af_on" /></multiply>
    <max name="agg" type="float"><input name="in1" type="float" nodename="ac_m" /><input name="in2" type="float" nodename="af_m" /></max>
    <!-- stone id: coarse stone random where coarse stone, else fine. -->
    <mix name="ragg" type="float"><input name="bg" type="float" nodename="af_r" /><input name="fg" type="float" nodename="ac_r" /><input name="mix" type="float" nodename="ac_m" /></mix>

    <!-- Height in meters: 2.8 mm max chip depth (35% shallower on hard stone) x tooling, 0.12 mm grain. -->
    <multiply name="agg_soft" type="float"><input name="in1" type="float" nodename="agg" /><input name="in2" type="float" value="-0.35" /></multiply>
    <add name="agg_k" type="float"><input name="in1" type="float" nodename="agg_soft" /><input name="in2" type="float" value="1" /></add>
    <multiply name="crater_k" type="float"><input name="in1" type="float" nodename="crater" /><input name="in2" type="float" nodename="agg_k" /></multiply>
    <multiply name="crater_t" type="float"><input name="in1" type="float" nodename="crater_k" /><input name="in2" type="float" nodename="tool" /></multiply>
    <multiply name="h_crater" type="float"><input name="in1" type="float" nodename="crater_t" /><input name="in2" type="float" value="-0.0028" /></multiply>
    <multiply name="h_grain" type="float"><input name="in1" type="float" nodename="grain" /><input name="in2" type="float" value="0.00012" /></multiply>
    <add name="height" type="float"><input name="in1" type="float" nodename="h_crater" /><input name="in2" type="float" nodename="h_grain" /></add>
    <!-- scale 16 cancels heighttonormal's 1/16 Sobel factor; mm inputs avoid three.js degenerate-normal check. -->
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>

    <!-- Paste: light crushed cement, brighter in fresh crater floors. -->
    <mix name="col_paste0" type="color3"><input name="bg" type="color3" value="0.40, 0.395, 0.38" /><input name="fg" type="color3" value="0.48, 0.475, 0.46" /><input name="mix" type="float" nodename="mottle" /></mix>
    <multiply name="crater_tint" type="float"><input name="in1" type="float" nodename="crater" /><input name="in2" type="float" value="0.15" /></multiply>
    <multiply name="grain_tint" type="float"><input name="in1" type="float" nodename="grain" /><input name="in2" type="float" value="0.15" /></multiply>
    <add name="paste_f0" type="float"><input name="in1" type="float" nodename="crater_tint" /><input name="in2" type="float" nodename="grain_tint" /></add>
    <multiply name="tool_tint" type="float"><input name="in1" type="float" nodename="tool_raw" /><input name="in2" type="float" value="0.3" /></multiply>
    <add name="paste_f1" type="float"><input name="in1" type="float" nodename="paste_f0" /><input name="in2" type="float" nodename="tool_tint" /></add>
    <add name="paste_f" type="float"><input name="in1" type="float" nodename="paste_f1" /><input name="in2" type="float" value="0.95" /></add>
    <multiply name="col_paste" type="color3"><input name="in1" type="color3" nodename="col_paste0" /><input name="in2" type="float" nodename="paste_f" /></multiply>

    <!-- Stone palette from hashed per-stone random (decorrelated from stone size): dark basalt 15%, grey limestone 40%,
         beige 30%, light quartzite 15%, each stone's brightness varied +-20%. -->
    <multiply name="pal0" type="float"><input name="in1" type="float" nodename="ragg" /><input name="in2" type="float" value="13.7" /></multiply>
    <modulo name="pal" type="float"><input name="in1" type="float" nodename="pal0" /><input name="in2" type="float" value="1" /></modulo>
    <multiply name="bri0" type="float"><input name="in1" type="float" nodename="ragg" /><input name="in2" type="float" value="31.3" /></multiply>
    <modulo name="bri1" type="float"><input name="in1" type="float" nodename="bri0" /><input name="in2" type="float" value="1" /></modulo>
    <multiply name="bri2" type="float"><input name="in1" type="float" nodename="bri1" /><input name="in2" type="float" value="0.4" /></multiply>
    <add name="bri" type="float"><input name="in1" type="float" nodename="bri2" /><input name="in2" type="float" value="0.8" /></add>
    <smoothstep name="s1" type="float"><input name="in" type="float" nodename="pal" /><input name="low" type="float" value="0.15" /><input name="high" type="float" value="0.16" /></smoothstep>
    <smoothstep name="s2" type="float"><input name="in" type="float" nodename="pal" /><input name="low" type="float" value="0.55" /><input name="high" type="float" value="0.56" /></smoothstep>
    <smoothstep name="s3" type="float"><input name="in" type="float" nodename="pal" /><input name="low" type="float" value="0.85" /><input name="high" type="float" value="0.86" /></smoothstep>
    <mix name="stone_a" type="color3"><input name="bg" type="color3" value="0.10, 0.10, 0.105" /><input name="fg" type="color3" value="0.30, 0.30, 0.29" /><input name="mix" type="float" nodename="s1" /></mix>
    <mix name="stone_b" type="color3"><input name="bg" type="color3" nodename="stone_a" /><input name="fg" type="color3" value="0.40, 0.36, 0.31" /><input name="mix" type="float" nodename="s2" /></mix>
    <mix name="stone_c" type="color3"><input name="bg" type="color3" nodename="stone_b" /><input name="fg" type="color3" value="0.55, 0.54, 0.51" /><input name="mix" type="float" nodename="s3" /></mix>
    <multiply name="stone_c2" type="color3"><input name="in1" type="color3" nodename="stone_c" /><input name="in2" type="float" nodename="bri" /></multiply>
    <multiply name="stone_col" type="color3"><input name="in1" type="color3" nodename="stone_c2" /><input name="in2" type="float" nodename="paste_f" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" nodename="col_paste" /><input name="fg" type="color3" nodename="stone_col" /><input name="mix" type="float" nodename="agg" /></mix>

    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>

    <!-- Roughness: paste 0.9, rougher crater floors, fresh stone faces 0.68. -->
    <multiply name="rough_cr" type="float"><input name="in1" type="float" nodename="crater" /><input name="in2" type="float" value="0.05" /></multiply>
    <add name="rough_paste" type="float"><input name="in1" type="float" nodename="rough_cr" /><input name="in2" type="float" value="0.88" /></add>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="rough_paste" /><input name="fg" type="float" value="0.68" /><input name="mix" type="float" nodename="agg" /></mix>

    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_bush_hammered" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" nodegraph="NG_bush_hammered" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_bush_hammered" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_bush_hammered" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_bush_hammered" output="normal_out" />
  </standard_surface>
