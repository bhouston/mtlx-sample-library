    <multiply name="multiply_47" type="float"><input name="in1" type="float" nodename="k_id" /><input name="in2" type="float" value="29.3" /></multiply>
    <add name="add_48" type="float"><input name="in1" type="float" nodename="multiply_47" /><input name="in2" type="float" value="0.3" /></add>
    <fract name="fract_49" type="float"><input name="in" type="float" nodename="add_48" /></fract>
    <ifgreater name="ifgreater_50" type="float"><input name="value1" type="float" nodename="fract_49" /><input name="value2" type="float" value="0.5" /><input name="in1" type="float" value="-0.0235" /><input name="in2" type="float" value="0.019" /></ifgreater>
    <multiply name="multiply_51" type="float"><input name="in1" type="float" nodename="k_id" /><input name="in2" type="float" value="7.1" /></multiply>
    <add name="add_52" type="float"><input name="in1" type="float" nodename="multiply_51" /><input name="in2" type="float" value="0.7" /></add>
    <fract name="fract_53" type="float"><input name="in" type="float" nodename="add_52" /></fract>
    <multiply name="multiply_54" type="float"><input name="in1" type="float" nodename="fract_53" /><input name="in2" type="float" value="0.01" /></multiply>
    <add name="add_55" type="float"><input name="in1" type="float" nodename="multiply_54" /><input name="in2" type="float" value="-0.005" /></add>
    <add name="k_c" type="float"><input name="in1" type="float" nodename="ifgreater_50" /><input name="in2" type="float" nodename="add_55" /></add>
    <multiply name="multiply_57" type="float"><input name="in1" type="float" nodename="k_id" /><input name="in2" type="float" value="41.9" /></multiply>
    <add name="add_58" type="float"><input name="in1" type="float" nodename="multiply_57" /><input name="in2" type="float" value="0.5" /></add>
    <fract name="fract_59" type="float"><input name="in" type="float" nodename="add_58" /></fract>
    <multiply name="multiply_60" type="float"><input name="in1" type="float" nodename="fract_59" /><input name="in2" type="float" value="0.004" /></multiply>
    <add name="add_61" type="float"><input name="in1" type="float" nodename="multiply_60" /><input name="in2" type="float" value="0.004" /></add>
