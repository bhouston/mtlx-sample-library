    <subtract name="subtract_63" type="float"><input name="in1" type="float" nodename="b_c" /><input name="in2" type="float" nodename="k_c" /></subtract>
    <subtract name="subtract_64" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" nodename="k_v" /></subtract>
    <combine2 name="k_q" type="vector2"><input name="in1" type="float" nodename="subtract_63" /><input name="in2" type="float" nodename="subtract_64" /></combine2>
    <separate2 name="k_qs" type="multioutput"><input name="in" type="vector2" nodename="k_q" /></separate2>
