    <multiply name="multiply_69" type="float"><input name="in1" type="float" nodename="k_rho" /><input name="in2" type="float" nodename="k_rho" /></multiply>
    <add name="add_70" type="float"><input name="in1" type="float" nodename="multiply_69" /><input name="in2" type="float" nodename="k_r2" /></add>
    <divide name="k_lor" type="float"><input name="in1" type="float" nodename="k_r2" /><input name="in2" type="float" nodename="add_70" /></divide>
    <multiply name="multiply_72" type="float"><input name="in1" type="float" nodename="add_61" /><input name="in2" type="float" value="0.8" /></multiply>
    <multiply name="multiply_73" type="float"><input name="in1" type="float" nodename="add_61" /><input name="in2" type="float" value="1.15" /></multiply>
    <smoothstep name="smoothstep_74" type="float"><input name="in" type="float" nodename="k_rho" /><input name="low" type="float" nodename="multiply_72" /><input name="high" type="float" nodename="multiply_73" /></smoothstep>
    <subtract name="k_core" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_74" /></subtract>
    <multiply name="multiply_76" type="float"><input name="in1" type="float" nodename="k_lor" /><input name="in2" type="float" value="8e-05" /></multiply>
    <multiply name="multiply_77" type="float"><input name="in1" type="float" nodename="k_core" /><input name="in2" type="float" value="5e-05" /></multiply>
    <add name="add_78" type="float"><input name="in1" type="float" nodename="multiply_76" /><input name="in2" type="float" nodename="multiply_77" /></add>
    <multiply name="h_knot" type="float"><input name="in1" type="float" nodename="k_on" /><input name="in2" type="float" nodename="add_78" /></multiply>
    <multiply name="multiply_80" type="vector2"><input name="in1" type="vector2" nodename="k_q" /><input name="in2" type="vector2" value="1.0, 0.4" /></multiply>
    <magnitude name="magnitude_81" type="float"><input name="in" type="vector2" nodename="multiply_80" /></magnitude>
    <multiply name="multiply_82" type="float"><input name="in1" type="float" nodename="k_r2" /><input name="in2" type="float" value="1.6" /></multiply>
    <multiply name="multiply_83" type="float"><input name="in1" type="float" nodename="magnitude_81" /><input name="in2" type="float" nodename="magnitude_81" /></multiply>
    <add name="add_84" type="float"><input name="in1" type="float" nodename="multiply_83" /><input name="in2" type="float" nodename="k_r2" /></add>
    <divide name="divide_85" type="float"><input name="in1" type="float" nodename="multiply_82" /><input name="in2" type="float" nodename="add_84" /></divide>
    <multiply name="k_def" type="float"><input name="in1" type="float" nodename="k_on" /><input name="in2" type="float" nodename="divide_85" /></multiply>
    <multiply name="multiply_87" type="float"><input name="in1" type="float" nodename="k_qs" output="outx" /><input name="in2" type="float" nodename="k_def" /></multiply>
    <subtract name="b_cd" type="float"><input name="in1" type="float" nodename="b_c" /><input name="in2" type="float" nodename="multiply_87" /></subtract>
    <smoothstep name="smoothstep_89" type="float"><input name="in" type="float" nodename="bid2" /><input name="low" type="float" value="0.64" /><input name="high" type="float" value="0.74" /></smoothstep>
    <multiply name="multiply_90" type="float"><input name="in1" type="float" nodename="bid6" /><input name="in2" type="float" value="0.4" /></multiply>
    <add name="add_91" type="float"><input name="in1" type="float" nodename="multiply_90" /><input name="in2" type="float" value="0.6" /></add>
    <!-- grain: rings 4..7 mm, latewood raised 20 um on some boards -->
    <multiply name="g_on" type="float"><input name="in1" type="float" nodename="smoothstep_89" /><input name="in2" type="float" nodename="add_91" /></multiply>
