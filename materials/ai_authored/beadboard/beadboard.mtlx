    <multiply name="multiply_39" type="float"><input name="in1" type="float" nodename="k_id" /><input name="in2" type="float" value="13.7" /></multiply>
    <add name="add_40" type="float"><input name="in1" type="float" nodename="multiply_39" /><input name="in2" type="float" value="0.1" /></add>
    <fract name="fract_41" type="float"><input name="in" type="float" nodename="add_40" /></fract>
    <multiply name="multiply_42" type="float"><input name="in1" type="float" nodename="fract_41" /><input name="in2" type="float" value="0.5" /></multiply>
