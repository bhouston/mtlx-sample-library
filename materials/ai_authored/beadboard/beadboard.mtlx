<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- beadboard: painted tongue-and-groove beadboard, 90 mm boards along V, bead every 45 mm. UV 0..1 = 1 m, heights in m -->
  <nodegraph name="NG_beadboard">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- boards: 90 mm along U, running along V -->
    <divide name="b_u" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="0.09" /></divide>
    <floor name="b_m" type="float"><input name="in" type="float" nodename="b_u" /></floor>
    <subtract name="subtract_5" type="float"><input name="in1" type="float" nodename="b_u" /><input name="in2" type="float" nodename="b_m" /></subtract>
    <multiply name="b_x" type="float"><input name="in1" type="float" nodename="subtract_5" /><input name="in2" type="float" value="0.09" /></multiply>
    <subtract name="b_c" type="float"><input name="in1" type="float" nodename="b_x" /><input name="in2" type="float" value="0.045" /></subtract>
    <combine2 name="combine2_8" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" value="7.0" /></combine2>
    <add name="add_9" type="vector2"><input name="in1" type="vector2" nodename="combine2_8" /><input name="in2" type="vector2" value="200.37, 300.61" /></add>
    <cellnoise2d name="bid0" type="float"><input name="texcoord" type="vector2" nodename="add_9" /></cellnoise2d>
    <combine2 name="combine2_11" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" value="7.0" /></combine2>
    <add name="add_12" type="vector2"><input name="in1" type="vector2" nodename="combine2_11" /><input name="in2" type="vector2" value="213.37, 307.61" /></add>
    <cellnoise2d name="bid1" type="float"><input name="texcoord" type="vector2" nodename="add_12" /></cellnoise2d>
    <combine2 name="combine2_14" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" value="7.0" /></combine2>
    <add name="add_15" type="vector2"><input name="in1" type="vector2" nodename="combine2_14" /><input name="in2" type="vector2" value="226.37, 314.61" /></add>
    <cellnoise2d name="bid2" type="float"><input name="texcoord" type="vector2" nodename="add_15" /></cellnoise2d>
    <combine2 name="combine2_17" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" value="7.0" /></combine2>
    <add name="add_18" type="vector2"><input name="in1" type="vector2" nodename="combine2_17" /><input name="in2" type="vector2" value="239.37, 321.61" /></add>
    <cellnoise2d name="bid3" type="float"><input name="texcoord" type="vector2" nodename="add_18" /></cellnoise2d>
    <combine2 name="combine2_20" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" value="7.0" /></combine2>
    <add name="add_21" type="vector2"><input name="in1" type="vector2" nodename="combine2_20" /><input name="in2" type="vector2" value="252.37, 328.61" /></add>
    <cellnoise2d name="bid4" type="float"><input name="texcoord" type="vector2" nodename="add_21" /></cellnoise2d>
    <combine2 name="combine2_23" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" value="7.0" /></combine2>
    <add name="add_24" type="vector2"><input name="in1" type="vector2" nodename="combine2_23" /><input name="in2" type="vector2" value="265.37, 335.61" /></add>
    <cellnoise2d name="bid5" type="float"><input name="texcoord" type="vector2" nodename="add_24" /></cellnoise2d>
    <combine2 name="combine2_26" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" value="7.0" /></combine2>
    <add name="add_27" type="vector2"><input name="in1" type="vector2" nodename="combine2_26" /><input name="in2" type="vector2" value="278.37, 342.61" /></add>
    <cellnoise2d name="bid6" type="float"><input name="texcoord" type="vector2" nodename="add_27" /></cellnoise2d>
    <combine2 name="combine2_29" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" value="7.0" /></combine2>
    <add name="add_30" type="vector2"><input name="in1" type="vector2" nodename="combine2_29" /><input name="in2" type="vector2" value="291.37, 349.61" /></add>
