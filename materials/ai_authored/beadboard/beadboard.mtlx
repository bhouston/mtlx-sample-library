    <divide name="divide_32" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="0.7" /></divide>
    <!-- knots: telegraphing through the paint -->
    <add name="k_sv" type="float"><input name="in1" type="float" nodename="divide_32" /><input name="in2" type="float" nodename="bid7" /></add>
    <floor name="k_j" type="float"><input name="in" type="float" nodename="k_sv" /></floor>
    <combine2 name="combine2_35" type="vector2"><input name="in1" type="float" nodename="b_m" /><input name="in2" type="float" nodename="k_j" /></combine2>
    <add name="add_36" type="vector2"><input name="in1" type="vector2" nodename="combine2_35" /><input name="in2" type="vector2" value="61.37, 17.93" /></add>
