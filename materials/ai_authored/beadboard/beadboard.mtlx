    <input name="base_color" type="color3" nodegraph="NG_beadboard" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_beadboard" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_beadboard" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_beadboard" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_beadboard" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_beadboard" /></surfacematerial>
</materialx>

