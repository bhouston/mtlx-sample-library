    <mix name="pith_dist" type="float"><input name="bg" type="float" nodename="multiply_44" /><input name="fg" type="float" nodename="add_46" /><input name="mix" type="float" nodename="pith_far" /></mix>
    <multiply name="multiply_48" type="float"><input name="in1" type="float" nodename="id_ang" /><input name="in2" type="float" value="360.0" /></multiply>
    <rotate2d name="pith_dir" type="vector2"><input name="in" type="vector2" value="1.0, 0.0" /><input name="amount" type="float" nodename="multiply_48" /></rotate2d>
    <multiply name="pith" type="vector2"><input name="in1" type="vector2" nodename="pith_dir" /><input name="in2" type="float" nodename="pith_dist" /></multiply>
    <subtract name="rel" type="vector2"><input name="in1" type="vector2" nodename="rg_loc" /><input name="in2" type="vector2" nodename="pith" /></subtract>
    <combine2 name="combine2_52" type="vector2"><input name="in1" type="float" nodename="id_tone" /><input name="in2" type="float" nodename="id_hue" /></combine2>
    <multiply name="blk_seed" type="vector2"><input name="in1" type="vector2" nodename="combine2_52" /><input name="in2" type="vector2" value="97.0, 61.0" /></multiply>
    <multiply name="multiply_54" type="vector2"><input name="in1" type="vector2" nodename="rel" /><input name="in2" type="float" value="8.0" /></multiply>
    <add name="add_55" type="vector2"><input name="in1" type="vector2" nodename="multiply_54" /><input name="in2" type="vector2" nodename="blk_seed" /></add>
    <noise2d name="ring_wa" type="vector3"><input name="texcoord" type="vector2" nodename="add_55" /><input name="amplitude" type="vector3" value="0.003, 0.003, 0.0" /></noise2d>
    <multiply name="multiply_57" type="vector2"><input name="in1" type="vector2" nodename="rel" /><input name="in2" type="float" value="40.0" /></multiply>
    <add name="add_58" type="vector2"><input name="in1" type="vector2" nodename="multiply_57" /><input name="in2" type="vector2" nodename="blk_seed" /></add>
    <fractal2d name="ring_wb" type="vector3"><input name="texcoord" type="vector2" nodename="add_58" /><input name="octaves" type="integer" value="2" /><input name="amplitude" type="vector3" value="0.0008, 0.0008, 0.0" /></fractal2d>
    <convert name="convert_60" type="vector2"><input name="in" type="vector3" nodename="ring_wa" /></convert>
    <convert name="convert_61" type="vector2"><input name="in" type="vector3" nodename="ring_wb" /></convert>
    <add name="add_62" type="vector2"><input name="in1" type="vector2" nodename="convert_60" /><input name="in2" type="vector2" nodename="convert_61" /></add>
    <add name="rel_w" type="vector2"><input name="in1" type="vector2" nodename="rel" /><input name="in2" type="vector2" nodename="add_62" /></add>
    <magnitude name="rad" type="float"><input name="in" type="vector2" nodename="rel_w" /></magnitude>
    <multiply name="multiply_65" type="float"><input name="in1" type="float" nodename="id_sp" /><input name="in2" type="float" nodename="id_sp" /></multiply>
    <multiply name="multiply_66" type="float"><input name="in1" type="float" nodename="multiply_65" /><input name="in2" type="float" value="0.0043" /></multiply>
    <add name="ring_sp" type="float"><input name="in1" type="float" nodename="multiply_66" /><input name="in2" type="float" value="0.0012" /></add>
