    <smoothstep name="smoothstep_83" type="float"><input name="in" type="float" nodename="ring_f" /><input name="low" type="float" nodename="lw0" /><input name="high" type="float" nodename="add_82" /></smoothstep>
    <smoothstep name="smoothstep_84" type="float"><input name="in" type="float" nodename="ring_f" /><input name="low" type="float" value="0.93" /><input name="high" type="float" value="1.0" /></smoothstep>
    <subtract name="subtract_85" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_84" /></subtract>
