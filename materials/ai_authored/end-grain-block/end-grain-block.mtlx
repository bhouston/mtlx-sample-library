    <multiply name="multiply_145" type="float"><input name="in1" type="float" nodename="multiply_144" /><input name="in2" type="float" value="0.00035" /></multiply>
    <max name="chk_w" type="float"><input name="in1" type="float" nodename="multiply_145" /><input name="in2" type="float" value="1e-05" /></max>
    <smoothstep name="smoothstep_147" type="float"><input name="in" type="float" nodename="chk_dp" /><input name="low" type="float" value="0.0" /><input name="high" type="float" nodename="chk_w" /></smoothstep>
    <subtract name="subtract_148" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_147" /></subtract>
    <smoothstep name="smoothstep_149" type="float"><input name="in" type="float" nodename="chk_w" /><input name="low" type="float" value="2e-05" /><input name="high" type="float" value="6e-05" /></smoothstep>
    <multiply name="check" type="float"><input name="in1" type="float" nodename="subtract_148" /><input name="in2" type="float" nodename="smoothstep_149" /></multiply>
    <!-- pores (earlywood vessels) -->
    <multiply name="pore_p" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="2500.0" /></multiply>
    <worleynoise2d name="pore_f1" type="float"><input name="texcoord" type="vector2" nodename="pore_p" /><input name="jitter" type="float" value="0.85" /></worleynoise2d>
    <multiply name="multiply_153" type="float"><input name="in1" type="float" nodename="earlywood" /><input name="in2" type="float" value="0.24" /></multiply>
    <add name="pore_r" type="float"><input name="in1" type="float" nodename="multiply_153" /><input name="in2" type="float" value="0.05" /></add>
    <multiply name="multiply_155" type="float"><input name="in1" type="float" nodename="pore_r" /><input name="in2" type="float" value="0.5" /></multiply>
    <smoothstep name="smoothstep_156" type="float"><input name="in" type="float" nodename="pore_f1" /><input name="low" type="float" nodename="multiply_155" /><input name="high" type="float" nodename="pore_r" /></smoothstep>
    <subtract name="pore" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_156" /></subtract>
    <smoothstep name="tile" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="-0.0001" /><input name="high" type="float" value="0.0001" /></smoothstep>
    <smoothstep name="ease" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="-0.0005" /><input name="high" type="float" value="0.0011" /></smoothstep>
    <smoothstep name="smoothstep_160" type="float"><input name="in" type="float" nodename="d_edge" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.004" /></smoothstep>
    <subtract name="grime_edge" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_160" /></subtract>
    <multiply name="multiply_162" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="2.2" /></multiply>
    <add name="add_163" type="vector2"><input name="in1" type="vector2" nodename="multiply_162" /><input name="in2" type="vector2" value="5.3, 2.9" /></add>
    <fractal2d name="fractal2d_164" type="float"><input name="texcoord" type="vector2" nodename="add_163" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <multiply name="multiply_165" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="3.0" /></multiply>
    <add name="add_166" type="vector2"><input name="in1" type="vector2" nodename="multiply_165" /><input name="in2" type="vector2" value="17.3, 41.9" /></add>
    <fractal2d name="fractal2d_167" type="float"><input name="texcoord" type="vector2" nodename="add_166" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="4" /></fractal2d>
    <smoothstep name="wear" type="float"><input name="in" type="float" nodename="fractal2d_167" /><input name="low" type="float" value="0.05" /><input name="high" type="float" value="0.45" /></smoothstep>
    <multiply name="multiply_169" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="60.0" /></multiply>
    <add name="add_170" type="vector2"><input name="in1" type="vector2" nodename="multiply_169" /><input name="in2" type="vector2" value="71.9, 23.3" /></add>
    <fractal2d name="fractal2d_171" type="float"><input name="texcoord" type="vector2" nodename="add_170" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <multiply name="multiply_172" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="90.0" /></multiply>
    <add name="add_173" type="vector2"><input name="in1" type="vector2" nodename="multiply_172" /><input name="in2" type="vector2" value="9.7, 3.3" /></add>
    <fractal2d name="fractal2d_174" type="float"><input name="texcoord" type="vector2" nodename="add_173" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <smoothstep name="smoothstep_175" type="float"><input name="in" type="float" nodename="fractal2d_174" /><input name="low" type="float" value="-0.1" /><input name="high" type="float" value="0.35" /></smoothstep>
    <multiply name="multiply_176" type="float"><input name="in1" type="float" nodename="wear" /><input name="in2" type="float" value="0.6" /></multiply>
    <add name="add_177" type="float"><input name="in1" type="float" nodename="multiply_176" /><input name="in2" type="float" value="0.4" /></add>
    <multiply name="dirt" type="float"><input name="in1" type="float" nodename="smoothstep_175" /><input name="in2" type="float" nodename="add_177" /></multiply>
    <mix name="mix_179" type="color3"><input name="bg" type="color3" value="0.3, 0.17, 0.085" /><input name="fg" type="color3" value="0.25, 0.165, 0.1" /><input name="mix" type="float" nodename="id_hue" /></mix>
    <mix name="mix_180" type="color3"><input name="bg" type="color3" value="0.1, 0.055, 0.028" /><input name="fg" type="color3" value="0.09, 0.06, 0.038" /><input name="mix" type="float" nodename="id_hue" /></mix>
    <multiply name="multiply_181" type="float"><input name="in1" type="float" nodename="fractal2d_164" /><input name="in2" type="float" value="0.25" /></multiply>
    <add name="add_182" type="float"><input name="in1" type="float" nodename="id_tone" /><input name="in2" type="float" nodename="multiply_181" /></add>
    <multiply name="multiply_183" type="float"><input name="in1" type="float" nodename="fractal2d_171" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="add_184" type="float"><input name="in1" type="float" nodename="add_182" /><input name="in2" type="float" nodename="multiply_183" /></add>
    <clamp name="tone" type="float"><input name="in" type="float" nodename="add_184" /></clamp>
    <mix name="wood0" type="color3"><input name="bg" type="color3" nodename="mix_180" /><input name="fg" type="color3" nodename="mix_179" /><input name="mix" type="float" nodename="tone" /></mix>
    <mix name="lw_col" type="color3"><input name="bg" type="color3" value="1.0, 1.0, 1.0" /><input name="fg" type="color3" value="0.55, 0.46, 0.4" /><input name="mix" type="float" nodename="lw_str" /></mix>
    <multiply name="multiply_188" type="float"><input name="in1" type="float" nodename="earlywood" /><input name="in2" type="float" value="0.12" /></multiply>
    <subtract name="ew_dark" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="multiply_188" /></subtract>
    <subtract name="subtract_190" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="latewood" /></subtract>
    <multiply name="multiply_191" type="float"><input name="in1" type="float" nodename="subtract_190" /><input name="in2" type="float" value="0.12" /></multiply>
    <multiply name="multiply_192" type="float"><input name="in1" type="float" nodename="ray" /><input name="in2" type="float" nodename="multiply_191" /></multiply>
    <add name="ray_light" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="multiply_192" /></add>
    <multiply name="wood1" type="color3"><input name="in1" type="color3" nodename="wood0" /><input name="in2" type="color3" nodename="lw_col" /></multiply>
    <multiply name="multiply_195" type="float"><input name="in1" type="float" nodename="ew_dark" /><input name="in2" type="float" nodename="ray_light" /></multiply>
    <multiply name="wood2" type="color3"><input name="in1" type="color3" nodename="wood1" /><input name="in2" type="float" nodename="multiply_195" /></multiply>
    <multiply name="multiply_197" type="float"><input name="in1" type="float" nodename="pore" /><input name="in2" type="float" value="0.55" /></multiply>
    <mix name="wood_pore" type="color3"><input name="bg" type="color3" nodename="wood2" /><input name="fg" type="color3" value="0.03, 0.022, 0.015" /><input name="mix" type="float" nodename="multiply_197" /></mix>
    <multiply name="multiply_199" type="float"><input name="in1" type="float" nodename="check" /><input name="in2" type="float" value="0.9" /></multiply>
    <mix name="wood_chk" type="color3"><input name="bg" type="color3" nodename="wood_pore" /><input name="fg" type="color3" value="0.018, 0.013, 0.01" /><input name="mix" type="float" nodename="multiply_199" /></mix>
    <multiply name="multiply_201" type="color3"><input name="in1" type="color3" nodename="wood_chk" /><input name="in2" type="color3" value="1.3, 1.24, 1.2" /></multiply>
    <multiply name="multiply_202" type="float"><input name="in1" type="float" nodename="wear" /><input name="in2" type="float" value="0.8" /></multiply>
    <mix name="wood_wear" type="color3"><input name="bg" type="color3" nodename="wood_chk" /><input name="fg" type="color3" nodename="multiply_201" /><input name="mix" type="float" nodename="multiply_202" /></mix>
    <multiply name="multiply_204" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="4.0" /></multiply>
    <add name="add_205" type="vector2"><input name="in1" type="vector2" nodename="multiply_204" /><input name="in2" type="vector2" value="61.3, 7.7" /></add>
    <fractal2d name="fractal2d_206" type="float"><input name="texcoord" type="vector2" nodename="add_205" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="4" /></fractal2d>
    <smoothstep name="smoothstep_207" type="float"><input name="in" type="float" nodename="fractal2d_206" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.5" /></smoothstep>
    <subtract name="subtract_208" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="wear" /></subtract>
    <multiply name="grime" type="float"><input name="in1" type="float" nodename="smoothstep_207" /><input name="in2" type="float" nodename="subtract_208" /></multiply>
    <multiply name="multiply_210" type="color3"><input name="in1" type="color3" nodename="wood_wear" /><input name="in2" type="color3" value="0.8, 0.78, 0.76" /></multiply>
    <mix name="wood_grime" type="color3"><input name="bg" type="color3" nodename="wood_wear" /><input name="fg" type="color3" nodename="multiply_210" /><input name="mix" type="float" nodename="grime" /></mix>
    <multiply name="multiply_212" type="color3"><input name="in1" type="color3" nodename="wood_grime" /><input name="in2" type="color3" value="0.55, 0.52, 0.5" /></multiply>
    <multiply name="multiply_213" type="float"><input name="in1" type="float" nodename="dirt" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="add_214" type="float"><input name="in1" type="float" nodename="multiply_213" /><input name="in2" type="float" value="0.3" /></add>
    <multiply name="multiply_215" type="float"><input name="in1" type="float" nodename="grime_edge" /><input name="in2" type="float" nodename="add_214" /></multiply>
    <mix name="wood" type="color3"><input name="bg" type="color3" nodename="wood_grime" /><input name="fg" type="color3" nodename="multiply_212" /><input name="mix" type="float" nodename="multiply_215" /></mix>
    <mix name="filler_col" type="color3"><input name="bg" type="color3" value="0.028, 0.024, 0.02" /><input name="fg" type="color3" value="0.065, 0.058, 0.05" /><input name="mix" type="float" nodename="dirt" /></mix>
    <mix name="base_color" type="color3"><input name="bg" type="color3" nodename="filler_col" /><input name="fg" type="color3" nodename="wood" /><input name="mix" type="float" nodename="tile" /></mix>
    <subtract name="subtract_219" type="float"><input name="in1" type="float" nodename="id_lip" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_220" type="float"><input name="in1" type="float" nodename="subtract_219" /><input name="in2" type="float" value="0.0003" /></multiply>
    <combine2 name="combine2_221" type="vector2"><input name="in1" type="float" nodename="id_tx" /><input name="in2" type="float" nodename="id_ty" /></combine2>
    <subtract name="subtract_222" type="vector2"><input name="in1" type="vector2" nodename="combine2_221" /><input name="in2" type="vector2" value="0.5, 0.5" /></subtract>
    <multiply name="multiply_223" type="vector2"><input name="in1" type="vector2" nodename="subtract_222" /><input name="in2" type="float" value="0.005" /></multiply>
    <dotproduct name="dotproduct_224" type="float"><input name="in1" type="vector2" nodename="rg_loc" /><input name="in2" type="vector2" nodename="multiply_223" /></dotproduct>
    <!-- height -->
    <add name="lip" type="float"><input name="in1" type="float" nodename="multiply_220" /><input name="in2" type="float" nodename="dotproduct_224" /></add>
    <multiply name="multiply_226" type="float"><input name="in1" type="float" nodename="lw_str" /><input name="in2" type="float" value="8e-06" /></multiply>
    <multiply name="multiply_227" type="float"><input name="in1" type="float" nodename="pore" /><input name="in2" type="float" value="3e-05" /></multiply>
    <subtract name="grain_h" type="float"><input name="in1" type="float" nodename="multiply_226" /><input name="in2" type="float" nodename="multiply_227" /></subtract>
    <add name="add_229" type="float"><input name="in1" type="float" nodename="lip" /><input name="in2" type="float" nodename="grain_h" /></add>
    <multiply name="multiply_230" type="float"><input name="in1" type="float" nodename="fractal2d_171" /><input name="in2" type="float" value="3e-05" /></multiply>
    <add name="top0" type="float"><input name="in1" type="float" nodename="add_229" /><input name="in2" type="float" nodename="multiply_230" /></add>
    <multiply name="multiply_232" type="float"><input name="in1" type="float" nodename="check" /><input name="in2" type="float" value="0.0002" /></multiply>
    <subtract name="top" type="float"><input name="in1" type="float" nodename="top0" /><input name="in2" type="float" nodename="multiply_232" /></subtract>
    <multiply name="multiply_234" type="float"><input name="in1" type="float" nodename="fractal2d_174" /><input name="in2" type="float" value="6e-05" /></multiply>
    <add name="fill_h" type="float"><input name="in1" type="float" value="-0.0004" /><input name="in2" type="float" nodename="multiply_234" /></add>
    <mix name="height" type="float"><input name="bg" type="float" nodename="fill_h" /><input name="fg" type="float" nodename="top" /><input name="mix" type="float" nodename="ease" /></mix>
    <multiply name="multiply_237" type="float"><input name="in1" type="float" nodename="id_tone" /><input name="in2" type="float" value="0.06" /></multiply>
    <add name="add_238" type="float"><input name="in1" type="float" nodename="multiply_237" /><input name="in2" type="float" value="0.64" /></add>
    <multiply name="multiply_239" type="float"><input name="in1" type="float" nodename="earlywood" /><input name="in2" type="float" value="0.08" /></multiply>
    <!-- roughness -->
    <add name="rough_w0" type="float"><input name="in1" type="float" nodename="add_238" /><input name="in2" type="float" nodename="multiply_239" /></add>
    <multiply name="multiply_241" type="float"><input name="in1" type="float" nodename="lw_str" /><input name="in2" type="float" value="0.06" /></multiply>
    <subtract name="rough_w1" type="float"><input name="in1" type="float" nodename="rough_w0" /><input name="in2" type="float" nodename="multiply_241" /></subtract>
    <multiply name="multiply_243" type="float"><input name="in1" type="float" nodename="wear" /><input name="in2" type="float" value="0.07" /></multiply>
    <max name="max_244" type="float"><input name="in1" type="float" nodename="pore" /><input name="in2" type="float" nodename="check" /></max>
    <multiply name="multiply_245" type="float"><input name="in1" type="float" nodename="max_244" /><input name="in2" type="float" value="0.12" /></multiply>
    <add name="add_246" type="float"><input name="in1" type="float" nodename="multiply_243" /><input name="in2" type="float" nodename="multiply_245" /></add>
    <add name="rough_w2" type="float"><input name="in1" type="float" nodename="rough_w1" /><input name="in2" type="float" nodename="add_246" /></add>
    <multiply name="multiply_248" type="float"><input name="in1" type="float" nodename="dirt" /><input name="in2" type="float" value="0.06" /></multiply>
    <add name="add_249" type="float"><input name="in1" type="float" value="0.88" /><input name="in2" type="float" nodename="multiply_248" /></add>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="add_249" /><input name="fg" type="float" nodename="rough_w2" /><input name="mix" type="float" nodename="tile" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_end_grain_block" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_end_grain_block" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_end_grain_block" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_end_grain_block" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_end_grain_block" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_end_grain_block" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_end_grain_block" /></surfacematerial>
</materialx>

