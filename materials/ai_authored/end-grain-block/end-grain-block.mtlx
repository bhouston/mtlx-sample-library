<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Oiled oak end-grain block floor: 90 x 60 mm blocks, half running bond, 2 mm dark filler. Growth-ring arcs from a per-block pith, darker latewood, porous oil-dark earlywood, rays, radial checks. UV 0..1 = 1 m, heights in m. -->
  <nodegraph name="NG_end_grain_block">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- layout: 90 x 60 mm blocks, 2 mm joints, half running bond -->
    <divide name="rg_v" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="0.062" /></divide>
    <floor name="rg_row" type="float"><input name="in" type="float" nodename="rg_v" /></floor>
    <divide name="divide_5" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="0.092" /></divide>
    <multiply name="multiply_6" type="float"><input name="in1" type="float" nodename="rg_row" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="rg_u" type="float"><input name="in1" type="float" nodename="divide_5" /><input name="in2" type="float" nodename="multiply_6" /></add>
    <combine2 name="rg_p" type="vector2"><input name="in1" type="float" nodename="rg_u" /><input name="in2" type="float" nodename="rg_v" /></combine2>
    <floor name="rg_cell" type="vector2"><input name="in" type="vector2" nodename="rg_p" /></floor>
    <subtract name="subtract_10" type="vector2"><input name="in1" type="vector2" nodename="rg_p" /><input name="in2" type="vector2" nodename="rg_cell" /></subtract>
    <subtract name="subtract_11" type="vector2"><input name="in1" type="vector2" nodename="subtract_10" /><input name="in2" type="vector2" value="0.5, 0.5" /></subtract>
    <multiply name="rg_loc" type="vector2"><input name="in1" type="vector2" nodename="subtract_11" /><input name="in2" type="vector2" value="0.092, 0.062" /></multiply>
    <absval name="absval_13" type="vector2"><input name="in" type="vector2" nodename="rg_loc" /></absval>
    <subtract name="rg_e" type="vector2"><input name="in1" type="vector2" value="0.045, 0.03" /><input name="in2" type="vector2" nodename="absval_13" /></subtract>
    <separate2 name="rg_es" type="multioutput"><input name="in" type="vector2" nodename="rg_e" /></separate2>
    <min name="rg_d" type="float"><input name="in1" type="float" nodename="rg_es" output="outx" /><input name="in2" type="float" nodename="rg_es" output="outy" /></min>
    <multiply name="multiply_17" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="110.0" /></multiply>
    <add name="add_18" type="vector2"><input name="in1" type="vector2" nodename="multiply_17" /><input name="in2" type="vector2" value="3.7, 9.1" /></add>
    <noise2d name="noise2d_19" type="float"><input name="texcoord" type="vector2" nodename="add_18" /><input name="amplitude" type="float" value="0.0003" /></noise2d>
    <add name="d_edge" type="float"><input name="in1" type="float" nodename="rg_d" /><input name="in2" type="float" nodename="noise2d_19" /></add>
    <add name="add_21" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="200.37, 300.61" /></add>
    <cellnoise2d name="id_ang" type="float"><input name="texcoord" type="vector2" nodename="add_21" /></cellnoise2d>
    <add name="add_23" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="213.47, 307.91" /></add>
    <cellnoise2d name="id_far" type="float"><input name="texcoord" type="vector2" nodename="add_23" /></cellnoise2d>
    <add name="add_25" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="226.57, 315.21000000000004" /></add>
    <cellnoise2d name="id_dist" type="float"><input name="texcoord" type="vector2" nodename="add_25" /></cellnoise2d>
    <add name="add_27" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="239.67000000000002, 322.51" /></add>
    <cellnoise2d name="id_sp" type="float"><input name="texcoord" type="vector2" nodename="add_27" /></cellnoise2d>
    <add name="add_29" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="252.77, 329.81" /></add>
    <cellnoise2d name="id_ring" type="float"><input name="texcoord" type="vector2" nodename="add_29" /></cellnoise2d>
    <add name="add_31" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="265.87, 337.11" /></add>
    <cellnoise2d name="id_tone" type="float"><input name="texcoord" type="vector2" nodename="add_31" /></cellnoise2d>
    <add name="add_33" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="278.97, 344.41" /></add>
    <cellnoise2d name="id_hue" type="float"><input name="texcoord" type="vector2" nodename="add_33" /></cellnoise2d>
    <add name="add_35" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="292.07, 351.71000000000004" /></add>
    <cellnoise2d name="id_lip" type="float"><input name="texcoord" type="vector2" nodename="add_35" /></cellnoise2d>
    <add name="add_37" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="305.17, 359.01" /></add>
    <cellnoise2d name="id_tx" type="float"><input name="texcoord" type="vector2" nodename="add_37" /></cellnoise2d>
    <add name="add_39" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="318.27, 366.31" /></add>
    <cellnoise2d name="id_ty" type="float"><input name="texcoord" type="vector2" nodename="add_39" /></cellnoise2d>
    <add name="add_41" type="vector2"><input name="in1" type="vector2" nodename="rg_cell" /><input name="in2" type="vector2" value="331.37, 373.61" /></add>
    <cellnoise2d name="id_chk" type="float"><input name="texcoord" type="vector2" nodename="add_41" /></cellnoise2d>
    <!-- growth rings: pith per block -->
    <ifgreater name="pith_far" type="float"><input name="value1" type="float" nodename="id_far" /><input name="value2" type="float" value="0.15" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_44" type="float"><input name="in1" type="float" nodename="id_dist" /><input name="in2" type="float" value="0.018" /></multiply>
