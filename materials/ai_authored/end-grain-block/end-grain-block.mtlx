    <add name="ring_phase" type="float"><input name="in1" type="float" nodename="ring_q" /><input name="in2" type="float" nodename="ring_qn" /></add>
    <floor name="ring_k" type="float"><input name="in" type="float" nodename="ring_phase" /></floor>
    <subtract name="ring_f" type="float"><input name="in1" type="float" nodename="ring_phase" /><input name="in2" type="float" nodename="ring_k" /></subtract>
    <multiply name="multiply_76" type="float"><input name="in1" type="float" nodename="id_ring" /><input name="in2" type="float" value="500.0" /></multiply>
    <add name="add_77" type="float"><input name="in1" type="float" nodename="multiply_76" /><input name="in2" type="float" value="0.37" /></add>
    <combine2 name="combine2_78" type="vector2"><input name="in1" type="float" nodename="ring_k" /><input name="in2" type="float" nodename="add_77" /></combine2>
    <cellnoise2d name="ring_rnd" type="float"><input name="texcoord" type="vector2" nodename="combine2_78" /></cellnoise2d>
    <multiply name="multiply_80" type="float"><input name="in1" type="float" nodename="ring_rnd" /><input name="in2" type="float" value="0.25" /></multiply>
    <add name="lw0" type="float"><input name="in1" type="float" nodename="multiply_80" /><input name="in2" type="float" value="0.42" /></add>
