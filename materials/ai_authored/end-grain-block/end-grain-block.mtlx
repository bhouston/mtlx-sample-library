    <multiply name="multiply_70" type="float"><input name="in1" type="float" nodename="id_ring" /><input name="in2" type="float" value="71.0" /></multiply>
    <combine2 name="combine2_71" type="vector2"><input name="in1" type="float" nodename="multiply_69" /><input name="in2" type="float" nodename="multiply_70" /></combine2>
