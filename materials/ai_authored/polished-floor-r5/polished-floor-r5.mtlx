<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Ground and polished concrete floor: flush aggregate cross-sections (3-15 mm) in grey paste, near-flat, roughness 0.17-0.35 with haze and grinder swirls. UV 0..1 = 1 m, heights in m. -->
  <nodegraph name="NG_polished_floor">
    <texcoord name="uv" type="vector2"></texcoord>
    <multiply name="multiply_2" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="2.3" /></multiply>
    <add name="add_3" type="vector2"><input name="in1" type="vector2" nodename="multiply_2" /><input name="in2" type="vector2" value="17.3, 5.8" /></add>
    <!-- tone drift, ~30 cm blobs (fBm 2.3/m, 4 oct), signed -->
    <fractal2d name="tone" type="float"><input name="texcoord" type="vector2" nodename="add_3" /><input name="octaves" type="integer" value="4" /></fractal2d>
    <multiply name="multiply_5" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="3.0" /></multiply>
    <add name="add_6" type="vector2"><input name="in1" type="vector2" nodename="multiply_5" /><input name="in2" type="vector2" value="41.3, 9.1" /></add>
    <!-- aggregate exposure density, ~25 cm (3/m), 0..1 -->
