    <subtract name="subtract_269" type="vector2"><input name="in1" type="vector2" nodename="combine2_268" /><input name="in2" type="vector2" value="0.5, 0.5" /></subtract>
    <multiply name="multiply_270" type="vector2"><input name="in1" type="vector2" nodename="subtract_269" /><input name="in2" type="float" value="0.2" /></multiply>
    <subtract name="subtract_271" type="vector2"><input name="in1" type="vector2" nodename="add_262" /><input name="in2" type="vector2" nodename="floor_263" /></subtract>
    <add name="add_272" type="vector2"><input name="in1" type="vector2" nodename="multiply_270" /><input name="in2" type="vector2" value="0.5, 0.5" /></add>
    <subtract name="subtract_273" type="vector2"><input name="in1" type="vector2" nodename="subtract_271" /><input name="in2" type="vector2" nodename="add_272" /></subtract>
    <magnitude name="magnitude_274" type="float"><input name="in" type="vector2" nodename="subtract_273" /></magnitude>
    <separate2 name="separate2_275" type="multioutput"><input name="in" type="vector2" nodename="subtract_273" /></separate2>
    <atan2 name="atan2_276" type="float"><input name="iny" type="float" nodename="separate2_275" output="outy" /><input name="inx" type="float" nodename="separate2_275" output="outx" /></atan2>
    <multiply name="multiply_277" type="float"><input name="in1" type="float" nodename="magnitude_274" /><input name="in2" type="float" value="132.0" /></multiply>
    <multiply name="multiply_278" type="float"><input name="in1" type="float" nodename="atan2_276" /><input name="in2" type="float" value="2.2" /></multiply>
    <combine2 name="combine2_279" type="vector2"><input name="in1" type="float" nodename="multiply_277" /><input name="in2" type="float" nodename="multiply_278" /></combine2>
    <add name="add_280" type="vector2"><input name="in1" type="vector2" nodename="combine2_279" /><input name="in2" type="vector2" value="91.0, 3.3" /></add>
    <noise2d name="noise2d_281" type="float"><input name="texcoord" type="vector2" nodename="add_280" /></noise2d>
    <smoothstep name="smoothstep_282" type="float"><input name="in" type="float" nodename="noise2d_281" /><input name="low" type="float" value="0.1" /><input name="high" type="float" value="0.5" /></smoothstep>
    <smoothstep name="smoothstep_283" type="float"><input name="in" type="float" nodename="magnitude_274" /><input name="low" type="float" value="0.12" /><input name="high" type="float" value="0.22" /></smoothstep>
    <smoothstep name="smoothstep_284" type="float"><input name="in" type="float" nodename="magnitude_274" /><input name="low" type="float" value="0.3" /><input name="high" type="float" value="0.4" /></smoothstep>
    <subtract name="subtract_285" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_284" /></subtract>
    <multiply name="multiply_286" type="float"><input name="in1" type="float" nodename="smoothstep_283" /><input name="in2" type="float" nodename="subtract_285" /></multiply>
    <multiply name="multiply_287" type="float"><input name="in1" type="float" nodename="atan2_276" /><input name="in2" type="float" value="1.1" /></multiply>
    <multiply name="multiply_288" type="float"><input name="in1" type="float" nodename="cellnoise2d_265" /><input name="in2" type="float" value="50.0" /></multiply>
    <combine2 name="combine2_289" type="vector2"><input name="in1" type="float" nodename="multiply_287" /><input name="in2" type="float" nodename="multiply_288" /></combine2>
    <noise2d name="noise2d_290" type="float"><input name="texcoord" type="vector2" nodename="combine2_289" /></noise2d>
    <smoothstep name="smoothstep_291" type="float"><input name="in" type="float" nodename="noise2d_290" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.25" /></smoothstep>
    <multiply name="multiply_292" type="float"><input name="in1" type="float" nodename="multiply_286" /><input name="in2" type="float" nodename="smoothstep_291" /></multiply>
    <absval name="absval_293" type="float"><input name="in" type="float" nodename="atan2_276" /></absval>
    <smoothstep name="smoothstep_294" type="float"><input name="in" type="float" nodename="absval_293" /><input name="low" type="float" value="2.7" /><input name="high" type="float" value="3.1" /></smoothstep>
    <subtract name="subtract_295" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_294" /></subtract>
    <add name="add_296" type="vector2"><input name="in1" type="vector2" nodename="floor_263" /><input name="in2" type="vector2" value="91.0, 91.0" /></add>
    <cellnoise2d name="cellnoise2d_297" type="float"><input name="texcoord" type="vector2" nodename="add_296" /></cellnoise2d>
    <smoothstep name="smoothstep_298" type="float"><input name="in" type="float" nodename="cellnoise2d_297" /><input name="low" type="float" value="0.25" /><input name="high" type="float" value="0.4" /></smoothstep>
    <multiply name="multiply_299" type="float"><input name="in1" type="float" nodename="smoothstep_282" /><input name="in2" type="float" nodename="multiply_292" /></multiply>
    <multiply name="multiply_300" type="float"><input name="in1" type="float" nodename="subtract_295" /><input name="in2" type="float" nodename="smoothstep_298" /></multiply>
    <multiply name="multiply_301" type="float"><input name="in1" type="float" nodename="multiply_299" /><input name="in2" type="float" nodename="multiply_300" /></multiply>
    <max name="swl" type="float"><input name="in1" type="float" nodename="max_259" /><input name="in2" type="float" nodename="multiply_301" /></max>
    <multiply name="multiply_303" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="4.0" /></multiply>
    <add name="add_304" type="vector2"><input name="in1" type="vector2" nodename="multiply_303" /><input name="in2" type="vector2" value="29.6, 15.2" /></add>
    <!-- slab waviness 4/m, 0.8 mm (~0.25 deg) -->
    <noise2d name="h_wave" type="float"><input name="texcoord" type="vector2" nodename="add_304" /><input name="amplitude" type="float" value="0.0008" /></noise2d>
    <multiply name="multiply_306" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="25.0" /></multiply>
    <add name="add_307" type="vector2"><input name="in1" type="vector2" nodename="multiply_306" /><input name="in2" type="vector2" value="3.3, 61.7" /></add>
    <!-- grinding ripple 25/m, 0.12 mm (~0.2 deg) -->
    <noise2d name="h_ripple" type="float"><input name="texcoord" type="vector2" nodename="add_307" /><input name="amplitude" type="float" value="0.00012" /></noise2d>
    <add name="add_309" type="float"><input name="in1" type="float" nodename="h_wave" /><input name="in2" type="float" nodename="h_ripple" /></add>
    <add name="add_310" type="float"><input name="in1" type="float" nodename="h_pit" /><input name="in2" type="float" nodename="multiply_174" /></add>
    <add name="height" type="float"><input name="in1" type="float" nodename="add_309" /><input name="in2" type="float" nodename="add_310" /></add>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <mix name="mix_316" type="color3"><input name="bg" type="color3" nodename="paste" /><input name="fg" type="color3" nodename="b_col" /><input name="mix" type="float" nodename="b_m" /></mix>
    <mix name="mix_317" type="color3"><input name="bg" type="color3" nodename="mix_316" /><input name="fg" type="color3" nodename="multiply_98" /><input name="mix" type="float" nodename="a_m" /></mix>
    <mix name="mix_318" type="float"><input name="bg" type="float" value="1.0" /><input name="fg" type="float" value="0.45" /><input name="mix" type="float" nodename="p_mask" /></mix>
    <multiply name="color" type="color3"><input name="in1" type="color3" nodename="mix_317" /><input name="in2" type="float" nodename="mix_318" /></multiply>
    <multiply name="multiply_320" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1.7" /></multiply>
    <add name="add_321" type="vector2"><input name="in1" type="vector2" nodename="multiply_320" /><input name="in2" type="vector2" value="61.1, 2.9" /></add>
    <fractal2d name="fractal2d_322" type="float"><input name="texcoord" type="vector2" nodename="add_321" /><input name="octaves" type="integer" value="3" /></fractal2d>
    <smoothstep name="haze" type="float"><input name="in" type="float" nodename="fractal2d_322" /><input name="low" type="float" value="-0.1" /><input name="high" type="float" value="0.5" /></smoothstep>
    <multiply name="multiply_324" type="float"><input name="in1" type="float" nodename="haze" /><input name="in2" type="float" value="0.12" /></multiply>
    <add name="add_325" type="float"><input name="in1" type="float" value="0.185" /><input name="in2" type="float" nodename="multiply_324" /></add>
    <max name="max_326" type="float"><input name="in1" type="float" nodename="a_m" /><input name="in2" type="float" nodename="b_m" /></max>
    <multiply name="multiply_327" type="float"><input name="in1" type="float" nodename="max_326" /><input name="in2" type="float" value="0.03" /></multiply>
    <subtract name="subtract_328" type="float"><input name="in1" type="float" nodename="add_325" /><input name="in2" type="float" nodename="multiply_327" /></subtract>
    <multiply name="multiply_329" type="float"><input name="in1" type="float" nodename="swl" /><input name="in2" type="float" value="0.07" /></multiply>
    <multiply name="multiply_330" type="float"><input name="in1" type="float" nodename="scr" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="add_331" type="float"><input name="in1" type="float" nodename="multiply_329" /><input name="in2" type="float" nodename="multiply_330" /></add>
    <add name="add_332" type="float"><input name="in1" type="float" nodename="subtract_328" /><input name="in2" type="float" nodename="add_331" /></add>
    <mix name="rough" type="float"><input name="bg" type="float" nodename="add_332" /><input name="fg" type="float" value="0.55" /><input name="mix" type="float" nodename="p_mask" /></mix>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="color" />
    <output name="roughness_out" type="float" nodename="rough" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_polished_floor" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_polished_floor" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_polished_floor" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_polished_floor" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_polished_floor" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_polished_floor" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_polished_floor" /></surfacematerial>
</materialx>

