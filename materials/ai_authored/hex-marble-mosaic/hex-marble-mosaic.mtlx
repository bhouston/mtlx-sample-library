    <mix name="mix_139" type="color3"><input name="bg" type="color3" value="0.34, 0.335, 0.32" /><input name="fg" type="color3" value="0.42, 0.415, 0.4" /><input name="mix" type="float" nodename="clamp_138" /></mix>
    <mix name="base_color" type="color3"><input name="bg" type="color3" nodename="mix_135" /><input name="fg" type="color3" nodename="mix_139" /><input name="mix" type="float" nodename="grout" /></mix>
    <multiply name="multiply_141" type="float"><input name="in1" type="float" nodename="id_tone2" /><input name="in2" type="float" value="0.06" /></multiply>
    <add name="add_142" type="float"><input name="in1" type="float" nodename="multiply_141" /><input name="in2" type="float" value="0.34" /></add>
    <multiply name="multiply_143" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="60.0" /></multiply>
    <add name="add_144" type="vector2"><input name="in1" type="vector2" nodename="multiply_143" /><input name="in2" type="vector2" value="9.7, 3.9" /></add>
    <noise2d name="noise2d_145" type="float"><input name="texcoord" type="vector2" nodename="add_144" /><input name="amplitude" type="float" value="0.05" /></noise2d>
    <add name="add_146" type="float"><input name="in1" type="float" nodename="add_142" /><input name="in2" type="float" nodename="noise2d_145" /></add>
    <multiply name="multiply_147" type="float"><input name="in1" type="float" nodename="vein" /><input name="in2" type="float" value="0.03" /></multiply>
    <add name="add_148" type="float"><input name="in1" type="float" nodename="add_146" /><input name="in2" type="float" nodename="multiply_147" /></add>
    <smoothstep name="smoothstep_149" type="float"><input name="in" type="float" nodename="pit" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.3" /></smoothstep>
    <mix name="mix_150" type="float"><input name="bg" type="float" nodename="add_148" /><input name="fg" type="float" value="0.7" /><input name="mix" type="float" nodename="smoothstep_149" /></mix>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="mix_150" /><input name="fg" type="float" value="0.9" /><input name="mix" type="float" nodename="grout" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_hex_marble_mosaic" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_hex_marble_mosaic" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_hex_marble_mosaic" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_hex_marble_mosaic" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_hex_marble_mosaic" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_hex_marble_mosaic" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_hex_marble_mosaic" /></surfacematerial>
</materialx>

