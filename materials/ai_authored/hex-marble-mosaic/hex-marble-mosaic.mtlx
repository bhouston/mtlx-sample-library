<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Honed Carrara marble hexagon mosaic: 50 mm hexes (across flats), 2 mm grey grout. UV 0..1 = 1 m, heights in meters. -->
  <nodegraph name="NG_hex_marble_mosaic">
    <texcoord name="uv" type="vector2"></texcoord>
    <!-- hex grid: 52 mm pitch (50 mm tile + 2 mm grout), exact sqrt3 aspect -->
    <modulo name="modulo_2" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.052, 0.09006664199358161" /></modulo>
    <subtract name="hx_qa" type="vector2"><input name="in1" type="vector2" nodename="modulo_2" /><input name="in2" type="vector2" value="0.026, 0.045033320996790804" /></subtract>
