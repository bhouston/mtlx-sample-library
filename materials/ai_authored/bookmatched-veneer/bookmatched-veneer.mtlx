<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Book-matched figured anigre veneer wall panels (600 x 1200 mm, 150 mm leaves, 6 mm black reveals), satin lacquer. UV 0..1 = 1 m, heights in meters. Generated by gen.py. -->
  <nodegraph name="NG_bookmatched_veneer">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- layout: 600 x 1200 mm panels on a 606 x 1206 mm pitch, 6 mm reveals; px, py panel-local m (0..0.6, 0..1.2) -->
    <divide name="pn_u" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="0.606" /></divide>
    <divide name="pn_v" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="1.206" /></divide>
    <floor name="pn_col" type="float"><input name="in" type="float" nodename="pn_u" /></floor>
    <floor name="pn_row" type="float"><input name="in" type="float" nodename="pn_v" /></floor>
    <subtract name="subtract_7" type="float"><input name="in1" type="float" nodename="pn_u" /><input name="in2" type="float" nodename="pn_col" /></subtract>
    <multiply name="multiply_8" type="float"><input name="in1" type="float" nodename="subtract_7" /><input name="in2" type="float" value="0.606" /></multiply>
    <subtract name="pn_x" type="float"><input name="in1" type="float" nodename="multiply_8" /><input name="in2" type="float" value="0.003" /></subtract>
    <subtract name="subtract_10" type="float"><input name="in1" type="float" nodename="pn_v" /><input name="in2" type="float" nodename="pn_row" /></subtract>
    <multiply name="multiply_11" type="float"><input name="in1" type="float" nodename="subtract_10" /><input name="in2" type="float" value="1.206" /></multiply>
    <subtract name="pn_y" type="float"><input name="in1" type="float" nodename="multiply_11" /><input name="in2" type="float" value="0.003" /></subtract>
    <subtract name="subtract_13" type="float"><input name="in1" type="float" value="0.6" /><input name="in2" type="float" nodename="pn_x" /></subtract>
    <min name="pn_dx" type="float"><input name="in1" type="float" nodename="pn_x" /><input name="in2" type="float" nodename="subtract_13" /></min>
    <subtract name="subtract_15" type="float"><input name="in1" type="float" value="1.2" /><input name="in2" type="float" nodename="pn_y" /></subtract>
    <min name="pn_dy" type="float"><input name="in1" type="float" nodename="pn_y" /><input name="in2" type="float" nodename="subtract_15" /></min>
    <min name="pn_d" type="float"><input name="in1" type="float" nodename="pn_dx" /><input name="in2" type="float" nodename="pn_dy" /></min>
    <smoothstep name="panel" type="float"><input name="in" type="float" nodename="pn_d" /><input name="low" type="float" value="-0.0002" /><input name="high" type="float" value="0.0002" /></smoothstep>
    <!-- book-match: a = 0.15 - |mod(px, 0.3) - 0.15| (flitch across-grain m, mirrored at every seam) -->
    <modulo name="bm_t" type="float"><input name="in1" type="float" nodename="pn_x" /><input name="in2" type="float" value="0.3" /></modulo>
    <subtract name="subtract_20" type="float"><input name="in1" type="float" nodename="bm_t" /><input name="in2" type="float" value="0.15" /></subtract>
    <absval name="absval_21" type="float"><input name="in" type="float" nodename="subtract_20" /></absval>
    <subtract name="bm_a" type="float"><input name="in1" type="float" value="0.15" /><input name="in2" type="float" nodename="absval_21" /></subtract>
    <subtract name="subtract_23" type="float"><input name="in1" type="float" value="0.15" /><input name="in2" type="float" nodename="bm_a" /></subtract>
    <min name="bm_ds" type="float"><input name="in1" type="float" nodename="bm_a" /><input name="in2" type="float" nodename="subtract_23" /></min>
    <multiply name="multiply_25" type="float"><input name="in1" type="float" nodename="pn_col" /><input name="in2" type="float" value="0.31" /></multiply>
    <multiply name="multiply_26" type="float"><input name="in1" type="float" nodename="pn_row" /><input name="in2" type="float" value="1.2" /></multiply>
    <add name="add_27" type="float"><input name="in1" type="float" nodename="multiply_25" /><input name="in2" type="float" nodename="multiply_26" /></add>
    <add name="bm_b" type="float"><input name="in1" type="float" nodename="pn_y" /><input name="in2" type="float" nodename="add_27" /></add>
    <combine2 name="bm_q" type="vector2"><input name="in1" type="float" nodename="bm_a" /><input name="in2" type="float" nodename="bm_b" /></combine2>
    <!-- grain run-out: across-grain warp 6 mm at 3/m -->
    <multiply name="multiply_30" type="vector2"><input name="in1" type="vector2" nodename="bm_q" /><input name="in2" type="vector2" value="3.0, 1.5" /></multiply>
    <add name="add_31" type="vector2"><input name="in1" type="vector2" nodename="multiply_30" /><input name="in2" type="vector2" value="4.1, 9.3" /></add>
    <fractal2d name="fg_ro" type="float"><input name="texcoord" type="vector2" nodename="add_31" /><input name="amplitude" type="float" value="0.006" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <add name="fg_aw" type="float"><input name="in1" type="float" nodename="bm_a" /><input name="in2" type="float" nodename="fg_ro" /></add>
    <combine2 name="fg_qw" type="vector2"><input name="in1" type="float" nodename="fg_aw" /><input name="in2" type="float" nodename="bm_b" /></combine2>
    <!-- fiddleback: cross-bands ~13 mm pitch along the grain, slanted ~20 deg (chevrons across seams), curved by a 6 mm warp, in patches -->
    <multiply name="multiply_35" type="vector2"><input name="in1" type="vector2" nodename="bm_q" /><input name="in2" type="vector2" value="10.0, 2.0" /></multiply>
    <add name="add_36" type="vector2"><input name="in1" type="vector2" nodename="multiply_35" /><input name="in2" type="vector2" value="7.7, 1.9" /></add>
    <fractal2d name="fb_w" type="float"><input name="texcoord" type="vector2" nodename="add_36" /><input name="amplitude" type="float" value="0.006" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_38" type="vector2"><input name="in1" type="vector2" nodename="bm_q" /><input name="in2" type="vector2" value="1.0, 0.8" /></multiply>
    <add name="add_39" type="vector2"><input name="in1" type="vector2" nodename="multiply_38" /><input name="in2" type="vector2" value="3.9, 12.7" /></add>
    <fractal2d name="fb_sl" type="float"><input name="texcoord" type="vector2" nodename="add_39" /><input name="amplitude" type="float" value="0.8" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <add name="fb_slant" type="float"><input name="in1" type="float" nodename="fb_sl" /><input name="in2" type="float" value="0.35" /></add>
    <add name="add_42" type="float"><input name="in1" type="float" nodename="bm_b" /><input name="in2" type="float" nodename="fb_w" /></add>
    <multiply name="multiply_43" type="float"><input name="in1" type="float" nodename="bm_a" /><input name="in2" type="float" nodename="fb_slant" /></multiply>
    <add name="add_44" type="float"><input name="in1" type="float" nodename="add_42" /><input name="in2" type="float" nodename="multiply_43" /></add>
    <combine2 name="fb_q" type="vector2"><input name="in1" type="float" nodename="bm_a" /><input name="in2" type="float" nodename="add_44" /></combine2>
    <multiply name="multiply_46" type="vector2"><input name="in1" type="vector2" nodename="fb_q" /><input name="in2" type="vector2" value="4.0, 75.0" /></multiply>
    <add name="add_47" type="vector2"><input name="in1" type="vector2" nodename="multiply_46" /><input name="in2" type="vector2" value="13.3, 5.1" /></add>
    <fractal2d name="fb_n" type="float"><input name="texcoord" type="vector2" nodename="add_47" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_49" type="vector2"><input name="in1" type="vector2" nodename="bm_q" /><input name="in2" type="vector2" value="5.0, 1.6" /></multiply>
    <add name="add_50" type="vector2"><input name="in1" type="vector2" nodename="multiply_49" /><input name="in2" type="vector2" value="21.7, 3.3" /></add>
    <fractal2d name="fb_pn" type="float"><input name="texcoord" type="vector2" nodename="add_50" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_52" type="float"><input name="in1" type="float" nodename="fb_pn" /><input name="in2" type="float" value="1.4" /></multiply>
    <add name="add_53" type="float"><input name="in1" type="float" nodename="multiply_52" /><input name="in2" type="float" value="0.55" /></add>
    <clamp name="fb_pres" type="float"><input name="in" type="float" nodename="add_53" /></clamp>
    <multiply name="figure" type="float"><input name="in1" type="float" nodename="fb_n" /><input name="in2" type="float" nodename="fb_pres" /></multiply>
    <!-- ribbon stripes ~3 cm across, long along the grain; tonal streaks; fibre -->
    <multiply name="multiply_56" type="vector2"><input name="in1" type="vector2" nodename="fg_qw" /><input name="in2" type="vector2" value="22.0, 0.8" /></multiply>
    <add name="add_57" type="vector2"><input name="in1" type="vector2" nodename="multiply_56" /><input name="in2" type="vector2" value="31.1, 17.9" /></add>
    <fractal2d name="rb_n" type="float"><input name="texcoord" type="vector2" nodename="add_57" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_59" type="vector2"><input name="in1" type="vector2" nodename="fg_qw" /><input name="in2" type="vector2" value="40.0, 1.2" /></multiply>
    <add name="add_60" type="vector2"><input name="in1" type="vector2" nodename="multiply_59" /><input name="in2" type="vector2" value="2.3, 44.1" /></add>
    <fractal2d name="st_n" type="float"><input name="texcoord" type="vector2" nodename="add_60" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <multiply name="multiply_62" type="vector2"><input name="in1" type="vector2" nodename="fg_qw" /><input name="in2" type="vector2" value="90.0, 0.7" /></multiply>
    <add name="add_63" type="vector2"><input name="in1" type="vector2" nodename="multiply_62" /><input name="in2" type="vector2" value="19.9, 3.7" /></add>
    <fractal2d name="qs_n" type="float"><input name="texcoord" type="vector2" nodename="add_63" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_65" type="vector2"><input name="in1" type="vector2" nodename="fg_qw" /><input name="in2" type="vector2" value="350.0, 5.0" /></multiply>
    <add name="add_66" type="vector2"><input name="in1" type="vector2" nodename="multiply_65" /><input name="in2" type="vector2" value="57.3, 8.2" /></add>
    <fractal2d name="fibre_n" type="float"><input name="texcoord" type="vector2" nodename="add_66" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <!-- pores: dark dashes ~0.1 x 0.8 mm along the grain (cells 0.4 x 3.3 mm) -->
    <multiply name="multiply_68" type="vector2"><input name="in1" type="vector2" nodename="fg_qw" /><input name="in2" type="vector2" value="2500.0, 300.0" /></multiply>
    <add name="add_69" type="vector2"><input name="in1" type="vector2" nodename="multiply_68" /><input name="in2" type="vector2" value="0.37, 0.61" /></add>
    <worleynoise2d name="pr_f1" type="float"><input name="texcoord" type="vector2" nodename="add_69" /><input name="jitter" type="float" value="1.0" /></worleynoise2d>
    <worleynoise2d name="pr_id" type="float"><input name="texcoord" type="vector2" nodename="add_69" /><input name="jitter" type="float" value="1.0" /><input name="style" type="integer" value="1" /></worleynoise2d>
    <smoothstep name="smoothstep_72" type="float"><input name="in" type="float" nodename="pr_f1" /><input name="low" type="float" value="0.08" /><input name="high" type="float" value="0.16" /></smoothstep>
    <subtract name="subtract_73" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_72" /></subtract>
    <smoothstep name="smoothstep_74" type="float"><input name="in" type="float" nodename="pr_id" /><input name="low" type="float" value="0.8" /><input name="high" type="float" value="0.85" /></smoothstep>
    <multiply name="pore" type="float"><input name="in1" type="float" nodename="subtract_73" /><input name="in2" type="float" nodename="smoothstep_74" /></multiply>
    <!-- color: blonde anigre (linear ~0.62, 0.40, 0.20); fiddleback +-12%, ribbon, streaks, fibre, 40 cm drift -->
    <multiply name="multiply_76" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="2.5, 2.5" /></multiply>
    <add name="add_77" type="vector2"><input name="in1" type="vector2" nodename="multiply_76" /><input name="in2" type="vector2" value="91.7, 37.1" /></add>
    <fractal2d name="c_drift" type="float"><input name="texcoord" type="vector2" nodename="add_77" /><input name="amplitude" type="float" value="0.05" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_79" type="float"><input name="in1" type="float" nodename="figure" /><input name="in2" type="float" value="0.22" /></multiply>
    <multiply name="multiply_80" type="float"><input name="in1" type="float" nodename="rb_n" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="add_81" type="float"><input name="in1" type="float" nodename="multiply_79" /><input name="in2" type="float" nodename="multiply_80" /></add>
    <multiply name="multiply_82" type="float"><input name="in1" type="float" nodename="st_n" /><input name="in2" type="float" value="0.07" /></multiply>
    <multiply name="multiply_83" type="float"><input name="in1" type="float" nodename="fibre_n" /><input name="in2" type="float" value="0.04" /></multiply>
    <add name="add_84" type="float"><input name="in1" type="float" nodename="multiply_82" /><input name="in2" type="float" nodename="multiply_83" /></add>
    <add name="add_85" type="float"><input name="in1" type="float" nodename="add_81" /><input name="in2" type="float" nodename="add_84" /></add>
    <multiply name="multiply_86" type="float"><input name="in1" type="float" nodename="qs_n" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="c_fig" type="float"><input name="in1" type="float" nodename="add_85" /><input name="in2" type="float" nodename="multiply_86" /></add>
    <add name="add_88" type="float"><input name="in1" type="float" nodename="c_fig" /><input name="in2" type="float" nodename="c_drift" /></add>
    <add name="c_bright" type="float"><input name="in1" type="float" nodename="add_88" /><input name="in2" type="float" value="1.0" /></add>
    <smoothstep name="smoothstep_90" type="float"><input name="in" type="float" nodename="figure" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.4" /></smoothstep>
    <mix name="c_base" type="color3"><input name="bg" type="color3" value="0.62, 0.4, 0.2" /><input name="fg" type="color3" value="0.66, 0.45, 0.24" /><input name="mix" type="float" nodename="smoothstep_90" /></mix>
    <multiply name="c0" type="color3"><input name="in1" type="color3" nodename="c_base" /><input name="in2" type="float" nodename="c_bright" /></multiply>
    <multiply name="multiply_93" type="float"><input name="in1" type="float" nodename="pore" /><input name="in2" type="float" value="0.45" /></multiply>
    <mix name="mix_94" type="color3"><input name="bg" type="color3" value="1.0, 1.0, 1.0" /><input name="fg" type="color3" value="0.62, 0.52, 0.42" /><input name="mix" type="float" nodename="multiply_93" /></mix>
    <multiply name="c1" type="color3"><input name="in1" type="color3" nodename="c0" /><input name="in2" type="color3" nodename="mix_94" /></multiply>
    <smoothstep name="smoothstep_96" type="float"><input name="in" type="float" nodename="bm_ds" /><input name="low" type="float" value="5e-05" /><input name="high" type="float" value="0.0002" /></smoothstep>
    <subtract name="seam_line" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_96" /></subtract>
    <mix name="mix_98" type="color3"><input name="bg" type="color3" value="1.0, 1.0, 1.0" /><input name="fg" type="color3" value="0.8, 0.75, 0.7" /><input name="mix" type="float" nodename="seam_line" /></mix>
    <multiply name="c2" type="color3"><input name="in1" type="color3" nodename="c1" /><input name="in2" type="color3" nodename="mix_98" /></multiply>
    <mix name="base_color" type="color3"><input name="bg" type="color3" value="0.012, 0.011, 0.01" /><input name="fg" type="color3" nodename="c2" /><input name="mix" type="float" nodename="panel" /></mix>
    <!-- true surface (m): reveal -0.8 mm with 0.8 mm arris, panel waviness 0.5 mm at 3/m, lacquer peel 15 um at 120/m -->
    <smoothstep name="smoothstep_101" type="float"><input name="in" type="float" nodename="pn_d" /><input name="low" type="float" value="-0.0004" /><input name="high" type="float" value="0.0008" /></smoothstep>
    <subtract name="subtract_102" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_101" /></subtract>
    <multiply name="h_reveal" type="float"><input name="in1" type="float" nodename="subtract_102" /><input name="in2" type="float" value="-0.0008" /></multiply>
    <multiply name="multiply_104" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="3.0, 3.0" /></multiply>
    <add name="add_105" type="vector2"><input name="in1" type="vector2" nodename="multiply_104" /><input name="in2" type="vector2" value="13.1, 71.3" /></add>
    <fractal2d name="h_wave" type="float"><input name="texcoord" type="vector2" nodename="add_105" /><input name="amplitude" type="float" value="0.0005" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_107" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="120.0, 120.0" /></multiply>
    <add name="add_108" type="vector2"><input name="in1" type="vector2" nodename="multiply_107" /><input name="in2" type="vector2" value="57.7, 21.9" /></add>
    <fractal2d name="h_peel" type="float"><input name="texcoord" type="vector2" nodename="add_108" /><input name="amplitude" type="float" value="1.5e-05" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <add name="add_110" type="float"><input name="in1" type="float" nodename="h_wave" /><input name="in2" type="float" nodename="h_peel" /></add>
    <multiply name="multiply_111" type="float"><input name="in1" type="float" nodename="add_110" /><input name="in2" type="float" nodename="panel" /></multiply>
    <add name="height" type="float"><input name="in1" type="float" nodename="h_reveal" /><input name="in2" type="float" nodename="multiply_111" /></add>
    <!-- fibre pseudo-height (m, base layer only): fiddleback and ribbon fibre tilt, whole-leaf tilt (flips per leaf: light/dark leaves) -->
    <multiply name="fib_fb" type="float"><input name="in1" type="float" nodename="figure" /><input name="in2" type="float" value="0.0025" /></multiply>
    <multiply name="fib_rb" type="float"><input name="in1" type="float" nodename="rb_n" /><input name="in2" type="float" value="0.0035" /></multiply>
    <multiply name="fib_leaf" type="float"><input name="in1" type="float" nodename="bm_a" /><input name="in2" type="float" value="0.035" /></multiply>
    <add name="add_116" type="float"><input name="in1" type="float" nodename="fib_fb" /><input name="in2" type="float" nodename="fib_rb" /></add>
    <add name="add_117" type="float"><input name="in1" type="float" nodename="add_116" /><input name="in2" type="float" nodename="fib_leaf" /></add>
    <multiply name="fibre_h" type="float"><input name="in1" type="float" nodename="add_117" /><input name="in2" type="float" nodename="panel" /></multiply>
    <add name="height_base" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" nodename="fibre_h" /></add>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="base_mm" type="float"><input name="in1" type="float" nodename="height_base" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent_base" type="vector3"><input name="in" type="float" nodename="base_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world_base" type="vector3"><input name="in" type="vector3" nodename="n_tangent_base" /></normalmap>
    <multiply name="coat_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent_coat" type="vector3"><input name="in" type="float" nodename="coat_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world_coat" type="vector3"><input name="in" type="vector3" nodename="n_tangent_coat" /></normalmap>
    <!-- roughness: base (fibre) 0.38 +- band; coat satin lacquer 0.34 +- 0.02; reveal 0.7 -->
    <multiply name="multiply_127" type="float"><input name="in1" type="float" nodename="figure" /><input name="in2" type="float" value="-0.06" /></multiply>
    <add name="add_128" type="float"><input name="in1" type="float" value="0.38" /><input name="in2" type="float" nodename="multiply_127" /></add>
    <mix name="roughness" type="float"><input name="bg" type="float" value="0.7" /><input name="fg" type="float" nodename="add_128" /><input name="mix" type="float" nodename="panel" /></mix>
    <multiply name="multiply_130" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="6.0, 6.0" /></multiply>
    <add name="add_131" type="vector2"><input name="in1" type="vector2" nodename="multiply_130" /><input name="in2" type="vector2" value="5.1, 2.2" /></add>
