    <multiply name="multiply_145" type="float"><input name="in1" type="float" nodename="lipmask" /><input name="in2" type="float" value="-0.01" /></multiply>
    <add name="add_146" type="float"><input name="in1" type="float" nodename="add_144" /><input name="in2" type="float" nodename="multiply_145" /></add>
    <mix name="mix_147" type="float"><input name="bg" type="float" nodename="add_146" /><input name="fg" type="float" value="0.6" /><input name="mix" type="float" nodename="pinm" /></mix>
    <multiply name="multiply_148" type="float"><input name="in1" type="float" nodename="sand" /><input name="in2" type="float" value="0.04" /></multiply>
    <add name="add_149" type="float"><input name="in1" type="float" value="0.9" /><input name="in2" type="float" nodename="multiply_148" /></add>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="add_149" /><input name="fg" type="float" nodename="mix_147" /><input name="mix" type="float" nodename="tile" /></mix>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_subway_gloss" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_subway_gloss" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_subway_gloss" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_subway_gloss" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_subway_gloss" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_subway_gloss" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_subway_gloss" /></surfacematerial>
</materialx>

