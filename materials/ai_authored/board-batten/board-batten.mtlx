    <multiply name="multiply_33" type="float"><input name="in1" type="float" nodename="fractal2d_32" /><input name="in2" type="float" value="0.0018" /></multiply>
    <add name="add_34" type="float"><input name="in1" type="float" nodename="multiply_33" /><input name="in2" type="float" value="0.0045" /></add>
    <max name="caulk_w" type="float"><input name="in1" type="float" nodename="add_34" /><input name="in2" type="float" value="0.003" /></max>
