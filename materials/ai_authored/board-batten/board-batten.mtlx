    <multiply name="multiply_55" type="float"><input name="in1" type="float" nodename="multiply_54" /><input name="in2" type="float" nodename="multiply_54" /></multiply>
    <multiply name="multiply_56" type="float"><input name="in1" type="float" nodename="multiply_55" /><input name="in2" type="float" value="0.5" /></multiply>
    <subtract name="subtract_57" type="float"><input name="in1" type="float" nodename="multiply_53" /><input name="in2" type="float" nodename="multiply_56" /></subtract>
    <subtract name="subtract_58" type="float"><input name="in1" type="float" nodename="divide_50" /><input name="in2" type="float" value="1.0" /></subtract>
