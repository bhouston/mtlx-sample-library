<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Painted board-and-batten wall: 250 mm vertical boards (along V), 50 mm battens 19 mm proud over the seams, deep charcoal-navy exterior satin. UV 0..1 = 1 m, heights in m. Generated by gen.py -->
  <nodegraph name="NG_board_batten">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- layout: boards 250 mm (along V), battens 50 mm over seams -->
    <divide name="us" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="0.25" /></divide>
    <floor name="board_k" type="float"><input name="in" type="float" nodename="us" /></floor>
    <subtract name="subtract_5" type="float"><input name="in1" type="float" nodename="us" /><input name="in2" type="float" nodename="board_k" /></subtract>
    <subtract name="subtract_6" type="float"><input name="in1" type="float" nodename="subtract_5" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="xb" type="float"><input name="in1" type="float" nodename="subtract_6" /><input name="in2" type="float" value="0.25" /></multiply>
    <add name="add_8" type="float"><input name="in1" type="float" nodename="us" /><input name="in2" type="float" value="0.5" /></add>
    <floor name="bat_k" type="float"><input name="in" type="float" nodename="add_8" /></floor>
    <subtract name="subtract_10" type="float"><input name="in1" type="float" nodename="add_8" /><input name="in2" type="float" nodename="bat_k" /></subtract>
    <subtract name="subtract_11" type="float"><input name="in1" type="float" nodename="subtract_10" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="xs" type="float"><input name="in1" type="float" nodename="subtract_11" /><input name="in2" type="float" value="0.25" /></multiply>
    <absval name="d_bat" type="float"><input name="in" type="float" nodename="xs" /></absval>
    <combine2 name="combine2_14" type="vector2"><input name="in1" type="float" nodename="board_k" /><input name="in2" type="float" value="3.0" /></combine2>
    <add name="add_15" type="vector2"><input name="in1" type="vector2" nodename="combine2_14" /><input name="in2" type="vector2" value="0.37, 0.61" /></add>
    <cellnoise2d name="bid0" type="float"><input name="texcoord" type="vector2" nodename="add_15" /></cellnoise2d>
    <combine2 name="combine2_17" type="vector2"><input name="in1" type="float" nodename="board_k" /><input name="in2" type="float" value="14.0" /></combine2>
    <add name="add_18" type="vector2"><input name="in1" type="vector2" nodename="combine2_17" /><input name="in2" type="vector2" value="0.37, 0.61" /></add>
    <cellnoise2d name="bid1" type="float"><input name="texcoord" type="vector2" nodename="add_18" /></cellnoise2d>
    <combine2 name="combine2_20" type="vector2"><input name="in1" type="float" nodename="board_k" /><input name="in2" type="float" value="25.0" /></combine2>
    <add name="add_21" type="vector2"><input name="in1" type="vector2" nodename="combine2_20" /><input name="in2" type="vector2" value="0.37, 0.61" /></add>
