    <input name="specular_roughness" type="float" nodegraph="NG_board_batten" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_board_batten" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_board_batten" output="normal_out" />
