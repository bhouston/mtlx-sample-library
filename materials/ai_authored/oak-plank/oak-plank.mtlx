    <multiply name="multiply_175" type="float"><input name="in1" type="float" nodename="k_r" /><input name="in2" type="float" value="1.0" /></multiply>
    <multiply name="multiply_176" type="float"><input name="in1" type="float" nodename="k_r" /><input name="in2" type="float" value="1.2" /></multiply>
