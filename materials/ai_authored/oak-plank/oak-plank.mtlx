    <add name="add_182" type="vector2"><input name="in1" type="vector2" nodename="multiply_181" /><input name="in2" type="vector2" value="7.1, 3.3" /></add>
    <fractal2d name="fractal2d_183" type="float"><input name="texcoord" type="vector2" nodename="add_182" /><input name="amplitude" type="float" value="0.0006" /><input name="octaves" type="integer" value="1" /></fractal2d>
