    <smoothstep name="smoothstep_165" type="float"><input name="in" type="float" nodename="f_f1" /><input name="low" type="float" value="0.1" /><input name="high" type="float" value="0.25" /></smoothstep>
    <subtract name="subtract_166" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_165" /></subtract>
