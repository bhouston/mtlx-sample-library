<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- oak-plank: wide-plank plain-sawn white oak floor, matte oil. 180 mm rows along U, boards 0.70..1.70 m. UV 0..1 = 1 m, heights in m -->
  <nodegraph name="NG_oak_plank">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- plank layout: 180 mm rows, boards 0.70..1.70 m, staggered >= 96 mm -->
    <divide name="pk_v" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="0.18" /></divide>
    <floor name="pk_row" type="float"><input name="in" type="float" nodename="pk_v" /></floor>
    <subtract name="pk_fv" type="float"><input name="in1" type="float" nodename="pk_v" /><input name="in2" type="float" nodename="pk_row" /></subtract>
    <modulo name="pk_par" type="float"><input name="in1" type="float" nodename="pk_row" /><input name="in2" type="float" value="2.0" /></modulo>
    <divide name="divide_7" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="1.2" /></divide>
    <multiply name="multiply_8" type="float"><input name="in1" type="float" nodename="pk_par" /><input name="in2" type="float" value="0.5" /></multiply>
    <add name="pk_x" type="float"><input name="in1" type="float" nodename="divide_7" /><input name="in2" type="float" nodename="multiply_8" /></add>
    <floor name="pk_k" type="float"><input name="in" type="float" nodename="pk_x" /></floor>
    <subtract name="pk_fx" type="float"><input name="in1" type="float" nodename="pk_x" /><input name="in2" type="float" nodename="pk_k" /></subtract>
    <combine2 name="combine2_12" type="vector2"><input name="in1" type="float" nodename="pk_k" /><input name="in2" type="float" nodename="pk_row" /></combine2>
    <add name="add_13" type="vector2"><input name="in1" type="vector2" nodename="combine2_12" /><input name="in2" type="vector2" value="11.37, 5.61" /></add>
    <cellnoise2d name="cellnoise2d_14" type="float"><input name="texcoord" type="vector2" nodename="add_13" /></cellnoise2d>
    <multiply name="multiply_15" type="float"><input name="in1" type="float" nodename="cellnoise2d_14" /><input name="in2" type="float" value="0.42" /></multiply>
    <add name="pk_j" type="float"><input name="in1" type="float" nodename="multiply_15" /><input name="in2" type="float" value="0.29000000000000004" /></add>
    <ifgreater name="pk_right" type="float"><input name="value1" type="float" nodename="pk_fx" /><input name="value2" type="float" nodename="pk_j" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_18" type="float"><input name="in1" type="float" nodename="pk_right" /><input name="in2" type="float" value="2.0" /></multiply>
    <subtract name="pk_sg" type="float"><input name="in1" type="float" nodename="multiply_18" /><input name="in2" type="float" value="1.0" /></subtract>
    <add name="add_20" type="float"><input name="in1" type="float" nodename="pk_k" /><input name="in2" type="float" nodename="pk_sg" /></add>
    <combine2 name="combine2_21" type="vector2"><input name="in1" type="float" nodename="add_20" /><input name="in2" type="float" nodename="pk_row" /></combine2>
    <add name="add_22" type="vector2"><input name="in1" type="vector2" nodename="combine2_21" /><input name="in2" type="vector2" value="11.37, 5.61" /></add>
    <cellnoise2d name="cellnoise2d_23" type="float"><input name="texcoord" type="vector2" nodename="add_22" /></cellnoise2d>
    <multiply name="multiply_24" type="float"><input name="in1" type="float" nodename="cellnoise2d_23" /><input name="in2" type="float" value="0.42" /></multiply>
    <add name="pk_n0" type="float"><input name="in1" type="float" nodename="multiply_24" /><input name="in2" type="float" value="0.29000000000000004" /></add>
    <add name="pk_n" type="float"><input name="in1" type="float" nodename="pk_n0" /><input name="in2" type="float" nodename="pk_sg" /></add>
    <min name="pk_lo" type="float"><input name="in1" type="float" nodename="pk_j" /><input name="in2" type="float" nodename="pk_n" /></min>
    <max name="pk_hi" type="float"><input name="in1" type="float" nodename="pk_j" /><input name="in2" type="float" nodename="pk_n" /></max>
    <add name="add_29" type="float"><input name="in1" type="float" nodename="pk_lo" /><input name="in2" type="float" nodename="pk_hi" /></add>
    <multiply name="pk_mid" type="float"><input name="in1" type="float" nodename="add_29" /><input name="in2" type="float" value="0.5" /></multiply>
    <subtract name="subtract_31" type="float"><input name="in1" type="float" nodename="pk_hi" /><input name="in2" type="float" nodename="pk_lo" /></subtract>
    <multiply name="pk_len" type="float"><input name="in1" type="float" nodename="subtract_31" /><input name="in2" type="float" value="1.2" /></multiply>
    <subtract name="subtract_33" type="float"><input name="in1" type="float" nodename="pk_fx" /><input name="in2" type="float" nodename="pk_mid" /></subtract>
    <multiply name="pk_lx" type="float"><input name="in1" type="float" nodename="subtract_33" /><input name="in2" type="float" value="1.2" /></multiply>
    <subtract name="subtract_35" type="float"><input name="in1" type="float" nodename="pk_fv" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="pk_ly" type="float"><input name="in1" type="float" nodename="subtract_35" /><input name="in2" type="float" value="0.18" /></multiply>
    <multiply name="multiply_37" type="float"><input name="in1" type="float" nodename="pk_len" /><input name="in2" type="float" value="0.5" /></multiply>
    <combine2 name="pk_half" type="vector2"><input name="in1" type="float" nodename="multiply_37" /><input name="in2" type="float" value="0.09" /></combine2>
    <combine2 name="pk_loc" type="vector2"><input name="in1" type="float" nodename="pk_lx" /><input name="in2" type="float" nodename="pk_ly" /></combine2>
    <absval name="absval_40" type="vector2"><input name="in" type="vector2" nodename="pk_loc" /></absval>
    <subtract name="subtract_41" type="vector2"><input name="in1" type="vector2" nodename="pk_half" /><input name="in2" type="vector2" nodename="absval_40" /></subtract>
    <subtract name="pk_e" type="vector2"><input name="in1" type="vector2" nodename="subtract_41" /><input name="in2" type="float" value="0.0002" /></subtract>
    <separate2 name="pk_es" type="multioutput"><input name="in" type="vector2" nodename="pk_e" /></separate2>
    <min name="pk_d" type="float"><input name="in1" type="float" nodename="pk_es" output="outx" /><input name="in2" type="float" nodename="pk_es" output="outy" /></min>
    <add name="add_45" type="float"><input name="in1" type="float" nodename="pk_k" /><input name="in2" type="float" nodename="pk_right" /></add>
    <combine2 name="pk_cell" type="vector2"><input name="in1" type="float" nodename="add_45" /><input name="in2" type="float" nodename="pk_row" /></combine2>
    <add name="add_47" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="200.37, 300.61" /></add>
    <cellnoise2d name="rb0" type="float"><input name="texcoord" type="vector2" nodename="add_47" /></cellnoise2d>
    <add name="add_49" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="237.5, 312.32" /></add>
    <cellnoise2d name="rb1" type="float"><input name="texcoord" type="vector2" nodename="add_49" /></cellnoise2d>
    <add name="add_51" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="274.63, 324.03000000000003" /></add>
    <cellnoise2d name="rb2" type="float"><input name="texcoord" type="vector2" nodename="add_51" /></cellnoise2d>
    <add name="add_53" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="311.76, 335.74" /></add>
    <cellnoise2d name="rb3" type="float"><input name="texcoord" type="vector2" nodename="add_53" /></cellnoise2d>
    <add name="add_55" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="348.89, 347.45000000000005" /></add>
    <cellnoise2d name="rb4" type="float"><input name="texcoord" type="vector2" nodename="add_55" /></cellnoise2d>
    <add name="add_57" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="386.02, 359.16" /></add>
    <cellnoise2d name="rb5" type="float"><input name="texcoord" type="vector2" nodename="add_57" /></cellnoise2d>
    <add name="add_59" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="423.15000000000003, 370.87" /></add>
    <cellnoise2d name="rb6" type="float"><input name="texcoord" type="vector2" nodename="add_59" /></cellnoise2d>
    <add name="add_61" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="460.28000000000003, 382.58000000000004" /></add>
    <cellnoise2d name="rb7" type="float"><input name="texcoord" type="vector2" nodename="add_61" /></cellnoise2d>
    <add name="add_63" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="497.41, 394.29" /></add>
    <cellnoise2d name="rb8" type="float"><input name="texcoord" type="vector2" nodename="add_63" /></cellnoise2d>
    <add name="add_65" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="534.54, 406.0" /></add>
    <cellnoise2d name="rb9" type="float"><input name="texcoord" type="vector2" nodename="add_65" /></cellnoise2d>
    <add name="add_67" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="571.6700000000001, 417.71000000000004" /></add>
    <cellnoise2d name="rb10" type="float"><input name="texcoord" type="vector2" nodename="add_67" /></cellnoise2d>
    <add name="add_69" type="vector2"><input name="in1" type="vector2" nodename="pk_cell" /><input name="in2" type="vector2" value="608.8, 429.42" /></add>
    <cellnoise2d name="rb11" type="float"><input name="texcoord" type="vector2" nodename="add_69" /></cellnoise2d>
    <combine2 name="combine2_71" type="vector2"><input name="in1" type="float" nodename="rb10" /><input name="in2" type="float" nodename="rb11" /></combine2>
    <multiply name="bseed" type="vector2"><input name="in1" type="vector2" nodename="combine2_71" /><input name="in2" type="vector2" value="97.3, 61.7" /></multiply>
    <!-- knots: ~13% of boards, radius 4..9 mm, elliptical, rings wrap around -->
    <ifgreater name="k_on" type="float"><input name="value1" type="float" nodename="rb5" /><input name="value2" type="float" value="0.87" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
    <multiply name="multiply_74" type="float"><input name="in1" type="float" nodename="rb6" /><input name="in2" type="float" value="0.005" /></multiply>
    <add name="k_r" type="float"><input name="in1" type="float" nodename="multiply_74" /><input name="in2" type="float" value="0.004" /></add>
    <subtract name="subtract_76" type="float"><input name="in1" type="float" nodename="rb7" /><input name="in2" type="float" value="0.5" /></subtract>
    <subtract name="subtract_77" type="float"><input name="in1" type="float" nodename="pk_len" /><input name="in2" type="float" value="0.3" /></subtract>
    <multiply name="k_x" type="float"><input name="in1" type="float" nodename="subtract_76" /><input name="in2" type="float" nodename="subtract_77" /></multiply>
    <subtract name="subtract_79" type="float"><input name="in1" type="float" nodename="rb8" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="k_y" type="float"><input name="in1" type="float" nodename="subtract_79" /><input name="in2" type="float" value="0.12" /></multiply>
    <combine2 name="combine2_81" type="vector2"><input name="in1" type="float" nodename="k_x" /><input name="in2" type="float" nodename="k_y" /></combine2>
    <subtract name="k_q" type="vector2"><input name="in1" type="vector2" nodename="pk_loc" /><input name="in2" type="vector2" nodename="combine2_81" /></subtract>
    <multiply name="multiply_83" type="vector2"><input name="in1" type="vector2" nodename="k_q" /><input name="in2" type="vector2" value="0.7, 1.0" /></multiply>
    <magnitude name="k_rho" type="float"><input name="in" type="vector2" nodename="multiply_83" /></magnitude>
    <multiply name="multiply_85" type="float"><input name="in1" type="float" nodename="k_rho" /><input name="in2" type="float" nodename="k_rho" /></multiply>
    <multiply name="multiply_86" type="float"><input name="in1" type="float" nodename="k_r" /><input name="in2" type="float" nodename="k_r" /></multiply>
    <add name="add_87" type="float"><input name="in1" type="float" nodename="multiply_85" /><input name="in2" type="float" nodename="multiply_86" /></add>
    <divide name="divide_88" type="float"><input name="in1" type="float" nodename="multiply_86" /><input name="in2" type="float" nodename="add_87" /></divide>
    <multiply name="multiply_89" type="float"><input name="in1" type="float" nodename="k_on" /><input name="in2" type="float" value="0.004" /></multiply>
    <multiply name="k_bump" type="float"><input name="in1" type="float" nodename="divide_88" /><input name="in2" type="float" nodename="multiply_89" /></multiply>
    <separate2 name="k_qs" type="multioutput"><input name="in" type="vector2" nodename="k_q" /></separate2>
    <multiply name="multiply_92" type="vector2"><input name="in1" type="vector2" nodename="k_q" /><input name="in2" type="vector2" value="0.4, 1.0" /></multiply>
    <magnitude name="k_rhoe" type="float"><input name="in" type="vector2" nodename="multiply_92" /></magnitude>
    <multiply name="multiply_94" type="float"><input name="in1" type="float" nodename="multiply_86" /><input name="in2" type="float" value="1.6" /></multiply>
    <multiply name="multiply_95" type="float"><input name="in1" type="float" nodename="k_rhoe" /><input name="in2" type="float" nodename="k_rhoe" /></multiply>
    <add name="add_96" type="float"><input name="in1" type="float" nodename="multiply_95" /><input name="in2" type="float" nodename="multiply_86" /></add>
    <divide name="divide_97" type="float"><input name="in1" type="float" nodename="multiply_94" /><input name="in2" type="float" nodename="add_96" /></divide>
    <multiply name="k_def" type="float"><input name="in1" type="float" nodename="divide_97" /><input name="in2" type="float" nodename="k_on" /></multiply>
    <multiply name="multiply_99" type="float"><input name="in1" type="float" nodename="k_qs" output="outy" /><input name="in2" type="float" nodename="k_def" /></multiply>
    <subtract name="k_ly" type="float"><input name="in1" type="float" nodename="pk_ly" /><input name="in2" type="float" nodename="multiply_99" /></subtract>
    <combine2 name="k_loc" type="vector2"><input name="in1" type="float" nodename="pk_lx" /><input name="in2" type="float" nodename="k_ly" /></combine2>
    <add name="lp" type="vector2"><input name="in1" type="vector2" nodename="k_loc" /><input name="in2" type="vector2" nodename="bseed" /></add>
    <subtract name="subtract_103" type="float"><input name="in1" type="float" nodename="rb0" /><input name="in2" type="float" value="0.5" /></subtract>
    <!-- growth rings: pith offset +-11 cm, depth 5..15 cm, taper +-4%, ring pitch 4.5..7.5 mm -->
    <multiply name="g_c" type="float"><input name="in1" type="float" nodename="subtract_103" /><input name="in2" type="float" value="0.22" /></multiply>
    <multiply name="multiply_105" type="float"><input name="in1" type="float" nodename="rb1" /><input name="in2" type="float" value="0.1" /></multiply>
    <add name="g_d0" type="float"><input name="in1" type="float" nodename="multiply_105" /><input name="in2" type="float" value="0.05" /></add>
    <subtract name="subtract_107" type="float"><input name="in1" type="float" nodename="rb2" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="g_s" type="float"><input name="in1" type="float" nodename="subtract_107" /><input name="in2" type="float" value="0.08" /></multiply>
    <subtract name="subtract_109" type="float"><input name="in1" type="float" nodename="rb3" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="g_th" type="float"><input name="in1" type="float" nodename="subtract_109" /><input name="in2" type="float" value="0.03" /></multiply>
    <multiply name="multiply_111" type="float"><input name="in1" type="float" nodename="rb4" /><input name="in2" type="float" value="0.003" /></multiply>
    <add name="g_lam" type="float"><input name="in1" type="float" nodename="multiply_111" /><input name="in2" type="float" value="0.0045" /></add>
    <subtract name="subtract_113" type="float"><input name="in1" type="float" nodename="k_ly" /><input name="in2" type="float" nodename="g_c" /></subtract>
    <multiply name="multiply_114" type="float"><input name="in1" type="float" nodename="pk_lx" /><input name="in2" type="float" nodename="g_th" /></multiply>
    <add name="g_yp" type="float"><input name="in1" type="float" nodename="subtract_113" /><input name="in2" type="float" nodename="multiply_114" /></add>
    <multiply name="multiply_116" type="float"><input name="in1" type="float" nodename="g_s" /><input name="in2" type="float" nodename="pk_lx" /></multiply>
    <add name="g_z" type="float"><input name="in1" type="float" nodename="g_d0" /><input name="in2" type="float" nodename="multiply_116" /></add>
    <combine2 name="combine2_118" type="vector2"><input name="in1" type="float" nodename="g_yp" /><input name="in2" type="float" nodename="g_z" /></combine2>
    <magnitude name="g_R0" type="float"><input name="in" type="vector2" nodename="combine2_118" /></magnitude>
    <multiply name="multiply_120" type="vector2"><input name="in1" type="vector2" nodename="lp" /><input name="in2" type="vector2" value="2.5, 9.0" /></multiply>
    <fractal2d name="g_w1" type="float"><input name="texcoord" type="vector2" nodename="multiply_120" /><input name="amplitude" type="float" value="0.0025" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_122" type="vector2"><input name="in1" type="vector2" nodename="lp" /><input name="in2" type="vector2" value="7.0, 30.0" /></multiply>
    <add name="add_123" type="vector2"><input name="in1" type="vector2" nodename="multiply_122" /><input name="in2" type="vector2" value="5.3, 9.1" /></add>
    <fractal2d name="g_w2" type="float"><input name="texcoord" type="vector2" nodename="add_123" /><input name="amplitude" type="float" value="0.0007" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <add name="add_125" type="float"><input name="in1" type="float" nodename="g_R0" /><input name="in2" type="float" nodename="g_w1" /></add>
    <add name="add_126" type="float"><input name="in1" type="float" nodename="add_125" /><input name="in2" type="float" nodename="g_w2" /></add>
    <add name="g_R" type="float"><input name="in1" type="float" nodename="add_126" /><input name="in2" type="float" nodename="k_bump" /></add>
    <divide name="divide_128" type="float"><input name="in1" type="float" nodename="g_R" /><input name="in2" type="float" nodename="g_lam" /></divide>
    <multiply name="multiply_129" type="float"><input name="in1" type="float" nodename="rb9" /><input name="in2" type="float" value="13.0" /></multiply>
    <add name="g_phase" type="float"><input name="in1" type="float" nodename="divide_128" /><input name="in2" type="float" nodename="multiply_129" /></add>
    <modulo name="g_t" type="float"><input name="in1" type="float" nodename="g_phase" /><input name="in2" type="float" value="1.0" /></modulo>
    <multiply name="multiply_132" type="float"><input name="in1" type="float" nodename="g_s" /><input name="in2" type="float" nodename="g_z" /></multiply>
    <combine2 name="combine2_133" type="vector2"><input name="in1" type="float" nodename="g_yp" /><input name="in2" type="float" nodename="multiply_132" /></combine2>
    <magnitude name="magnitude_134" type="float"><input name="in" type="vector2" nodename="combine2_133" /></magnitude>
    <multiply name="multiply_135" type="float"><input name="in1" type="float" nodename="g_R0" /><input name="in2" type="float" nodename="g_lam" /></multiply>
    <divide name="g_f" type="float"><input name="in1" type="float" nodename="magnitude_134" /><input name="in2" type="float" nodename="multiply_135" /></divide>
    <smoothstep name="smoothstep_137" type="float"><input name="in" type="float" nodename="g_f" /><input name="low" type="float" value="45.0" /><input name="high" type="float" value="90.0" /></smoothstep>
    <subtract name="subtract_138" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_137" /></subtract>
    <smoothstep name="smoothstep_139" type="float"><input name="in" type="float" nodename="g_t" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.12" /></smoothstep>
    <smoothstep name="smoothstep_140" type="float"><input name="in" type="float" nodename="g_t" /><input name="low" type="float" value="0.25" /><input name="high" type="float" value="0.55" /></smoothstep>
    <subtract name="subtract_141" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_140" /></subtract>
    <multiply name="g_ew" type="float"><input name="in1" type="float" nodename="smoothstep_139" /><input name="in2" type="float" nodename="subtract_141" /></multiply>
    <mix name="g_fig" type="float"><input name="bg" type="float" value="0.34" /><input name="fg" type="float" nodename="g_ew" /><input name="mix" type="float" nodename="subtract_138" /></mix>
    <!-- open pores: ~2 x 0.2 mm dashes, dense in earlywood, sparse in latewood -->
    <multiply name="p_p" type="vector2"><input name="in1" type="vector2" nodename="lp" /><input name="in2" type="vector2" value="180.0, 2600.0" /></multiply>
    <worleynoise2d name="p_f1" type="float"><input name="texcoord" type="vector2" nodename="p_p" /><input name="jitter" type="float" value="1.0" /></worleynoise2d>
