    <!-- tone: honey..light tan per board, ~10% darker boards -->
    <mix name="t_bc0" type="color3"><input name="bg" type="color3" value="0.5, 0.28, 0.11" /><input name="fg" type="color3" value="0.58, 0.36, 0.17" /><input name="mix" type="float" nodename="rb10" /></mix>
    <ifgreater name="ifgreater_199" type="float"><input name="value1" type="float" nodename="rb11" /><input name="value2" type="float" value="0.9" /><input name="in1" type="float" value="1.0" /><input name="in2" type="float" value="0.0" /></ifgreater>
