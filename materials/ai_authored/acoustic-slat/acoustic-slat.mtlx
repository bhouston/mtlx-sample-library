<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Acoustic slat wall panel: 27 mm light oak veneer slats on a 40 mm pitch over black felt. UV 0..1 = 1 m, heights in meters. Generated by gen.py. -->
  <nodegraph name="NG_acoustic_slat">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- layout: slats along V, 27 mm on a 40 mm pitch; sl_y = m across from the slat centre, sl_d = m to the slat edge (+ on the face) -->
    <divide name="sl_s" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="0.04" /></divide>
    <floor name="sl_k" type="float"><input name="in" type="float" nodename="sl_s" /></floor>
    <subtract name="subtract_5" type="float"><input name="in1" type="float" nodename="sl_s" /><input name="in2" type="float" nodename="sl_k" /></subtract>
    <subtract name="subtract_6" type="float"><input name="in1" type="float" nodename="subtract_5" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="sl_y" type="float"><input name="in1" type="float" nodename="subtract_6" /><input name="in2" type="float" value="0.04" /></multiply>
    <absval name="absval_8" type="float"><input name="in" type="float" nodename="sl_y" /></absval>
    <subtract name="sl_d" type="float"><input name="in1" type="float" value="0.0135" /><input name="in2" type="float" nodename="absval_8" /></subtract>
    <combine2 name="combine2_10" type="vector2"><input name="in1" type="float" nodename="sl_k" /><input name="in2" type="float" value="0.0" /></combine2>
    <add name="add_11" type="vector2"><input name="in1" type="vector2" nodename="combine2_10" /><input name="in2" type="vector2" value="200.37, 300.61" /></add>
    <cellnoise2d name="sl_id" type="float"><input name="texcoord" type="vector2" nodename="add_11" /></cellnoise2d>
    <multiply name="multiply_13" type="float"><input name="in1" type="float" nodename="sl_id" /><input name="in2" type="float" value="22.105" /></multiply>
    <add name="add_14" type="float"><input name="in1" type="float" nodename="multiply_13" /><input name="in2" type="float" value="0.61" /></add>
    <fract name="sl_r1" type="float"><input name="in" type="float" nodename="add_14" /></fract>
    <multiply name="multiply_16" type="float"><input name="in1" type="float" nodename="sl_id" /><input name="in2" type="float" value="46.964" /></multiply>
    <add name="add_17" type="float"><input name="in1" type="float" nodename="multiply_16" /><input name="in2" type="float" value="0.61" /></add>
    <fract name="sl_r2" type="float"><input name="in" type="float" nodename="add_17" /></fract>
    <multiply name="multiply_19" type="float"><input name="in1" type="float" nodename="sl_id" /><input name="in2" type="float" value="77.135" /></multiply>
    <add name="add_20" type="float"><input name="in1" type="float" nodename="multiply_19" /><input name="in2" type="float" value="0.61" /></add>
    <fract name="sl_r3" type="float"><input name="in" type="float" nodename="add_20" /></fract>
    <multiply name="multiply_22" type="float"><input name="in1" type="float" nodename="sl_id" /><input name="in2" type="float" value="114.841" /></multiply>
    <add name="add_23" type="float"><input name="in1" type="float" nodename="multiply_22" /><input name="in2" type="float" value="0.61" /></add>
    <fract name="sl_r4" type="float"><input name="in" type="float" nodename="add_23" /></fract>
    <multiply name="multiply_25" type="float"><input name="in1" type="float" nodename="sl_id" /><input name="in2" type="float" value="157.152" /></multiply>
    <add name="add_26" type="float"><input name="in1" type="float" nodename="multiply_25" /><input name="in2" type="float" value="0.61" /></add>
    <fract name="sl_r5" type="float"><input name="in" type="float" nodename="add_26" /></fract>
    <!-- veneer frame: gp = (across, along) in the shared flitch; per slat shift 0..6 mm across, 0..0.4 m along, run-out +-0.3% -->
    <subtract name="subtract_28" type="float"><input name="in1" type="float" nodename="sl_r1" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_29" type="float"><input name="in1" type="float" nodename="subtract_28" /><input name="in2" type="float" value="0.006" /></multiply>
    <add name="add_30" type="float"><input name="in1" type="float" nodename="sl_y" /><input name="in2" type="float" nodename="multiply_29" /></add>
    <subtract name="subtract_31" type="float"><input name="in1" type="float" nodename="sl_r2" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_32" type="float"><input name="in1" type="float" nodename="subtract_31" /><input name="in2" type="float" value="0.006" /></multiply>
    <multiply name="multiply_33" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" nodename="multiply_32" /></multiply>
    <add name="vf_y" type="float"><input name="in1" type="float" nodename="add_30" /><input name="in2" type="float" nodename="multiply_33" /></add>
    <multiply name="multiply_35" type="float"><input name="in1" type="float" nodename="sl_r3" /><input name="in2" type="float" value="0.4" /></multiply>
    <add name="add_36" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" nodename="multiply_35" /></add>
    <combine2 name="gp" type="vector2"><input name="in1" type="float" nodename="vf_y" /><input name="in2" type="float" nodename="add_36" /></combine2>
    <combine2 name="combine2_38" type="vector2"><input name="in1" type="float" nodename="sl_r4" /><input name="in2" type="float" nodename="sl_r5" /></combine2>
    <multiply name="multiply_39" type="vector2"><input name="in1" type="vector2" nodename="combine2_38" /><input name="in2" type="vector2" value="37.1, 53.3" /></multiply>
    <add name="gp_mis" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" nodename="multiply_39" /></add>
    <!-- rift oak grain: broad streaks, grain bands, fibre, pore dashes -->
    <multiply name="multiply_41" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="60.0, 1.5" /></multiply>
    <add name="add_42" type="vector2"><input name="in1" type="vector2" nodename="multiply_41" /><input name="in2" type="vector2" value="3.1, 7.9" /></add>
    <fractal2d name="gr_str" type="float"><input name="texcoord" type="vector2" nodename="add_42" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <multiply name="multiply_44" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="380.0, 1.0" /></multiply>
    <add name="add_45" type="vector2"><input name="in1" type="vector2" nodename="multiply_44" /><input name="in2" type="vector2" value="29.6, 15.2" /></add>
    <fractal2d name="gr_b0" type="float"><input name="texcoord" type="vector2" nodename="add_45" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_47" type="vector2"><input name="in1" type="vector2" nodename="gp_mis" /><input name="in2" type="vector2" value="380.0, 1.0" /></multiply>
    <add name="add_48" type="vector2"><input name="in1" type="vector2" nodename="multiply_47" /><input name="in2" type="vector2" value="11.3, 5.7" /></add>
    <fractal2d name="gr_bm" type="float"><input name="texcoord" type="vector2" nodename="add_48" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_50" type="float"><input name="in1" type="float" nodename="gr_b0" /><input name="in2" type="float" value="0.85" /></multiply>
    <multiply name="multiply_51" type="float"><input name="in1" type="float" nodename="gr_bm" /><input name="in2" type="float" value="0.3" /></multiply>
    <add name="gr_bnd" type="float"><input name="in1" type="float" nodename="multiply_50" /><input name="in2" type="float" nodename="multiply_51" /></add>
    <multiply name="multiply_53" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="110.0, 0.8" /></multiply>
    <add name="add_54" type="vector2"><input name="in1" type="vector2" nodename="multiply_53" /><input name="in2" type="vector2" value="5.2, 19.4" /></add>
    <fractal2d name="gr_int" type="float"><input name="texcoord" type="vector2" nodename="add_54" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <smoothstep name="smoothstep_56" type="float"><input name="in" type="float" nodename="gr_bnd" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.22" /></smoothstep>
    <smoothstep name="smoothstep_57" type="float"><input name="in" type="float" nodename="gr_int" /><input name="low" type="float" value="-0.5" /><input name="high" type="float" value="0.1" /></smoothstep>
    <multiply name="gr_late" type="float"><input name="in1" type="float" nodename="smoothstep_56" /><input name="in2" type="float" nodename="smoothstep_57" /></multiply>
    <multiply name="multiply_59" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="40.0, 900.0" /></multiply>
    <add name="add_60" type="vector2"><input name="in1" type="vector2" nodename="multiply_59" /><input name="in2" type="vector2" value="2.3, 4.1" /></add>
    <fractal2d name="gr_fib" type="float"><input name="texcoord" type="vector2" nodename="add_60" /><input name="amplitude" type="float" value="0.08" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <multiply name="multiply_62" type="vector2"><input name="in1" type="vector2" nodename="gp" /><input name="in2" type="vector2" value="2600.0, 180.0" /></multiply>
    <add name="wp_p" type="vector2"><input name="in1" type="vector2" nodename="multiply_62" /><input name="in2" type="vector2" value="0.37, 0.61" /></add>
    <worleynoise2d name="wp_f1" type="float"><input name="texcoord" type="vector2" nodename="wp_p" /><input name="jitter" type="float" value="1.0" /></worleynoise2d>
    <smoothstep name="smoothstep_65" type="float"><input name="in" type="float" nodename="wp_f1" /><input name="low" type="float" value="0.1" /><input name="high" type="float" value="0.22" /></smoothstep>
    <subtract name="subtract_66" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_65" /></subtract>
    <multiply name="multiply_67" type="float"><input name="in1" type="float" nodename="gr_late" /><input name="in2" type="float" value="0.8" /></multiply>
    <subtract name="subtract_68" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="multiply_67" /></subtract>
    <multiply name="wp_pore" type="float"><input name="in1" type="float" nodename="subtract_66" /><input name="in2" type="float" nodename="subtract_68" /></multiply>
    <smoothstep name="m_face" type="float"><input name="in" type="float" nodename="sl_d" /><input name="low" type="float" value="-0.0007" /><input name="high" type="float" value="0.0002" /></smoothstep>
    <smoothstep name="smoothstep_71" type="float"><input name="in" type="float" nodename="sl_d" /><input name="low" type="float" value="-0.0038" /><input name="high" type="float" value="-0.0018" /></smoothstep>
    <subtract name="m_felt" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_71" /></subtract>
    <multiply name="multiply_73" type="float"><input name="in1" type="float" nodename="sl_d" /><input name="in2" type="float" value="-1.0" /></multiply>
    <max name="m_gapd" type="float"><input name="in1" type="float" nodename="multiply_73" /><input name="in2" type="float" value="0.0" /></max>
    <smoothstep name="smoothstep_75" type="float"><input name="in" type="float" nodename="m_gapd" /><input name="low" type="float" value="0.0015" /><input name="high" type="float" value="0.0065" /></smoothstep>
    <multiply name="multiply_76" type="float"><input name="in1" type="float" nodename="smoothstep_75" /><input name="in2" type="float" value="0.6" /></multiply>
    <add name="m_ao" type="float"><input name="in1" type="float" nodename="multiply_76" /><input name="in2" type="float" value="0.4" /></add>
    <!-- colour: light natural oak, +-4% per slat, 1.5/m drift; side walls oak in shadow; felt near-black blue-grey -->
    <mix name="c_oak0" type="color3"><input name="bg" type="color3" value="0.54, 0.37, 0.2" /><input name="fg" type="color3" value="0.6, 0.42, 0.24" /><input name="mix" type="float" nodename="sl_r4" /></mix>
    <multiply name="multiply_79" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1.5" /></multiply>
    <add name="add_80" type="vector2"><input name="in1" type="vector2" nodename="multiply_79" /><input name="in2" type="vector2" value="4.4, 7.7" /></add>
    <noise2d name="c_drift" type="float"><input name="texcoord" type="vector2" nodename="add_80" /><input name="amplitude" type="float" value="0.06" /><input name="pivot" type="float" value="1.0" /></noise2d>
    <multiply name="multiply_82" type="float"><input name="in1" type="float" nodename="gr_str" /><input name="in2" type="float" value="0.09" /></multiply>
    <add name="add_83" type="float"><input name="in1" type="float" nodename="multiply_82" /><input name="in2" type="float" nodename="gr_fib" /></add>
    <subtract name="subtract_84" type="float"><input name="in1" type="float" nodename="sl_r5" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_85" type="float"><input name="in1" type="float" nodename="subtract_84" /><input name="in2" type="float" value="0.08" /></multiply>
    <add name="add_86" type="float"><input name="in1" type="float" nodename="multiply_85" /><input name="in2" type="float" value="1.0" /></add>
    <add name="c_tone" type="float"><input name="in1" type="float" nodename="add_83" /><input name="in2" type="float" nodename="add_86" /></add>
    <multiply name="multiply_88" type="float"><input name="in1" type="float" nodename="c_tone" /><input name="in2" type="float" nodename="c_drift" /></multiply>
    <multiply name="c_oak1" type="color3"><input name="in1" type="color3" nodename="c_oak0" /><input name="in2" type="float" nodename="multiply_88" /></multiply>
    <mix name="mix_90" type="color3"><input name="bg" type="color3" value="1.0, 1.0, 1.0" /><input name="fg" type="color3" value="0.66, 0.55, 0.44" /><input name="mix" type="float" nodename="gr_late" /></mix>
    <multiply name="c_oak2" type="color3"><input name="in1" type="color3" nodename="c_oak1" /><input name="in2" type="color3" nodename="mix_90" /></multiply>
    <multiply name="multiply_92" type="float"><input name="in1" type="float" nodename="wp_pore" /><input name="in2" type="float" value="0.55" /></multiply>
    <mix name="mix_93" type="color3"><input name="bg" type="color3" value="1.0, 1.0, 1.0" /><input name="fg" type="color3" value="0.5, 0.44, 0.38" /><input name="mix" type="float" nodename="multiply_92" /></mix>
    <multiply name="c_oak" type="color3"><input name="in1" type="color3" nodename="c_oak2" /><input name="in2" type="color3" nodename="mix_93" /></multiply>
    <multiply name="c_side" type="color3"><input name="in1" type="color3" nodename="c_oak" /><input name="in2" type="float" value="0.3" /></multiply>
    <multiply name="multiply_96" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1100.0" /></multiply>
    <add name="add_97" type="vector2"><input name="in1" type="vector2" nodename="multiply_96" /><input name="in2" type="vector2" value="13.7, 2.9" /></add>
    <fractal2d name="f_n1" type="float"><input name="texcoord" type="vector2" nodename="add_97" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="2" /></fractal2d>
    <multiply name="multiply_99" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="3000.0" /></multiply>
    <add name="add_100" type="vector2"><input name="in1" type="vector2" nodename="multiply_99" /><input name="in2" type="vector2" value="7.3, 21.1" /></add>
    <fractal2d name="f_n2" type="float"><input name="texcoord" type="vector2" nodename="add_100" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <rotate2d name="rotate2d_102" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="35" /></rotate2d>
    <multiply name="multiply_103" type="vector2"><input name="in1" type="vector2" nodename="rotate2d_102" /><input name="in2" type="vector2" value="300.0, 4000.0" /></multiply>
    <add name="add_104" type="vector2"><input name="in1" type="vector2" nodename="multiply_103" /><input name="in2" type="vector2" value="3.3, 8.1" /></add>
    <fractal2d name="fractal2d_105" type="float"><input name="texcoord" type="vector2" nodename="add_104" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <smoothstep name="smoothstep_106" type="float"><input name="in" type="float" nodename="fractal2d_105" /><input name="low" type="float" value="0.5" /><input name="high" type="float" value="0.65" /></smoothstep>
    <rotate2d name="rotate2d_107" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="-50" /></rotate2d>
    <multiply name="multiply_108" type="vector2"><input name="in1" type="vector2" nodename="rotate2d_107" /><input name="in2" type="vector2" value="300.0, 4000.0" /></multiply>
    <add name="add_109" type="vector2"><input name="in1" type="vector2" nodename="multiply_108" /><input name="in2" type="vector2" value="9.9, 1.7" /></add>
    <fractal2d name="fractal2d_110" type="float"><input name="texcoord" type="vector2" nodename="add_109" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <smoothstep name="smoothstep_111" type="float"><input name="in" type="float" nodename="fractal2d_110" /><input name="low" type="float" value="0.5" /><input name="high" type="float" value="0.65" /></smoothstep>
    <max name="max_112" type="float"><input name="in1" type="float" nodename="smoothstep_106" /><input name="in2" type="float" nodename="smoothstep_111" /></max>
    <rotate2d name="rotate2d_113" type="vector2"><input name="in" type="vector2" nodename="uv" /><input name="amount" type="float" value="100" /></rotate2d>
    <multiply name="multiply_114" type="vector2"><input name="in1" type="vector2" nodename="rotate2d_113" /><input name="in2" type="vector2" value="300.0, 4000.0" /></multiply>
    <add name="add_115" type="vector2"><input name="in1" type="vector2" nodename="multiply_114" /><input name="in2" type="vector2" value="4.4, 6.6" /></add>
    <fractal2d name="fractal2d_116" type="float"><input name="texcoord" type="vector2" nodename="add_115" /><input name="amplitude" type="float" value="1.0" /><input name="octaves" type="integer" value="1" /></fractal2d>
    <smoothstep name="smoothstep_117" type="float"><input name="in" type="float" nodename="fractal2d_116" /><input name="low" type="float" value="0.5" /><input name="high" type="float" value="0.65" /></smoothstep>
    <max name="max_118" type="float"><input name="in1" type="float" nodename="max_112" /><input name="in2" type="float" nodename="smoothstep_117" /></max>
    <multiply name="f_strand" type="float"><input name="in1" type="float" nodename="max_118" /><input name="in2" type="float" value="0.6" /></multiply>
    <multiply name="multiply_120" type="float"><input name="in1" type="float" nodename="f_n2" /><input name="in2" type="float" value="0.7" /></multiply>
    <add name="add_121" type="float"><input name="in1" type="float" nodename="f_n1" /><input name="in2" type="float" nodename="multiply_120" /></add>
    <smoothstep name="smoothstep_122" type="float"><input name="in" type="float" nodename="add_121" /><input name="low" type="float" value="-0.3" /><input name="high" type="float" value="0.7" /></smoothstep>
    <multiply name="multiply_123" type="float"><input name="in1" type="float" nodename="smoothstep_122" /><input name="in2" type="float" value="0.55" /></multiply>
    <max name="f_fibre" type="float"><input name="in1" type="float" nodename="multiply_123" /><input name="in2" type="float" nodename="f_strand" /></max>
    <mix name="c_felt0" type="color3"><input name="bg" type="color3" value="0.017, 0.018, 0.02" /><input name="fg" type="color3" value="0.042, 0.045, 0.052" /><input name="mix" type="float" nodename="f_fibre" /></mix>
    <multiply name="c_felt" type="color3"><input name="in1" type="color3" nodename="c_felt0" /><input name="in2" type="float" nodename="m_ao" /></multiply>
    <mix name="c_wall" type="color3"><input name="bg" type="color3" nodename="c_side" /><input name="fg" type="color3" nodename="c_oak" /><input name="mix" type="float" nodename="m_face" /></mix>
    <mix name="base_color" type="color3"><input name="bg" type="color3" nodename="c_wall" /><input name="fg" type="color3" nodename="c_felt" /><input name="mix" type="float" nodename="m_felt" /></mix>
    <subtract name="subtract_129" type="float"><input name="in1" type="float" nodename="sl_r1" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="multiply_130" type="float"><input name="in1" type="float" nodename="subtract_129" /><input name="in2" type="float" value="0.05" /></multiply>
    <add name="add_131" type="float"><input name="in1" type="float" nodename="multiply_130" /><input name="in2" type="float" value="0.52" /></add>
    <multiply name="multiply_132" type="float"><input name="in1" type="float" nodename="wp_pore" /><input name="in2" type="float" value="0.08" /></multiply>
    <multiply name="multiply_133" type="float"><input name="in1" type="float" nodename="gr_late" /><input name="in2" type="float" value="-0.03" /></multiply>
    <add name="add_134" type="float"><input name="in1" type="float" nodename="multiply_132" /><input name="in2" type="float" nodename="multiply_133" /></add>
    <add name="r_face" type="float"><input name="in1" type="float" nodename="add_131" /><input name="in2" type="float" nodename="add_134" /></add>
    <mix name="r_wall" type="float"><input name="bg" type="float" value="0.65" /><input name="fg" type="float" nodename="r_face" /><input name="mix" type="float" nodename="m_face" /></mix>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="r_wall" /><input name="fg" type="float" value="1.0" /><input name="mix" type="float" nodename="m_felt" /></mix>
    <mix name="specular" type="float"><input name="bg" type="float" value="0.5" /><input name="fg" type="float" value="0.2" /><input name="mix" type="float" nodename="m_felt" /></mix>
    <!-- height: slat profile 4 mm, veneer relief (latewood +5 um, pores -15 um), felt fuzz 0.12 mm in the channel -->
    <smoothstep name="smoothstep_139" type="float"><input name="in" type="float" nodename="sl_d" /><input name="low" type="float" value="-0.0055" /><input name="high" type="float" value="0.0008" /></smoothstep>
    <multiply name="h_prof" type="float"><input name="in1" type="float" nodename="smoothstep_139" /><input name="in2" type="float" value="0.004" /></multiply>
    <multiply name="multiply_141" type="float"><input name="in1" type="float" nodename="gr_late" /><input name="in2" type="float" value="5e-06" /></multiply>
    <multiply name="multiply_142" type="float"><input name="in1" type="float" nodename="wp_pore" /><input name="in2" type="float" value="-1.5e-05" /></multiply>
    <add name="add_143" type="float"><input name="in1" type="float" nodename="multiply_141" /><input name="in2" type="float" nodename="multiply_142" /></add>
    <multiply name="h_ven" type="float"><input name="in1" type="float" nodename="add_143" /><input name="in2" type="float" nodename="m_face" /></multiply>
    <multiply name="multiply_145" type="float"><input name="in1" type="float" nodename="f_n2" /><input name="in2" type="float" value="0.4" /></multiply>
    <add name="add_146" type="float"><input name="in1" type="float" nodename="f_n1" /><input name="in2" type="float" nodename="multiply_145" /></add>
    <multiply name="multiply_147" type="float"><input name="in1" type="float" nodename="add_146" /><input name="in2" type="float" value="3e-05" /></multiply>
    <multiply name="h_felt" type="float"><input name="in1" type="float" nodename="multiply_147" /><input name="in2" type="float" nodename="m_felt" /></multiply>
    <add name="add_149" type="float"><input name="in1" type="float" nodename="h_prof" /><input name="in2" type="float" nodename="h_ven" /></add>
    <add name="height" type="float"><input name="in1" type="float" nodename="add_149" /><input name="in2" type="float" nodename="h_felt" /></add>
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>
    <constant name="metalness" type="float"><input name="value" type="float" value="0.0" /></constant>
    <output name="specular_out" type="float" nodename="specular" />
    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_acoustic_slat" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_acoustic_slat" output="base_color_out" />
    <input name="specular" type="float" nodegraph="NG_acoustic_slat" output="specular_out" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_acoustic_slat" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_acoustic_slat" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_acoustic_slat" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_acoustic_slat" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_acoustic_slat" /></surfacematerial>
</materialx>

