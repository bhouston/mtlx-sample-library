    <smoothstep name="smoothstep_81" type="float"><input name="in" type="float" nodename="absval_80" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.25" /></smoothstep>
    <subtract name="subtract_82" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_81" /></subtract>
