    <absval name="absval_12" type="float"><input name="in" type="float" nodename="ly" /></absval>
    <subtract name="subtract_13" type="float"><input name="in1" type="float" nodename="absval_11" /><input name="in2" type="float" value="0.2" /></subtract>
    <subtract name="subtract_14" type="float"><input name="in1" type="float" nodename="absval_12" /><input name="in2" type="float" value="0.3" /></subtract>
    <max name="d_edge" type="float"><input name="in1" type="float" nodename="subtract_13" /><input name="in2" type="float" nodename="subtract_14" /></max>
    <add name="add_16" type="float"><input name="in1" type="float" nodename="divide_3" /><input name="in2" type="float" value="0.5" /></add>
