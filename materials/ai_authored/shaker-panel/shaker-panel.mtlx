    <multiply name="multiply_74" type="float"><input name="in1" type="float" nodename="subtract_73" /><input name="in2" type="float" value="110.0" /></multiply>
    <multiply name="multiply_75" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="2.2" /></multiply>
    <combine2 name="combine2_76" type="vector2"><input name="in1" type="float" nodename="multiply_74" /><input name="in2" type="float" nodename="multiply_75" /></combine2>
    <multiply name="multiply_77" type="vector2"><input name="in1" type="vector2" value="37.3, 11.1" /><input name="in2" type="float" nodename="stile_rand" /></multiply>
    <add name="add_78" type="vector2"><input name="in1" type="vector2" nodename="combine2_76" /><input name="in2" type="vector2" nodename="multiply_77" /></add>
