    <max name="max_28" type="float"><input name="in1" type="float" nodename="subtract_27" /><input name="in2" type="float" value="0.0" /></max>
    <divide name="divide_29" type="float"><input name="in1" type="float" nodename="max_28" /><input name="in2" type="float" value="0.002" /></divide>
