    <subtract name="subtract_54" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="smoothstep_53" /></subtract>
    <smoothstep name="smoothstep_55" type="float"><input name="in" type="float" nodename="subtract_14" /><input name="low" type="float" value="0.0005" /><input name="high" type="float" value="0.002" /></smoothstep>
    <multiply name="joint_core" type="float"><input name="in1" type="float" nodename="subtract_54" /><input name="in2" type="float" nodename="smoothstep_55" /></multiply>
    <multiply name="multiply_57" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="3.3, 300" /></multiply>
    <add name="add_58" type="vector2"><input name="in1" type="vector2" nodename="multiply_57" /><input name="in2" type="vector2" value="0.37, 5.21" /></add>
