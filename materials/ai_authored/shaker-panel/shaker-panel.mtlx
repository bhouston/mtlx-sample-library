    <input name="specular_roughness" type="float" nodegraph="NG_shaker_panel" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_shaker_panel" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_shaker_panel" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_shaker_panel" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_shaker_panel" /></surfacematerial>
</materialx>

