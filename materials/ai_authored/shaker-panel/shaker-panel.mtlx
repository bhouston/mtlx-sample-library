  <standard_surface name="SR_shaker_panel" type="surfaceshader">
    <input name="base" type="float" value="1.0" />
    <input name="base_color" type="color3" nodegraph="NG_shaker_panel" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
