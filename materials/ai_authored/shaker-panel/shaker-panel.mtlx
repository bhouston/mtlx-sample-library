    <noise2d name="noise2d_69" type="float"><input name="texcoord" type="vector2" nodename="add_68" /><input name="amplitude" type="float" value="6e-06" /></noise2d>
    <add name="add_70" type="float"><input name="in1" type="float" nodename="noise2d_66" /><input name="in2" type="float" nodename="noise2d_69" /></add>
