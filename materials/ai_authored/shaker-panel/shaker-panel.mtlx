<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Painted Shaker wainscot: 400 x 600 mm recessed panels, 70 mm rails/stiles, 8 mm square step with eased arris, satin sage-green enamel with brush marks, joints, faint stile grain and dust nibs. UV 0..1 = 1 m, heights in m. -->
  <nodegraph name="NG_shaker_panel">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <divide name="divide_3" type="float"><input name="in1" type="float" nodename="uv_sep" output="outx" /><input name="in2" type="float" value="0.47" /></divide>
    <divide name="divide_4" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="0.67" /></divide>
