    <add name="add_18" type="float"><input name="in1" type="float" nodename="stile_id" /><input name="in2" type="float" value="200.37" /></add>
    <combine2 name="combine2_19" type="vector2"><input name="in1" type="float" nodename="add_18" /><input name="in2" type="float" value="300.61" /></combine2>
    <cellnoise2d name="stile_rand" type="float"><input name="texcoord" type="vector2" nodename="combine2_19" /></cellnoise2d>
    <smoothstep name="stile" type="float"><input name="in" type="float" nodename="subtract_13" /><input name="low" type="float" value="-0.0002" /><input name="high" type="float" value="0.0002" /></smoothstep>
    <subtract name="subtract_22" type="float"><input name="in1" type="float" value="1.0" /><input name="in2" type="float" nodename="stile" /></subtract>
    <smoothstep name="smoothstep_23" type="float"><input name="in" type="float" nodename="subtract_14" /><input name="low" type="float" value="-0.0002" /><input name="high" type="float" value="0.0002" /></smoothstep>
    <multiply name="rail" type="float"><input name="in1" type="float" nodename="subtract_22" /><input name="in2" type="float" nodename="smoothstep_23" /></multiply>
    <multiply name="multiply_25" type="float"><input name="in1" type="float" nodename="d_edge" /><input name="in2" type="float" value="2.0" /></multiply>
