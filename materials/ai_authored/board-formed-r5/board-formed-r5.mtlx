<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Board-formed concrete wall: 150 mm rough-sawn pine boards along U with grain imprint, knots, kerf marks, 1-2 mm seam lips and paste fins, per-board tone, mottling, bug holes, 25 mm cone tie holes on a 500 mm grid. UV 0..1 = 1 m; generated by gen.py -->
  <nodegraph name="NG_board_formed">
    <texcoord name="uv" type="vector2"></texcoord>
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <!-- Board rows: 150 mm along V. rv = v / 0.15 -->
    <multiply name="multiply_3" type="float"><input name="in1" type="float" nodename="uv_sep" output="outy" /><input name="in2" type="float" value="6.666666666666667" /></multiply>
