<?xml version="1.0"?>
<materialx version="1.39" colorspace="lin_rec709">
  <!-- Board-formed architectural concrete. Texcoords are meters: UV 0..1 = 1 m.
       Horizontal 15 cm boards run along U; each carries a rough-sawn wood grain imprint. -->
  <nodegraph name="NG_board_formed">
    <texcoord name="uv" type="vector2" />
    <separate2 name="uv_sep" type="multioutput"><input name="in" type="vector2" nodename="uv" /></separate2>
    <dot name="u" type="float"><input name="in" type="float" nodename="uv_sep" output="outx" /></dot>
    <dot name="v" type="float"><input name="in" type="float" nodename="uv_sep" output="outy" /></dot>

    <!-- Boards: 15 cm tall (6.667 per meter). bf = 0..1 across a board, board_c = board index + 0.5. -->
    <multiply name="vb" type="float"><input name="in1" type="float" nodename="v" /><input name="in2" type="float" value="6.6667" /></multiply>
    <floor name="board_id" type="float"><input name="in" type="float" nodename="vb" /></floor>
    <subtract name="bf" type="float"><input name="in1" type="float" nodename="vb" /><input name="in2" type="float" nodename="board_id" /></subtract>
    <add name="board_c" type="float"><input name="in1" type="float" nodename="board_id" /><input name="in2" type="float" value="0.5" /></add>

    <!-- Butt joints: boards are 2.4 m long, each with a random end-joint position along U. -->
    <combine2 name="bkey" type="vector2"><input name="in1" type="float" nodename="board_c" /><input name="in2" type="float" value="0.5" /></combine2>
    <cellnoise2d name="board_rnd" type="float"><input name="texcoord" type="vector2" nodename="bkey" /></cellnoise2d>
    <multiply name="joint_off" type="float"><input name="in1" type="float" nodename="board_rnd" /><input name="in2" type="float" value="2.4" /></multiply>
    <add name="u_seg" type="float"><input name="in1" type="float" nodename="u" /><input name="in2" type="float" nodename="joint_off" /></add>
    <modulo name="u_in_seg" type="float"><input name="in1" type="float" nodename="u_seg" /><input name="in2" type="float" value="2.4" /></modulo>
    <subtract name="u_in_seg_r" type="float"><input name="in1" type="float" value="2.4" /><input name="in2" type="float" nodename="u_in_seg" /></subtract>
    <min name="joint_d" type="float"><input name="in1" type="float" nodename="u_in_seg" /><input name="in2" type="float" nodename="u_in_seg_r" /></min>
    <divide name="seg_f" type="float"><input name="in1" type="float" nodename="u_seg" /><input name="in2" type="float" value="2.4" /></divide>
    <floor name="seg_id" type="float"><input name="in" type="float" nodename="seg_f" /></floor>
    <add name="seg_c" type="float"><input name="in1" type="float" nodename="seg_id" /><input name="in2" type="float" value="20.5" /></add>

    <!-- Per-plank randoms (one plank = one board segment between butt joints). -->
    <combine2 name="pkey" type="vector2"><input name="in1" type="float" nodename="board_c" /><input name="in2" type="float" nodename="seg_c" /></combine2>
    <cellnoise2d name="plank_rnd" type="float"><input name="texcoord" type="vector2" nodename="pkey" /></cellnoise2d>
    <add name="pkey2" type="vector2"><input name="in1" type="vector2" nodename="pkey" /><input name="in2" type="vector2" value="57, 13" /></add>
    <cellnoise2d name="plank_rnd2" type="float"><input name="texcoord" type="vector2" nodename="pkey2" /></cellnoise2d>
    <!-- Per-plank noise offset so each plank's grain field is unrelated to its neighbours. -->
    <multiply name="plank_ofs" type="vector2"><input name="in1" type="vector2" value="37.3, 91.7" /><input name="in2" type="float" nodename="plank_rnd" /></multiply>

    <!-- Seam distance across boards, in meters. -->
    <subtract name="bf_r" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="bf" /></subtract>
    <min name="bf_min" type="float"><input name="in1" type="float" nodename="bf" /><input name="in2" type="float" nodename="bf_r" /></min>
    <multiply name="seam_d" type="float"><input name="in1" type="float" nodename="bf_min" /><input name="in2" type="float" value="0.15" /></multiply>
    <min name="edge_d" type="float"><input name="in1" type="float" nodename="seam_d" /><input name="in2" type="float" nodename="joint_d" /></min>
    <!-- Paste fin where grout leaked into the ~1.5 mm gap between boards. -->
    <smoothstep name="fin_s" type="float"><input name="in" type="float" nodename="edge_d" /><input name="low" type="float" value="0.0006" /><input name="high" type="float" value="0.0022" /></smoothstep>
    <subtract name="fin" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="fin_s" /></subtract>
    <!-- Board offset: each plank sits +-1.5 mm proud, easing to the seam over 4 mm (the lip). -->
    <smoothstep name="lip_ease" type="float"><input name="in" type="float" nodename="edge_d" /><input name="low" type="float" value="0.0" /><input name="high" type="float" value="0.004" /></smoothstep>
    <subtract name="plank_c" type="float"><input name="in1" type="float" nodename="plank_rnd2" /><input name="in2" type="float" value="0.5" /></subtract>
    <multiply name="plank_h" type="float"><input name="in1" type="float" nodename="plank_c" /><input name="in2" type="float" nodename="lip_ease" /></multiply>

    <!-- Grain wander: a broad per-plank warp (~2 cm, cathedral arcs) plus a finer ~1 mm wobble. -->
    <combine2 name="uv_w1s" type="vector2"><input name="in1" type="float" nodename="u" /><input name="in2" type="float" nodename="v" /></combine2>
    <multiply name="uv_w1m" type="vector2"><input name="in1" type="vector2" nodename="uv_w1s" /><input name="in2" type="vector2" value="1.3, 7" /></multiply>
    <add name="uv_w1" type="vector2"><input name="in1" type="vector2" nodename="uv_w1m" /><input name="in2" type="vector2" nodename="plank_ofs" /></add>
    <noise2d name="warp1" type="float"><input name="texcoord" type="vector2" nodename="uv_w1" /><input name="amplitude" type="float" value="0.02" /></noise2d>
    <multiply name="uv_w2m" type="vector2"><input name="in1" type="vector2" nodename="uv_w1s" /><input name="in2" type="vector2" value="9, 45" /></multiply>
    <add name="uv_w2" type="vector2"><input name="in1" type="vector2" nodename="uv_w2m" /><input name="in2" type="vector2" nodename="plank_ofs" /></add>
    <noise2d name="warp2" type="float"><input name="texcoord" type="vector2" nodename="uv_w2" /><input name="amplitude" type="float" value="0.0005" /></noise2d>
    <add name="warp" type="float"><input name="in1" type="float" nodename="warp1" /><input name="in2" type="float" nodename="warp2" /></add>
    <add name="v_warp" type="float"><input name="in1" type="float" nodename="v" /><input name="in2" type="float" nodename="warp" /></add>

    <!-- Knots: one candidate per 33 x 11 cm cell (anisotropic: elongated along the grain), ~20% present.
         Centre offset <= 0.2 cell and bump radius 0.25 cell keep every knot inside its own cell, so none is clipped.
         A smooth bump added to the grain coordinate bends lines around each knot and closes them into rings at its core. -->
    <multiply name="uv_k" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="3, 9" /></multiply>
    <add name="uv_ko" type="vector2"><input name="in1" type="vector2" nodename="uv_k" /><input name="in2" type="vector2" nodename="plank_ofs" /></add>
    <floor name="knot_cell" type="vector2"><input name="in" type="vector2" nodename="uv_ko" /></floor>
    <subtract name="knot_loc0" type="vector2"><input name="in1" type="vector2" nodename="uv_ko" /><input name="in2" type="vector2" nodename="knot_cell" /></subtract>
    <add name="knot_ckx" type="vector2"><input name="in1" type="vector2" nodename="knot_cell" /><input name="in2" type="vector2" value="0.5, 0.5" /></add>
    <cellnoise2d name="knot_rx" type="float"><input name="texcoord" type="vector2" nodename="knot_ckx" /></cellnoise2d>
    <add name="knot_cky" type="vector2"><input name="in1" type="vector2" nodename="knot_ckx" /><input name="in2" type="vector2" value="17, 31" /></add>
    <cellnoise2d name="knot_ry" type="float"><input name="texcoord" type="vector2" nodename="knot_cky" /></cellnoise2d>
    <add name="knot_ckp" type="vector2"><input name="in1" type="vector2" nodename="knot_ckx" /><input name="in2" type="vector2" value="53, 7" /></add>
    <cellnoise2d name="knot_rp" type="float"><input name="texcoord" type="vector2" nodename="knot_ckp" /></cellnoise2d>
    <combine2 name="knot_r2" type="vector2"><input name="in1" type="float" nodename="knot_rx" /><input name="in2" type="float" nodename="knot_ry" /></combine2>
    <!-- centre = 0.5 + (rand - 0.5) * 0.4 -->
    <multiply name="knot_jit" type="vector2"><input name="in1" type="vector2" nodename="knot_r2" /><input name="in2" type="float" value="0.4" /></multiply>
    <add name="knot_ctr" type="vector2"><input name="in1" type="vector2" nodename="knot_jit" /><input name="in2" type="float" value="0.3" /></add>
    <subtract name="knot_loc" type="vector2"><input name="in1" type="vector2" nodename="knot_loc0" /><input name="in2" type="vector2" nodename="knot_ctr" /></subtract>
    <magnitude name="knot_f1" type="float"><input name="in" type="vector2" nodename="knot_loc" /></magnitude>
    <ifgreater name="knot_on" type="float"><input name="value1" type="float" nodename="knot_rp" /><input name="value2" type="float" value="0.8" /><input name="in1" type="float" value="1" /><input name="in2" type="float" value="0" /></ifgreater>
    <!-- Bump: radius 0.25 cell (~8 x 2.7 cm), 12 mm tall in grain-coordinate terms (~3 closed rings). -->
    <smoothstep name="knot_s" type="float"><input name="in" type="float" nodename="knot_f1" /><input name="low" type="float" value="0" /><input name="high" type="float" value="0.25" /></smoothstep>
    <subtract name="knot_b" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="knot_s" /></subtract>
    <multiply name="knot_bump" type="float"><input name="in1" type="float" nodename="knot_b" /><input name="in2" type="float" nodename="knot_on" /></multiply>
    <multiply name="knot_dv" type="float"><input name="in1" type="float" nodename="knot_bump" /><input name="in2" type="float" value="0.012" /></multiply>
    <!-- Dark knot core, ~2.5 x 1.7 cm oval. -->
    <multiply name="core_loc" type="vector2"><input name="in1" type="vector2" nodename="knot_loc" /><input name="in2" type="vector2" value="1, 0.5" /></multiply>
    <magnitude name="core_d" type="float"><input name="in" type="vector2" nodename="core_loc" /></magnitude>
    <smoothstep name="core_s" type="float"><input name="in" type="float" nodename="core_d" /><input name="low" type="float" value="0.04" /><input name="high" type="float" value="0.055" /></smoothstep>
    <subtract name="core_i" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="core_s" /></subtract>
    <multiply name="knot_core" type="float"><input name="in1" type="float" nodename="core_i" /><input name="in2" type="float" nodename="knot_on" /></multiply>
    <!-- Crisp ridge where the knot meets the surrounding wood. -->
    <multiply name="rim_a" type="float"><input name="in1" type="float" nodename="core_i" /><input name="in2" type="float" nodename="core_s" /></multiply>
    <multiply name="rim_b" type="float"><input name="in1" type="float" nodename="rim_a" /><input name="in2" type="float" value="4" /></multiply>
    <multiply name="knot_rim" type="float"><input name="in1" type="float" nodename="rim_b" /><input name="in2" type="float" nodename="knot_on" /></multiply>

    <!-- Grain phase: ~4 mm mean ring spacing (250/m) across the board. -->
    <add name="v_grain" type="float"><input name="in1" type="float" nodename="v_warp" /><input name="in2" type="float" nodename="knot_dv" /></add>
    <!-- Wood-space coordinate (u, v bent by wander and knots): all grain-aligned detail flows around knots. -->
    <combine2 name="uv_wood" type="vector2"><input name="in1" type="float" nodename="u" /><input name="in2" type="float" nodename="v_grain" /></combine2>
    <multiply name="phase0" type="float"><input name="in1" type="float" nodename="v_grain" /><input name="in2" type="float" value="250" /></multiply>
    <!-- Irregular ring widths: a +-1.2 line phase jitter varying every ~1.5 cm across and ~50 cm along the board. -->
    <multiply name="uv_pj" type="vector2"><input name="in1" type="vector2" nodename="uv_wood" /><input name="in2" type="vector2" value="2, 70" /></multiply>
    <add name="uv_pjo" type="vector2"><input name="in1" type="vector2" nodename="uv_pj" /><input name="in2" type="vector2" nodename="plank_ofs" /></add>
    <noise2d name="phase_jit" type="float"><input name="texcoord" type="vector2" nodename="uv_pjo" /><input name="amplitude" type="float" value="1.2" /></noise2d>
    <add name="phase" type="float"><input name="in1" type="float" nodename="phase0" /><input name="in2" type="float" nodename="phase_jit" /></add>
    <multiply name="phase_rad" type="float"><input name="in1" type="float" nodename="phase" /><input name="in2" type="float" value="6.2832" /></multiply>
    <sin name="grain_sin" type="float"><input name="in" type="float" nodename="phase_rad" /></sin>
    <!-- Latewood ridges ~1-1.5 mm wide (narrower lines alias into dashes with derivative normals). -->
    <multiply name="uv_gt" type="vector2"><input name="in1" type="vector2" nodename="uv_wood" /><input name="in2" type="vector2" value="5, 120" /></multiply>
    <noise2d name="gthr" type="float"><input name="texcoord" type="vector2" nodename="uv_gt" /><input name="amplitude" type="float" value="0.3" /><input name="pivot" type="float" value="0.1" /></noise2d>
    <smoothstep name="grain_line" type="float"><input name="in" type="float" nodename="grain_sin" /><input name="low" type="float" nodename="gthr" /><input name="high" type="float" value="0.97" /></smoothstep>
    <!-- Line strength fades in and out along the board (0..1). -->
    <multiply name="uv_ga" type="vector2"><input name="in1" type="vector2" nodename="uv_wood" /><input name="in2" type="vector2" value="6, 25" /></multiply>
    <add name="uv_gao" type="vector2"><input name="in1" type="vector2" nodename="uv_ga" /><input name="in2" type="vector2" nodename="plank_ofs" /></add>
    <noise2d name="grain_amp" type="float"><input name="texcoord" type="vector2" nodename="uv_gao" /><input name="amplitude" type="float" value="0.5" /><input name="pivot" type="float" value="0.5" /></noise2d>
    <multiply name="grain_a" type="float"><input name="in1" type="float" nodename="grain_line" /><input name="in2" type="float" nodename="grain_amp" /></multiply>
    <!-- Some planks print crisper than others (new vs reused boards): x0.5..1.5. -->
    <add name="plank_crisp" type="float"><input name="in1" type="float" nodename="plank_rnd" /><input name="in2" type="float" value="0.5" /></add>
    <multiply name="grain" type="float"><input name="in1" type="float" nodename="grain_a" /><input name="in2" type="float" nodename="plank_crisp" /></multiply>

    <!-- Rough-sawn fibre streaks: ~1 mm across, ~7 mm long. -->
    <multiply name="uv_fib" type="vector2"><input name="in1" type="vector2" nodename="uv_wood" /><input name="in2" type="vector2" value="150, 900" /></multiply>
    <fractal2d name="fiber" type="float"><input name="texcoord" type="vector2" nodename="uv_fib" /><input name="octaves" type="integer" value="3" /></fractal2d>

    <!-- Band-saw marks: faint cross-grain lines every ~1.8 cm, slightly slanted and wavering. -->
    <multiply name="saw_tilt" type="float"><input name="in1" type="float" nodename="v" /><input name="in2" type="float" value="0.12" /></multiply>
    <add name="saw_x0" type="float"><input name="in1" type="float" nodename="u" /><input name="in2" type="float" nodename="saw_tilt" /></add>
    <multiply name="saw_wob" type="float"><input name="in1" type="float" nodename="warp2" /><input name="in2" type="float" value="2" /></multiply>
    <add name="saw_x" type="float"><input name="in1" type="float" nodename="saw_x0" /><input name="in2" type="float" nodename="saw_wob" /></add>
    <multiply name="saw_rad" type="float"><input name="in1" type="float" nodename="saw_x" /><input name="in2" type="float" value="349" /></multiply>
    <sin name="saw_sin" type="float"><input name="in" type="float" nodename="saw_rad" /></sin>
    <multiply name="saw" type="float"><input name="in1" type="float" nodename="saw_sin" /><input name="in2" type="float" nodename="grain_amp" /></multiply>

    <!-- Broad cement mottling, ~25 cm blotches (0..1). -->
    <multiply name="uv_mottle" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="4" /></multiply>
    <fractal2d name="mottle_raw" type="float"><input name="texcoord" type="vector2" nodename="uv_mottle" /><input name="octaves" type="integer" value="5" /><input name="diminish" type="float" value="0.55" /><input name="amplitude" type="float" value="0.5" /></fractal2d>
    <add name="mottle" type="float"><input name="in1" type="float" nodename="mottle_raw" /><input name="in2" type="float" value="0.5" /></add>

    <!-- Fine sand grain, ~3 mm. -->
    <multiply name="uv_grit" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="300" /></multiply>
    <fractal2d name="grit" type="float"><input name="texcoord" type="vector2" nodename="uv_grit" /><input name="octaves" type="integer" value="3" /></fractal2d>

    <!-- Bug holes: sparse worley pits on a 4 cm grid, radius from smooth noise. -->
    <multiply name="uv_pore" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="25" /></multiply>
    <worleynoise2d name="pore_dist" type="float"><input name="texcoord" type="vector2" nodename="uv_pore" /></worleynoise2d>
    <multiply name="uv_psize" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="31" /></multiply>
    <noise2d name="psize_raw" type="float"><input name="texcoord" type="vector2" nodename="uv_psize" /></noise2d>
    <multiply name="psize_s" type="float"><input name="in1" type="float" nodename="psize_raw" /><input name="in2" type="float" value="0.2" /></multiply>
    <subtract name="pore_r" type="float"><input name="in1" type="float" nodename="psize_s" /><input name="in2" type="float" value="0.06" /></subtract>
    <subtract name="pore_d" type="float"><input name="in1" type="float" nodename="pore_r" /><input name="in2" type="float" nodename="pore_dist" /></subtract>
    <smoothstep name="pore" type="float"><input name="in" type="float" nodename="pore_d" /><input name="low" type="float" value="0" /><input name="high" type="float" value="0.03" /></smoothstep>

    <!-- Form-tie holes: 25 mm conical recesses, 12 mm deep, on a 50 cm grid centred at (0.25, 0.225) + n*0.5. -->
    <add name="uv_tie_o" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="vector2" value="0.5, 0.525" /></add>
    <modulo name="uv_tie_m" type="vector2"><input name="in1" type="vector2" nodename="uv_tie_o" /><input name="in2" type="float" value="0.5" /></modulo>
    <subtract name="uv_tie_c" type="vector2"><input name="in1" type="vector2" nodename="uv_tie_m" /><input name="in2" type="float" value="0.25" /></subtract>
    <magnitude name="tie_d" type="float"><input name="in" type="vector2" nodename="uv_tie_c" /></magnitude>
    <divide name="tie_dn" type="float"><input name="in1" type="float" nodename="tie_d" /><input name="in2" type="float" value="0.0125" /></divide>
    <subtract name="tie_cone0" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="tie_dn" /></subtract>
    <clamp name="tie_cone" type="float"><input name="in" type="float" nodename="tie_cone0" /><input name="low" type="float" value="0" /><input name="high" type="float" value="1" /></clamp>
    <smoothstep name="tie_mask" type="float"><input name="in" type="float" nodename="tie_cone0" /><input name="low" type="float" value="-0.04" /><input name="high" type="float" value="0.06" /></smoothstep>

    <!-- Height in meters: plank offsets +-1.5 mm, 0.6 mm fins, 0.5 mm grain, 0.3 mm knot cores with 0.5 mm rims, 0.06 mm fibre and saw marks, 0.1 mm grit, 1 mm mottle, 2 mm pores, 12 mm tie cones. -->
    <multiply name="h_plank" type="float"><input name="in1" type="float" nodename="plank_h" /><input name="in2" type="float" value="0.003" /></multiply>
    <multiply name="h_fin" type="float"><input name="in1" type="float" nodename="fin" /><input name="in2" type="float" value="0.0006" /></multiply>
    <multiply name="h_grain" type="float"><input name="in1" type="float" nodename="grain" /><input name="in2" type="float" value="0.0005" /></multiply>
    <multiply name="h_fiber" type="float"><input name="in1" type="float" nodename="fiber" /><input name="in2" type="float" value="0.00006" /></multiply>
    <multiply name="h_saw" type="float"><input name="in1" type="float" nodename="saw" /><input name="in2" type="float" value="0.00006" /></multiply>
    <multiply name="h_grit" type="float"><input name="in1" type="float" nodename="grit" /><input name="in2" type="float" value="0.0001" /></multiply>
    <multiply name="h_mottle" type="float"><input name="in1" type="float" nodename="mottle" /><input name="in2" type="float" value="0.001" /></multiply>
    <multiply name="h_knot0" type="float"><input name="in1" type="float" nodename="knot_core" /><input name="in2" type="float" value="-0.0003" /></multiply>
    <multiply name="h_rim" type="float"><input name="in1" type="float" nodename="knot_rim" /><input name="in2" type="float" value="0.0005" /></multiply>
    <add name="h_knot" type="float"><input name="in1" type="float" nodename="h_knot0" /><input name="in2" type="float" nodename="h_rim" /></add>
    <multiply name="h_pore" type="float"><input name="in1" type="float" nodename="pore" /><input name="in2" type="float" value="-0.002" /></multiply>
    <multiply name="h_tie" type="float"><input name="in1" type="float" nodename="tie_cone" /><input name="in2" type="float" value="-0.012" /></multiply>
    <subtract name="not_tie" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="tie_mask" /></subtract>
    <add name="h_wood00" type="float"><input name="in1" type="float" nodename="h_grain" /><input name="in2" type="float" nodename="h_saw" /></add>
    <add name="h_wood0" type="float"><input name="in1" type="float" nodename="h_wood00" /><input name="in2" type="float" nodename="h_knot" /></add>
    <add name="h_wood1" type="float"><input name="in1" type="float" nodename="h_wood0" /><input name="in2" type="float" nodename="h_fiber" /></add>
    <multiply name="h_wood" type="float"><input name="in1" type="float" nodename="h_wood1" /><input name="in2" type="float" nodename="not_tie" /></multiply>
    <add name="h_a" type="float"><input name="in1" type="float" nodename="h_plank" /><input name="in2" type="float" nodename="h_fin" /></add>
    <add name="h_c" type="float"><input name="in1" type="float" nodename="h_a" /><input name="in2" type="float" nodename="h_wood" /></add>
    <add name="h_d" type="float"><input name="in1" type="float" nodename="h_c" /><input name="in2" type="float" nodename="h_grit" /></add>
    <add name="h_e" type="float"><input name="in1" type="float" nodename="h_d" /><input name="in2" type="float" nodename="h_mottle" /></add>
    <add name="h_f" type="float"><input name="in1" type="float" nodename="h_e" /><input name="in2" type="float" nodename="h_pore" /></add>
    <add name="height" type="float"><input name="in1" type="float" nodename="h_f" /><input name="in2" type="float" nodename="h_tie" /></add>
    <!-- scale 16 cancels heighttonormal's 1/16 Sobel factor; mm inputs avoid three.js's degenerate-normal cutoff. -->
    <multiply name="uv_mm" type="vector2"><input name="in1" type="vector2" nodename="uv" /><input name="in2" type="float" value="1000" /></multiply>
    <multiply name="height_mm" type="float"><input name="in1" type="float" nodename="height" /><input name="in2" type="float" value="1000" /></multiply>
    <heighttonormal name="n_tangent" type="vector3"><input name="in" type="float" nodename="height_mm" /><input name="scale" type="float" value="16" /><input name="texcoord" type="vector2" nodename="uv_mm" /></heighttonormal>
    <normalmap name="n_world" type="vector3"><input name="in" type="vector3" nodename="n_tangent" /></normalmap>

    <!-- Color: grey, slightly warm, mottled; each plank a touch lighter or darker; grain and fibre faintly tinted. -->
    <mix name="col_mottle" type="color3"><input name="bg" type="color3" value="0.33, 0.32, 0.305" /><input name="fg" type="color3" value="0.44, 0.43, 0.41" /><input name="mix" type="float" nodename="mottle" /></mix>
    <multiply name="plank_tint" type="float"><input name="in1" type="float" nodename="plank_c" /><input name="in2" type="float" value="0.4" /></multiply>
    <multiply name="grain_tint" type="float"><input name="in1" type="float" nodename="grain" /><input name="in2" type="float" value="-0.1" /></multiply>
    <multiply name="fiber_tint" type="float"><input name="in1" type="float" nodename="fiber" /><input name="in2" type="float" value="0.05" /></multiply>
    <multiply name="grit_tint" type="float"><input name="in1" type="float" nodename="grit" /><input name="in2" type="float" value="0.08" /></multiply>
    <multiply name="fin_tint" type="float"><input name="in1" type="float" nodename="fin" /><input name="in2" type="float" value="-0.12" /></multiply>
    <multiply name="knot_tint" type="float"><input name="in1" type="float" nodename="knot_core" /><input name="in2" type="float" value="-0.18" /></multiply>
    <add name="t_a" type="float"><input name="in1" type="float" nodename="plank_tint" /><input name="in2" type="float" nodename="grain_tint" /></add>
    <add name="t_b" type="float"><input name="in1" type="float" nodename="t_a" /><input name="in2" type="float" nodename="fiber_tint" /></add>
    <add name="t_c" type="float"><input name="in1" type="float" nodename="t_b" /><input name="in2" type="float" nodename="grit_tint" /></add>
    <add name="t_d" type="float"><input name="in1" type="float" nodename="t_c" /><input name="in2" type="float" nodename="fin_tint" /></add>
    <!-- Darker band within ~1 cm of seams (release agent and paste bleed collect at board edges). -->
    <smoothstep name="edge_band_s" type="float"><input name="in" type="float" nodename="edge_d" /><input name="low" type="float" value="0" /><input name="high" type="float" value="0.012" /></smoothstep>
    <subtract name="edge_band" type="float"><input name="in1" type="float" value="1" /><input name="in2" type="float" nodename="edge_band_s" /></subtract>
    <multiply name="edge_tint" type="float"><input name="in1" type="float" nodename="edge_band" /><input name="in2" type="float" value="-0.07" /></multiply>
    <add name="t_d2" type="float"><input name="in1" type="float" nodename="t_d" /><input name="in2" type="float" nodename="edge_tint" /></add>
    <add name="t_e" type="float"><input name="in1" type="float" nodename="t_d2" /><input name="in2" type="float" nodename="knot_tint" /></add>
    <add name="tint" type="float"><input name="in1" type="float" nodename="t_e" /><input name="in2" type="float" value="1" /></add>
    <multiply name="col_tint" type="color3"><input name="in1" type="color3" nodename="col_mottle" /><input name="in2" type="float" nodename="tint" /></multiply>
    <mix name="col_pore" type="color3"><input name="bg" type="color3" nodename="col_tint" /><input name="fg" type="color3" value="0.16, 0.155, 0.15" /><input name="mix" type="float" nodename="pore" /></mix>
    <!-- Tie holes darken with depth (occlusion). -->
    <mix name="col_tie_in" type="color3"><input name="bg" type="color3" value="0.2, 0.195, 0.19" /><input name="fg" type="color3" value="0.06, 0.058, 0.055" /><input name="mix" type="float" nodename="tie_cone" /></mix>
    <smoothstep name="tie_void" type="float"><input name="in" type="float" nodename="tie_cone0" /><input name="low" type="float" value="0.62" /><input name="high" type="float" value="0.7" /></smoothstep>
    <mix name="col_tie" type="color3"><input name="bg" type="color3" nodename="col_tie_in" /><input name="fg" type="color3" value="0.025, 0.024, 0.023" /><input name="mix" type="float" nodename="tie_void" /></mix>
    <mix name="base_color" type="color3"><input name="bg" type="color3" nodename="col_pore" /><input name="fg" type="color3" nodename="col_tie" /><input name="mix" type="float" nodename="tie_mask" /></mix>

    <!-- Dielectric throughout. -->
    <constant name="metalness" type="float"><input name="value" type="float" value="0" /></constant>

    <!-- Roughness 0.8..0.9; smoother on grain ridges (paste against latewood), rougher in pores and tie holes. -->
    <mix name="rough_mottle" type="float"><input name="bg" type="float" value="0.9" /><input name="fg" type="float" value="0.8" /><input name="mix" type="float" nodename="mottle" /></mix>
    <multiply name="rough_grain" type="float"><input name="in1" type="float" nodename="grain" /><input name="in2" type="float" value="-0.04" /></multiply>
    <add name="rough_g" type="float"><input name="in1" type="float" nodename="rough_mottle" /><input name="in2" type="float" nodename="rough_grain" /></add>
    <max name="rough_holes" type="float"><input name="in1" type="float" nodename="pore" /><input name="in2" type="float" nodename="tie_mask" /></max>
    <mix name="roughness" type="float"><input name="bg" type="float" nodename="rough_g" /><input name="fg" type="float" value="0.97" /><input name="mix" type="float" nodename="rough_holes" /></mix>

    <output name="base_color_out" type="color3" nodename="base_color" />
    <output name="roughness_out" type="float" nodename="roughness" />
    <output name="normal_out" type="vector3" nodename="n_world" />
    <output name="metalness_out" type="float" nodename="metalness" />
  </nodegraph>
  <standard_surface name="SR_board_formed" type="surfaceshader">
    <input name="base" type="float" value="1" />
    <input name="base_color" type="color3" nodegraph="NG_board_formed" output="base_color_out" />
    <input name="specular" type="float" value="0.5" />
    <input name="specular_IOR" type="float" value="1.5" />
    <input name="specular_roughness" type="float" nodegraph="NG_board_formed" output="roughness_out" />
    <input name="metalness" type="float" nodegraph="NG_board_formed" output="metalness_out" />
    <input name="normal" type="vector3" nodegraph="NG_board_formed" output="normal_out" />
  </standard_surface>
  <surfacematerial name="M_board_formed" type="material"><input name="surfaceshader" type="surfaceshader" nodename="SR_board_formed" /></surfacematerial>
</materialx>
